<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- The referenced SubmissionReviewer project also ships an appsettings.json. Both files have
		     the same shape, and every TermsWatcher setting has the same default in TermsWatchOptions,
		     so whichever copy is published the job behaves the same. -->
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
		<CodeAnalysisRuleSet>../StyleCop.Analyzers.ruleset</CodeAnalysisRuleSet>
	</PropertyGroup>

	<ItemGroup>
		<AdditionalFiles Include="..\stylecop.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0" />
		<PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DirectoryManager.Data\DirectoryManager.Data.csproj" />
		<ProjectReference Include="..\DirectoryManager.SubmissionReviewer\DirectoryManager.SubmissionReviewer.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="DirectoryManager.TermsWatcher.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json" TargetPath="appsettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

</Project>
