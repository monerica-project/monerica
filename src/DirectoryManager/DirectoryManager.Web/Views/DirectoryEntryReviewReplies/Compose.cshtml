@model CreateDirectoryEntryReviewReplyInputModel
@using DirectoryManager.Web.Constants
@using DirectoryManager.Data.Models.Reviews
@{
    ViewData[StringConstants.TitleHeader] = "Reply – Compose";
    Layout = "_CenteredLayout";
}

@section PageContent {
    <h1>@ViewData[StringConstants.TitleHeader]</h1>
    <hr />

    <p><b>Listing:</b> @ViewBag.DirectoryEntryName</p>
    <p><b>Verified PGP fingerprint:</b> @ViewBag.PgpFingerprint</p>

    @if (ViewBag.ReviewBody != null)
    {
        <div class="card mb-3">
            <div class="card-header"><b>You're replying to this review:</b></div>
            <div class="card-body">
                @if (ViewBag.ReviewRating != null)
                {
                    <p class="mb-1"><b>Rating:</b> @ViewBag.ReviewRating / 5</p>
                }
                @if (!string.IsNullOrWhiteSpace((string?)ViewBag.ReviewTitle))
                {
                    <p class="mb-1"><b>@ViewBag.ReviewTitle</b></p>
                }
                @if (!string.IsNullOrWhiteSpace((string?)ViewBag.ReviewAuthor))
                {
                    <p class="mb-1 text-muted"><small>by @ViewBag.ReviewAuthor</small></p>
                }
                <blockquote class="mb-0 u-prewrap">@ViewBag.ReviewBody</blockquote>
            </div>
        </div>
    }

    @{
        var thread = ViewBag.Thread as List<DirectoryEntryReviewComment>;
    }
    @if (thread != null && thread.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header"><b>Replies so far in this thread (@thread.Count):</b></div>
            <div class="card-body">
                @for (var i = 0; i < thread.Count; i++)
                {
                    var c = thread[i];
                    <div class="@(i < thread.Count - 1 ? "mb-2 pb-2 thread-reply-divider" : "")">
                        <div class="text-muted mb-1"><small>@(string.IsNullOrWhiteSpace(c.DisplayName) ? "Anonymous" : c.DisplayName)</small></div>
                        <div class="u-prewrap">@c.Body</div>
                    </div>
                }
            </div>
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form asp-action="ComposePost" asp-controller="DirectoryEntryReviewReplies" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="flowId" value="@ViewBag.FlowId" />
        <input type="hidden" asp-for="DirectoryEntryReviewId" />
        <input type="hidden" asp-for="ParentCommentId" />

        <div class="mb-3">
            <label asp-for="Body" class="form-label">Your Reply</label>
            <br />
            <textarea asp-for="Body" class="form-control" rows="20" cols="40"></textarea>
            <span asp-validation-for="Body" class="text-danger"></span>
            <div class="form-text">Emojis aren't allowed and will be removed automatically.</div>
        </div>

        <p class="text-muted"><i>Your reply may be checked before it appears publicly. Most replies go live quickly.</i></p>

        <button type="submit" class="btn btn-success btn-cta">Submit Reply</button>
    </form>
}
