@model CreateDirectoryEntryReviewReplyInputModel
@using DirectoryManager.Web.Constants
@using DirectoryManager.Data.Models.Reviews
@{
    PageMeta.Title = "Reply – Compose";
    Layout = "_CenteredLayout";
}

@section PageContent {
    <h1>@PageMeta.Title</h1>
    <hr />

    <p><b>Listing:</b> @ViewBag.DirectoryEntryName</p>
    <p><b>Verified PGP fingerprint:</b> @ViewBag.PgpFingerprint</p>

    @if (ViewBag.ReviewBody != null)
    {
        <div class="card mb-3">
            <div class="card-header"><b>You're replying to this review:</b></div>
            <div class="card-body">
                @if (ViewBag.ReviewRating != null)
                {
                    <p class="mb-1"><b>Rating:</b> @ViewBag.ReviewRating / 5</p>
                }
                @if (!string.IsNullOrWhiteSpace((string?)ViewBag.ReviewTitle))
                {
                    <p class="mb-1"><b>@ViewBag.ReviewTitle</b></p>
                }
                @if (!string.IsNullOrWhiteSpace((string?)ViewBag.ReviewAuthor))
                {
                    <p class="mb-1 text-muted"><small>by @ViewBag.ReviewAuthor</small></p>
                }
                <blockquote class="mb-0 u-prewrap">@ViewBag.ReviewBody</blockquote>
            </div>
        </div>
    }

    @{
        var thread = ViewBag.Thread as List<DirectoryEntryReviewComment>;
    }
    @if (thread != null && thread.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header"><b>Replies so far in this thread (@thread.Count):</b></div>
            <div class="card-body">
                @for (var i = 0; i < thread.Count; i++)
                {
                    var c = thread[i];
                    <div class="@(i < thread.Count - 1 ? "mb-2 pb-2 thread-reply-divider" : "")">
                        <div class="text-muted mb-1"><small>@(string.IsNullOrWhiteSpace(c.DisplayName) ? "Anonymous" : c.DisplayName)</small></div>
                        <div class="u-prewrap">@c.Body</div>
                    </div>
                }
            </div>
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form asp-action="ComposePost" asp-controller="DirectoryEntryReviewReplies" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="flowId" value="@ViewBag.FlowId" />
        <input type="hidden" asp-for="DirectoryEntryReviewId" />
        <input type="hidden" asp-for="ParentCommentId" />

        <div class="mb-3">
            <label asp-for="Body" class="form-label">Your Reply</label>
            <br />
            <textarea asp-for="Body" class="form-control" rows="20" cols="40"></textarea>
            <span asp-validation-for="Body" class="text-danger"></span>
            <div class="form-text">Emojis aren't allowed and will be removed automatically.</div>
        </div>

        @if (ViewBag.CanEditOwnReview == true)
        {
            // Only the review's own author sees this (checked again on the server when posting).
            var ownTags = ViewBag.AvailableReviewTags as List<DirectoryManager.Data.Models.Reviews.ReviewTag> ?? new();
            var picked = Model?.SelectedReviewTagIds ?? new List<int>();
            var bands = ownTags.Where(t => t.IsMoneyBand).OrderBy(t => t.MinUsd ?? 0m).ToList();
            var flags = ownTags.Where(t => !t.IsMoneyBand).OrderByDescending(t => (int)t.Level).ThenBy(t => t.Name).ToList();

            <input type="hidden" name="EditOwnReview" value="true" />
            <div class="card mb-3">
                <div class="card-header"><b>Update your review (optional)</b></div>
                <div class="card-body">
                    <p class="form-text mt-0">
                        This is your review, so you can change its rating and tags here. What you wrote in
                        the review stays as it is.
                    </p>

                    <div class="u-mb-16px">
                        <label asp-for="NewRating" class="form-label"><strong>Your rating</strong></label>
                        <select asp-for="NewRating" class="form-control select-fit">
                            @for (byte r = 5; r >= 1; r--)
                            {
                                <option value="@r" selected="@(Model?.NewRating == r)">@r / 5</option>
                            }
                        </select>
                        <div class="form-text">A new rating shows on your review as soon as you submit.</div>
                    </div>

                    @if (bands.Any())
                    {
                        <div class="u-mb-16px">
                            <label class="form-label" for="own_amount"><strong>Order amount</strong></label>
                            <select class="form-select" name="SelectedMoneyBandTagId" id="own_amount">
                                <option value="">— None —</option>
                                @foreach (var b in bands)
                                {
                                    <option value="@b.ReviewTagId" selected="@(Model?.SelectedMoneyBandTagId == b.ReviewTagId)">@b.Name</option>
                                }
                            </select>
                        </div>
                    }

                    @if (flags.Any())
                    {
                        <div class="u-mb-8px"><strong>Tags</strong></div>
                        @foreach (var t in flags)
                        {
                            <div class="form-check u-mt-6px">
                                <input class="form-check-input" type="checkbox" name="SelectedReviewTagIds"
                                       value="@t.ReviewTagId" id="owntag_@t.ReviewTagId" @(picked.Contains(t.ReviewTagId) ? "checked" : "") />
                                <label class="form-check-label" for="owntag_@t.ReviewTagId">
                                    <strong>@t.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(t.Description))
                                    {
                                        <span class="text-muted"> — @t.Description</span>
                                    }
                                </label>
                            </div>
                        }
                        <div class="form-text u-mt-6px">Tag changes appear after a moderator checks them, together with this reply.</div>
                    }
                </div>
            </div>
        }
        <p class="text-muted"><i>Your reply may be checked before it appears publicly. Most replies go live quickly.</i></p>

        <button type="submit" class="btn btn-success btn-cta">Submit Reply</button>
    </form>
}
