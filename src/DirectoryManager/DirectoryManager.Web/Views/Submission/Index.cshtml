@model DirectoryManager.Web.Models.SubmissionPagedList
@using DirectoryManager.Web.Constants;
@{
    ViewData[StringConstants.TitleHeader] = "Submission Requests";
    Layout = "_CenteredLayout";
}

@section PageContent {

<h1>@ViewData[StringConstants.TitleHeader]</h1>
<div class="u-m-12px-0-18px-0">
    <a asp-action="Index" asp-controller="Submission"><b>All</b></a>
    <span class="u-p-0-8px">|</span>
    <a asp-action="Pending" asp-controller="Submission">Pending</a>
</div>

@await Html.PartialAsync("_AdminMenu")

<div class="table-wrapper">
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Status</th>
            <th>Create Date</th>
            <th>Update Date</th>
            <th>Paid</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var submission in Model.Items)
        {
            <tr>
                <td><a asp-action="Review" asp-controller="Submission" asp-route-id="@submission?.SubmissionId" title="@submission?.Name"><b>@(submission?.Name != null && submission.Name.Length > 35 ? submission.Name.Substring(0, 35) + "…" : submission?.Name)</b></a></td>
                <td>
                    @if (submission.SubmissionStatus != DirectoryManager.Data.Enums.SubmissionStatus.Pending)
                    {
                        <i>@submission.SubmissionStatus</i>
                    }
                    else
                    {
                        <b>@submission.SubmissionStatus</b>
                    }
                    </td>
                <td>@submission.CreateDate</td>
                <td>
                    @if (submission?.UpdateDate == null)
                    {
                                <text> -- </text>
                    }
                    else
                    {
                        @submission.UpdateDate
                    }
                </td>
                <td>
                    @if (submission?.PaidUtc != null)
                    {
                        <span class="badge bg-success u-display-ib" title="@(submission.PaidAmount is decimal amt && amt > 0 ? $"{amt.ToString(string.Equals(submission.PaidCurrency, "XMR", StringComparison.OrdinalIgnoreCase) ? "0.############" : "0.##")} {submission.PaidCurrency}" : "Donation received")">&#128176; Paid</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary u-display-ib">Not paid</span>
                    }
                </td>
                <td>
                    <a asp-action="Review" asp-controller="Submission" asp-route-id="@submission?.SubmissionId">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<div>
    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        if (i == Model.PageNumber)
        {
            <text>@i </text>
        }
        else
        {
            <a href="@Url.Action("Index", "Submission", new { page = i })">@i </a>
        }
    }
</div>
}