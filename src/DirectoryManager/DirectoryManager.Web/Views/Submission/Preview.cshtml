@model DirectoryManager.Web.Models.SubmissionPreviewModel
@using DirectoryManager.Web.Constants;
@{
    PageMeta.Title = "Preview (not submitted yet)";
}

@{
    Layout = "_CenteredLayout";
}
@section PageContent {

    <div class="page-header-bar">
        <h1 class="page-title">@PageMeta.Title </h1>
        @await Html.PartialAsync("_SiteLogo")
    </div>
<hr />
<div class="alert-warning" role="alert">
    <p class="u-m-0"><b>Your listing has NOT been sent yet.</b> This is only a preview (step 2 of 2).</p>
    <p class="u-m-0">Check the details below, then complete the spam check and press <b>Submit listing</b> at the bottom of this page.</p>
    <p class="u-m-0"><a href="#submit-listing"><b>Go to the Submit button &darr;</b></a></p>
</div>
 
@if (Model.DirectoryEntryViewModel.DirectoryStatus == DirectoryManager.Data.Enums.DirectoryStatus.Removed)
{
    <p><i>You want the listing below to be removed from the directory.</i></p>
}

@if (!string.IsNullOrWhiteSpace(Model.SubcategoryName))
{
    <p><b>Categorization:</b> @Model.SubcategoryName</p>
}

@if (Model.DirectoryEntryViewModel.KycPolicy.HasValue)
{
    <p><b>KYC Policy:</b> @DirectoryManager.Utilities.Helpers.EnumHelper.GetDescription(Model.DirectoryEntryViewModel.KycPolicy.Value)</p>
}

@if (DirectoryManager.Data.Enums.SiteJavaScriptExtensions.IsShown(Model.DirectoryEntryViewModel.SiteJavaScript))
{
    <p><b>JavaScript:</b> @DirectoryManager.Utilities.Helpers.EnumHelper.GetDescription(Model.DirectoryEntryViewModel.SiteJavaScript)</p>
}
@if (DirectoryManager.Data.Enums.RateTypeExtensions.IsShown(Model.DirectoryEntryViewModel.RateType))
{
    <p><b>Rate type:</b> @DirectoryManager.Utilities.Helpers.EnumHelper.GetDescription(Model.DirectoryEntryViewModel.RateType)</p>
}
@if (DirectoryManager.Data.Enums.LiquidityExtensions.IsPubliclyShown(Model.DirectoryEntryViewModel.Liquidity))
{
    <p><b>Liquidity:</b> @DirectoryManager.Utilities.Helpers.EnumHelper.GetDescription(Model.DirectoryEntryViewModel.Liquidity)</p>
}

@if (Model.DirectoryEntryViewModel.Guarantees != null && Model.DirectoryEntryViewModel.Guarantees.Any())
{
    <p>
        <b>@(Model.DirectoryEntryViewModel.Guarantees.Count > 1 ? "Deposit Guarantees:" : "Deposit Guarantee:")</b>
    </p>
    <ul class="blank_list_item">
        @foreach (var g in Model.DirectoryEntryViewModel.Guarantees)
        {
            <li>@DirectoryManager.Data.Helpers.DepositGuaranteeHelper.FormatAmount(g.Amount.GetValueOrDefault(), g.Currency) &mdash; <a target="_blank" href="@g.Link" rel="ugc nofollow noopener">view proof</a></li>
        }
    </ul>
}

<ul class="blank_list_item">
    @await Html.PartialAsync("_DirectoryEntryPartial", Model.DirectoryEntryViewModel)
</ul>

@if (Model.DirectoryEntryViewModel.Tags != null && Model.DirectoryEntryViewModel.Tags.Any())
{
    <h4>Tags</h4>

    <p>
        @{
            var csvSafe = string.Join(
            ", ",
                Model.DirectoryEntryViewModel.Tags.Select(t => System.Net.WebUtility.HtmlEncode(t))
            );
        }

        @csvSafe
     </p>
 
}

    @{
        var relatedLinks = Model.RelatedLinks ?? new List<string>();
    }

    @if (relatedLinks.Any())
    {
        <h4>Related Links</h4>
        <ul>
            @foreach (var u in relatedLinks)
            {
                <li><a href="@u" target="_blank" rel="nofollow noopener">@u</a></li>
            }
        </ul>
    }


<hr />

@if (!string.IsNullOrWhiteSpace(Model.NoteToAdmin))
{
    <h4>Note To Admin (private)</h4>

    <p>@Model.NoteToAdmin</p>

    <hr />
}

<br />

<form class="u-m-0" asp-action="Confirm" method="post" id="submit-listing">
    @Html.HiddenFor(x => x.SubmissionId)

    <div asp-validation-summary="All" class="text-danger"></div>

    <h3>Spam check</h3>
    <div class="form-group">
        @await Html.PartialAsync("_CaptchaBlock", (string)"submission")
    </div>

    <p><b>Last step:</b> your listing is only sent for review when you press this button.</p>
    <button type="submit" class="btn btn-primary btn-cta">Submit listing</button>
</form>
<br />
<a href="~/submit?submissionid=@Model.SubmissionId">Edit submission</a>

}