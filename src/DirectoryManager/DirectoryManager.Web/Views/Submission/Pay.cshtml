@model DirectoryManager.Web.Models.Submissions.SubmissionPayViewModel
@using DirectoryManager.Web.Constants
@{
    PageMeta.MetaContent = StringConstants.MetaTagNoIndex;
    PageMeta.Title = "Submission Received";
    Layout = "_CenteredLayout";
}

@section PageContent {
    <div class="page-header-bar">
        <h1 class="page-title">@PageMeta.Title</h1>
        @await Html.PartialAsync("_SiteLogo")
    </div>
    <hr />

    @* The listing name gets its own big line so submitters see at a glance which listing was received. *@
    <div class="alert alert-success">
        &#10003; We've received your submission for:
        <div class="u-heading-sm u-mt-4px"><strong>@Model.Name</strong></div>
    </div>

    @if (this.TempData["PayError"] is string payError)
    {
        <div class="alert alert-danger">@payError</div>
    }

    @if (Model.AlreadyPaid)
    {
        <p><b>Thank you — your payment has been received.</b> There's nothing more you need to do.</p>
        @await Html.PartialAsync("_BackToHome")
        return;
    }

    <p>
        <b>Paying is not required.</b> Because of the volume of submissions, paying for our review
        time moves your listing up in the review queue. You choose the amount, paid in Monero.
    </p>

    <form method="post" action="~/submission/pay/@Model.Token" class="u-m-0">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary btn-cta">Pay to prioritize my review →</button>
    </form>

    <p class="u-note-sm u-mt-10px">
        Your submission stays in the queue either way. Payment does not guarantee approval.
    </p>

    @await Html.PartialAsync("_BackToHome")
}
