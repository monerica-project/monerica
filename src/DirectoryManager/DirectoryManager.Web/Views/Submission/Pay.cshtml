@model DirectoryManager.Web.Models.Submissions.SubmissionPayViewModel
@using DirectoryManager.Web.Constants
@{
    ViewData[StringConstants.MetaContent] = StringConstants.MetaTagNoIndex;
    ViewData[StringConstants.TitleHeader] = "Help Cover Our Review Costs (Optional)";
    Layout = "_CenteredLayout";
}

@section PageContent {
    <div class="page-header-bar">
        <h1 class="page-title">@ViewData[StringConstants.TitleHeader]</h1>
        @await Html.PartialAsync("_SiteLogo")
    </div>
    <hr />

    @if (this.TempData["PayError"] is string payError)
    {
        <div class="alert alert-danger">@payError</div>
    }

    @if (Model.AlreadyPaid)
    {
        <p><b>Thank you — a donation for this submission has already been received.</b></p>
        <p>Your submission is in the review queue. There's nothing more you need to do.</p>
        @await Html.PartialAsync("_BackToHome")
        return;
    }

    <p>
        <b>Submitting is free — you don't need to pay anything to be reviewed.</b>
        Your submission for <b>@Model.Name</b> has already been received either way.
    </p>

    <div class="u-callout">
        <p>
            But due to the volume of submissions, an optional donation helps us
            <b>review and test your listing without a cost to us</b> — including any fees we'd incur
            while testing it. It is <b>not required</b>, but it does help us <b>speed up the review process</b>
            for your submission.
        </p>
        <p>Proceeding creates a <b>unique payment address tied to this submission</b>, and you choose the amount.</p>
        <p><b>Payment does not guarantee approval.</b> It only helps cover our review costs and prioritize the queue &mdash; the outcome depends entirely on our review.</p>
    </div>

    <form method="post" action="~/submission/pay/@Model.Token" class="u-m-0">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary btn-cta">Proceed to pay →</button>
    </form>

    <p class="u-note-sm u-mt-10px">
        You'll be taken to a secure Monero checkout. Paying is entirely optional — your submission stays in the queue regardless.
    </p>

    @await Html.PartialAsync("_BackToHome")
}
