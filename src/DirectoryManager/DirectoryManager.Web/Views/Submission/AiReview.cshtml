@model DirectoryManager.Web.Models.Submissions.SubmissionAiReviewPageModel
@using DirectoryManager.Data.Enums
@using DirectoryManager.Data.Models
@{
    PageMeta.Title = "Submission review";
    Layout = "_CenteredLayout";

    var order = new[]
    {
        (SubmissionReviewState.AiApproveCandidate, "Ready to approve", "The reviewer found clear evidence. Check the suggested version, then approve."),
        (SubmissionReviewState.Flagged, "Needs a closer look", "Banned category, unsure verdict, or a review error."),
        (SubmissionReviewState.AiRejectCandidate, "Reviewer suggests rejecting", "Check the issues before rejecting."),
        (SubmissionReviewState.AutoRejected, "Auto-rejected (confirm)", "Dead URL, duplicate or spam, found by code checks. Nothing is rejected until you confirm."),
        (SubmissionReviewState.Pending, "Not reviewed yet", "Waiting for the reviewer (runs every 10 minutes, within the daily cap)."),
        (SubmissionReviewState.Skipped, "Not handled by the reviewer", "Automated proposals that are not from the weekly site check: review them as before."),
    };

    string[] ListFromJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) { return Array.Empty<string>(); }
        try { return System.Text.Json.JsonSerializer.Deserialize<string[]>(json) ?? Array.Empty<string>(); }
        catch { return Array.Empty<string>(); }
    }

    List<(string Field, string Reason)> ChangesFromJson(string? json)
    {
        var list = new List<(string, string)>();
        if (string.IsNullOrWhiteSpace(json)) { return list; }
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            foreach (var e in doc.RootElement.EnumerateArray())
            {
                list.Add((e.GetProperty("field").GetString() ?? "", e.GetProperty("reason").GetString() ?? ""));
            }
        }
        catch { }
        return list;
    }

    // The ORIGINAL submitted values (from the snapshot when the form has been edited since).
    Dictionary<string, string?> Original(Submission s)
    {
        var d = new Dictionary<string, string?>
        {
            ["Name"] = s.Name, ["Description"] = s.Description, ["Note"] = s.Note,
            ["Subcategory"] = Model.Label(s.SubCategoryId), ["Country"] = s.CountryCode, ["Address"] = DirectoryManager.Data.Helpers.PostalAddress.Format(s.StreetAddress, s.City, s.StateRegion, s.PostalCode),
            ["KYC policy"] = s.KycPolicy?.ToString(), ["Liquidity"] = s.Liquidity == Liquidity.Unknown ? null : s.Liquidity.ToString(),
            ["Rate type"] = s.RateType == RateType.Unknown ? null : s.RateType.ToString(),
            ["JavaScript"] = s.SiteJavaScript == SiteJavaScript.Unknown ? null : s.SiteJavaScript.ToString(), ["Tags"] = s.Tags,
            ["Social"] = s.Social, ["Messenger"] = s.Messenger,
            ["PGP key"] = PgpLabel(s.PgpKey),
            ["Restrictions"] = DirectoryManager.Data.Helpers.ListingRestrictions.FullText(s.RestrictedCountries, s.VpnPolicy, s.TorPolicy, s.OtherRestrictions),
        };
        if (!string.IsNullOrWhiteSpace(s.OriginalSnapshotJson))
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(s.OriginalSnapshotJson);
                var r = doc.RootElement;
                string? Str(string n) => r.TryGetProperty(n, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.String ? v.GetString() : null;
                d["Name"] = Str("Name"); d["Description"] = Str("Description"); d["Note"] = Str("Note");
                d["Country"] = Str("CountryCode"); d["Address"] = r.TryGetProperty("StateRegion", out _) || r.TryGetProperty("City", out _) ? DirectoryManager.Data.Helpers.PostalAddress.Format(Str("StreetAddress"), Str("City"), Str("StateRegion"), Str("PostalCode")) : Str("Location"); d["KYC policy"] = Str("KycPolicy");
                d["Liquidity"] = Str("Liquidity") is "Unknown" ? null : Str("Liquidity");
                d["Rate type"] = Str("RateType") is "Unknown" ? null : Str("RateType");
                d["JavaScript"] = Str("SiteJavaScript") is "Unknown" ? null : Str("SiteJavaScript"); d["Tags"] = Str("Tags"); d["Social"] = Str("Social"); d["Messenger"] = Str("Messenger");
                d["Subcategory"] = r.TryGetProperty("SubCategoryId", out var sc) && sc.ValueKind == System.Text.Json.JsonValueKind.Number ? Model.Label(sc.GetInt32()) : "(none)";
            }
            catch { }
        }
        return d;
    }

    Dictionary<string, string?> Proposed(Submission s) => new()
    {
        ["Name"] = s.ProposedName, ["Description"] = s.ProposedDescription, ["Note"] = s.ProposedNote,
        ["Subcategory"] = Model.Label(s.ProposedSubCategoryId), ["Country"] = s.ProposedCountryCode, ["Address"] = DirectoryManager.Data.Helpers.PostalAddress.Format(s.ProposedStreetAddress ?? s.StreetAddress, s.ProposedCity ?? s.City, s.ProposedStateRegion ?? s.StateRegion, s.ProposedPostalCode ?? s.PostalCode),
        ["KYC policy"] = s.ProposedKycPolicy?.ToString(), ["Liquidity"] = s.ProposedLiquidity?.ToString(),
        ["Rate type"] = s.ProposedRateType?.ToString(),
        ["JavaScript"] = s.ProposedSiteJavaScript?.ToString(), ["Tags"] = s.ProposedTags,
        ["Social"] = s.ProposedSocial ?? s.Social, ["Messenger"] = s.ProposedMessenger ?? s.Messenger,
        // A key found on the site only fills an empty key (see SubmissionController.WithProposal).
        ["PGP key"] = string.IsNullOrWhiteSpace(s.PgpKey) && DirectoryManager.Web.Controllers.SubmissionController.SuggestedPgpFingerprint(s) is string fp
            ? $"{Spaced(fp)} (found on the site: {s.ProposedPgpKeySource})"
            : PgpLabel(s.PgpKey),
        // Not suggested by the reviewer: approving keeps the submitted restrictions.
        ["Restrictions"] = DirectoryManager.Data.Helpers.ListingRestrictions.FullText(s.RestrictedCountries, s.VpnPolicy, s.TorPolicy, s.OtherRestrictions),
    };

    // A PGP key shown as its primary fingerprint (the full armored block is too long for the table).
    static string? PgpLabel(string? armored)
    {
        if (string.IsNullOrWhiteSpace(armored)) { return null; }
        var fp = DirectoryManager.Web.Helpers.PgpCapabilities.GetPrimaryFingerprint(armored);
        return fp == null ? "(key given, but it could not be read)" : Spaced(fp);
    }

    static string Spaced(string fp) => string.Join(" ", Enumerable.Range(0, (fp.Length + 3) / 4).Select(i => fp.Substring(i * 4, Math.Min(4, fp.Length - i * 4))));

    // The weekly site check's findings get their own plain sections (below), not the AI groups.
    var mainDown = Model.Submissions.Where(x => Model.SiteChecks.TryGetValue(x.SubmissionId, out var c) && c.Finding == DirectoryManager.Web.Helpers.SiteCheckFinding.MainSiteOffline).ToList();
    var torDown = Model.Submissions.Where(x => Model.SiteChecks.TryGetValue(x.SubmissionId, out var c) && c.Finding == DirectoryManager.Web.Helpers.SiteCheckFinding.TorLinkOffline).ToList();
    var checkWarnings = Model.Submissions.Where(x => Model.SiteChecks.TryGetValue(x.SubmissionId, out var c) && c.Finding == DirectoryManager.Web.Helpers.SiteCheckFinding.Warning).ToList();

    string Streak(int n) => n <= 1 ? "this week's check" : $"{n} weekly checks in a row";
    string Checked(DateTime? d) => d is DateTime v ? v.ToString("MMM d") : "date not recorded";

    var readyCount = Model.Submissions.Count(s => s.ReviewState == SubmissionReviewState.AiApproveCandidate);
    var autoRejectedCount = Model.Submissions.Count(s => s.ReviewState == SubmissionReviewState.AutoRejected);
    var waitingCount = Model.Submissions.Count(s => s.ReviewState == SubmissionReviewState.Pending);
}

@section PageContent {

<h1>@PageMeta.Title</h1>
@await Html.PartialAsync("_AdminMenu")

<p class="u-fs-085em">
    Pending submissions, sorted by what the automated reviewer found. Approving publishes the <b>suggested</b> version;
    the submitted version is always kept on the submission. AI reviews today: <b>@Model.AiReviewsToday / @Model.DailyCap</b>.
</p>

<div class="u-flex-gap-8px-flexwrap-wrap u-mb-16px">
    <a class="btn btn-sm" href="~/admin/submission-from-link">Submit a link</a>
    <a class="btn btn-sm" href="~/submission/index">All submissions (full list)</a>
    <a class="btn btn-sm" href="~/submission/pending">Pending only</a>
    @if (mainDown.Count > 0) { <a class="btn btn-sm" href="#offline">AI-ready: offline (@mainDown.Count)</a> }
    @if (torDown.Count > 0) { <a class="btn btn-sm" href="#tor-offline">AI-ready: Tor link down (@torDown.Count)</a> }
    @if (checkWarnings.Count > 0) { <a class="btn btn-sm" href="#check-warnings">Site check warnings (@checkWarnings.Count)</a> }
</div>

@if (Model.AiReviewsToday >= Model.DailyCap && waitingCount > 0)
{
    <div class="alert-warning" role="alert"><b>Daily AI review cap reached.</b> @waitingCount submission(s) stay waiting until tomorrow (UTC). Review them by hand or raise SubmissionReviewer:DailyCap.</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="@(Model.MessageIsProblem ? "alert-warning" : "u-callout-orange")" role="alert" id="result">
        @if (Model.MessageIsProblem) { <b>Not approved. </b> }@Model.Message
    </div>
}

<div class="u-flex-gap-8px-flexwrap-wrap">
    @if (readyCount > 0)
    {
        <form method="post" action="~/admin/submission-review/approve-all" class="u-m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary">Approve all @readyCount ready</button>
        </form>
    }
    @if (autoRejectedCount > 0)
    {
        <form method="post" action="~/admin/submission-review/reject-auto" class="u-m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm">Reject all @autoRejectedCount auto-rejected</button>
        </form>
    }
</div>

@foreach (var (state, title, help) in order)
{
    var group = Model.Submissions.Where(s => s.ReviewState == state && !Model.SiteChecks.ContainsKey(s.SubmissionId)).ToList();
    if (group.Count == 0) { continue; }

    <h2 id="@state">@title (@group.Count)</h2>
    <p class="u-fs-085em u-op-08">@help</p>

    @foreach (var s in group)
    {
        var orig = Original(s);
        var prop = Proposed(s);
        var issues = ListFromJson(s.ReviewIssuesJson);
        var changes = ChangesFromJson(s.ProposedChangesJson);
        var hasProposal = s.ReviewModel != null && s.ProposedName != null;
        var sensitive = Model.Sensitive(s.SubmissionId);

        <div class="u-callout" id="sub-@s.SubmissionId">
            <div class="u-flex-justify-space-between-gap-12px-flexwrap-wrap">
                <div>
                    <b>#@s.SubmissionId @s.Name</b>
                    @if (s.DirectoryEntryId != null) { <span class="u-fs-085em"> (edit of listing #@s.DirectoryEntryId)</span> }
                    <br /><a href="@s.Link" target="_blank" rel="noopener nofollow">@s.Link</a>
                </div>
                <div class="u-fs-085em">
                    @if (s.ReviewVerdict != null) { <span>Verdict: <b>@s.ReviewVerdict</b> @(s.ReviewConfidence?.ToString("0.00"))</span><br /> }
                    @if (s.ReviewMoneroEvidence != null) { <span>Monero evidence: <b>@s.ReviewMoneroEvidence</b></span><br /> }
                    @if (s.ReviewBannedCategory == true) { <span class="text-danger"><b>Banned sponsorship category</b></span><br /> }
                    @if (s.PaidUtc != null) { <span>💰 donation paid</span> }
                </div>
            </div>

            @{
                // One line that answers "why is this (not) ready to approve?".
                var bannedOnly = state == SubmissionReviewState.Flagged && s.ReviewBannedCategory == true && s.ReviewVerdict == "approve_candidate";
                var reasonLabel = state switch
                {
                    SubmissionReviewState.AiApproveCandidate => "Ready:",
                    SubmissionReviewState.AiRejectCandidate => "Reject because:",
                    SubmissionReviewState.Flagged => bannedOnly ? "Otherwise fine:" : "Not ready:",
                    _ => "Summary:",
                };
            }
            @if (bannedOnly) { <p class="u-m-6px-0-0"><b>Not ready:</b> gambling, medical and adult sites always need your look.</p> }
            @if (!string.IsNullOrWhiteSpace(s.ReviewSummary)) { <p class="u-m-6px-0-0"><b>@reasonLabel</b> @s.ReviewSummary</p> }
            @if (!string.IsNullOrWhiteSpace(s.ReviewPrefilterReason)) { <p class="u-m-6px-0-0 u-fs-085em"><b>Checks:</b> @s.ReviewPrefilterReason</p> }
            @if (!string.IsNullOrWhiteSpace(s.ReviewDuplicateOf)) { <p class="u-m-6px-0-0"><b>Possible duplicate of:</b> @s.ReviewDuplicateOf</p> }
            @if (!string.IsNullOrWhiteSpace(s.ReviewError)) { <p class="u-m-6px-0-0 text-danger"><b>Error:</b> @s.ReviewError</p> }
            @if (issues.Length > 0)
            {
                <ul class="u-m-6px-0-0">
                    @foreach (var i in issues.Take(3)) { <li>@i</li> }
                </ul>
                @if (issues.Length > 3)
                {
                    <details><summary class="u-fs-085em">@(issues.Length - 3) more</summary>
                        <ul class="u-m-6px-0-0">@foreach (var i in issues.Skip(3)) { <li>@i</li> }</ul>
                    </details>
                }
            }

            @if (hasProposal)
            {
                <div class="table-wrapper">
                <table class="table">
                    <thead><tr><th>Field</th><th>Submitted</th><th>Suggested</th></tr></thead>
                    <tbody>
                    @foreach (var key in prop.Keys)
                    {
                        var o = orig.GetValueOrDefault(key);
                        var p = prop[key];
                        if (string.IsNullOrWhiteSpace(o) && string.IsNullOrWhiteSpace(p)) { continue; }
                        var changed = !string.Equals((o ?? "").Trim(), (p ?? "").Trim(), StringComparison.Ordinal);
                        <tr>
                            <td>@key@(key == "Description" && p != null ? $" ({p.Length}/175)" : "")</td>
                            <td class="u-prewrap-break">@o</td>
                            <td class="u-prewrap-break">@if (changed) { <mark>@(string.IsNullOrWhiteSpace(p) ? "(removed)" : p)</mark> } else { @p }</td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
                @if (!string.IsNullOrWhiteSpace(s.ProposedOtherSubcategories))
                {
                    <p class="u-m-6px-0-0"><b>Also fits (add by hand if you want):</b> @s.ProposedOtherSubcategories</p>
                }
                @if (changes.Count > 0)
                {
                    <details><summary class="u-fs-085em">Why these changes</summary>
                        <ul>@foreach (var c in changes) { <li><b>@c.Field</b>: @c.Reason</li> }</ul>
                    </details>
                }
            }

            @if (!string.IsNullOrWhiteSpace(s.ReviewDossier))
            {
                <a class="u-fs-085em" href="~/admin/ai-log?submissionId=@s.SubmissionId">AI calls for this submission</a>
                <details><summary class="u-fs-085em">What the reviewer saw (@s.ReviewModel, @s.ReviewTokensIn in / @s.ReviewTokensOut out tokens)</summary>
                    <pre class="u-prewrap-break u-fs-085em">@s.ReviewDossier</pre>
                </details>
            }
            @if (!string.IsNullOrWhiteSpace(s.ReviewLog))
            {
                <details><summary class="u-fs-085em">History</summary><pre class="u-prewrap-break u-fs-085em">@s.ReviewLog</pre></details>
            }

            @if (sensitive.Count > 0)
            {
                <div class="alert-warning u-mt-05rem">
                    <b>Can't be approved in one click</b> because this edit changes where visitors are sent or how they make contact:
                    <ul class="u-m-6px-0-0">@foreach (var c in sensitive) { <li>@c</li> }</ul>
                    Open it, check these, tick the confirmation box and approve there.
                </div>
            }

            <div class="u-flex-gap-8px-flexwrap-wrap u-mt-05rem">
                @if (hasProposal && sensitive.Count > 0)
                {
                    <a class="btn btn-primary btn-sm" href="~/submission/@s.SubmissionId?useProposal=true&amp;from=ai-review">Check changes, then approve</a>
                }
                else if (hasProposal)
                {
                    <form method="post" action="~/admin/submission-review/@s.SubmissionId/approve" class="u-m-0">
                        @Html.AntiForgeryToken()
                        @if (state == SubmissionReviewState.AiApproveCandidate)
                        {
                            <button type="submit" class="btn btn-primary btn-sm">Approve suggested</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm" title="The reviewer did NOT mark this ready. Read its issues first.">Approve anyway</button>
                        }
                    </form>
                    <a class="btn btn-sm" href="~/submission/@s.SubmissionId?useProposal=true&amp;from=ai-review">Edit then approve</a>
                }
                else
                {
                    <a class="btn btn-sm" href="~/submission/@s.SubmissionId?from=ai-review">Open review form</a>
                }
                <form method="post" action="~/admin/submission-review/@s.SubmissionId/reject" class="u-m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm" title="Reject now, recording the reviewer's reason">Reject</button>
                </form>
                <a class="btn btn-sm" href="~/submission/@s.SubmissionId/reject?from=ai-review">Reject with reason&hellip;</a>
                @if (state != SubmissionReviewState.Pending)
                {
                    <form method="post" action="~/admin/submission-review/@s.SubmissionId/rerun" class="u-m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm">Re-run review</button>
                    </form>
                }
            </div>
        </div>
    }
}

@if (mainDown.Count > 0)
{
    <h2 id="offline">AI-ready: remove as offline, main site down (@mainDown.Count)</h2>
    <p class="u-fs-085em u-op-08">The weekly link check could not load the main site. <b>Approve</b> sets the listing to Removed and adds the reason to its note. <b>Keep listing</b> drops the finding and changes nothing.</p>
    <form method="post" action="~/admin/submission-review/remove-offline-all" class="u-mb-16px">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary">Remove all @mainDown.Count as offline</button>
    </form>
    @foreach (var s in mainDown)
    {
        var c = Model.SiteChecks[s.SubmissionId];
        <div class="u-callout" id="sub-@s.SubmissionId">
            <b>@s.Name</b> <a class="u-fs-085em" href="~/directoryentry/edit/@s.DirectoryEntryId">listing #@s.DirectoryEntryId</a>
            &middot; <a href="@s.Link" target="_blank" rel="noopener nofollow">@s.Link</a>
            <p class="u-m-6px-0-0"><b>Found:</b> main site did not load in @Streak(c.FailStreak) (checked @Checked(c.LastCheckedUtc)).</p>
            <p class="u-m-6px-0-0"><b>Change:</b> status <mark>@c.CurrentStatus &rarr; Removed</mark>; note adds <mark>@(c.Reason ?? "site offline")</mark>. Nothing else changes.</p>
            <div class="u-flex-gap-8px-flexwrap-wrap u-mt-05rem">
                <form method="post" action="~/admin/submission-review/@s.SubmissionId/remove-offline" class="u-m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-sm">Approve: remove as offline</button>
                </form>
                <form method="post" action="~/admin/submission-review/@s.SubmissionId/reject" class="u-m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm">Keep listing</button>
                </form>
                <a class="btn btn-sm" href="~/submission/@s.SubmissionId?from=ai-review">Open review form</a>
            </div>
        </div>
    }
}

@if (torDown.Count > 0)
{
    <h2 id="tor-offline">AI-ready: remove dead Tor link, main site up (@torDown.Count)</h2>
    <p class="u-fs-085em u-op-08">Only the Tor address failed; the main site loaded. <b>Approve</b> takes the dead address off and keeps the listing. <b>Keep as is</b> drops the finding and changes nothing.</p>
    @foreach (var s in torDown)
    {
        var c = Model.SiteChecks[s.SubmissionId];
        <div class="u-callout" id="sub-@s.SubmissionId">
            <b>@s.Name</b> <a class="u-fs-085em" href="~/directoryentry/edit/@s.DirectoryEntryId">listing #@s.DirectoryEntryId</a>
            &middot; <a href="@s.Link" target="_blank" rel="noopener nofollow">@s.Link</a>
            <p class="u-m-6px-0-0"><b>Found:</b> Tor link did not load in @Streak(c.FailStreak) (checked @Checked(c.LastCheckedUtc)). Main site is up.</p>
            @if (c.OnionLink != null)
            {
                <p class="u-m-6px-0-0 u-prewrap-break"><b>Change:</b> Tor link <mark>@c.OnionLink &rarr; (removed)</mark>. Status stays @c.CurrentStatus; nothing else changes.</p>
            }
            else
            {
                <p class="u-m-6px-0-0"><b>Change:</b> none. The listing no longer has a Tor link.</p>
            }
            <div class="u-flex-gap-8px-flexwrap-wrap u-mt-05rem">
                @if (c.OnionLink != null)
                {
                    <form method="post" action="~/admin/submission-review/@s.SubmissionId/remove-tor-link" class="u-m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary btn-sm">Approve: remove Tor link</button>
                    </form>
                }
                <form method="post" action="~/admin/submission-review/@s.SubmissionId/reject" class="u-m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm">Keep as is</button>
                </form>
                <form method="post" action="~/admin/submission-review/@s.SubmissionId/remove-offline" class="u-m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm" title="Sets the whole listing to Removed">Remove whole listing</button>
                </form>
                <a class="btn btn-sm" href="~/submission/@s.SubmissionId?from=ai-review">Open review form</a>
            </div>
        </div>
    }
}

@if (checkWarnings.Count > 0)
{
    <h2 id="check-warnings">Site check warnings (@checkWarnings.Count)</h2>
    <p class="u-fs-085em u-op-08">The listing itself is online. These propose no change: fix the listing by hand if needed, then dismiss.</p>
    <div class="table-wrapper">
    <table class="table">
        <thead><tr><th>Listing</th><th>What the check found</th><th>Decide</th></tr></thead>
        <tbody>
        @foreach (var s in checkWarnings)
        {
            var c = Model.SiteChecks[s.SubmissionId];
            <tr id="sub-@s.SubmissionId">
                <td>
                    <b>@s.Name</b>
                    <br /><a href="@s.Link" target="_blank" rel="noopener nofollow">@s.Link</a>
                </td>
                <td class="u-prewrap-break">@(c.Warning ?? "No detail recorded.")</td>
                <td>
                    <div class="u-flex-gap-8px-flexwrap-wrap">
                        <a class="btn btn-sm" href="~/directoryentry/edit/@s.DirectoryEntryId">Edit listing</a>
                        <form method="post" action="~/admin/submission-review/@s.SubmissionId/reject" class="u-m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm">Dismiss</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}

@if (Model.Submissions.Count == 0)
{
    <p>No pending submissions.</p>
}
}
