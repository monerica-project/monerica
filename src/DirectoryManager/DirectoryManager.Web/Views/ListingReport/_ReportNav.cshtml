@model DirectoryManager.Web.Models.ListingReports.ListingReportRangeViewModel
@{
    var fmt = DirectoryManager.Common.Constants.StringConstants.DateFormat;
    var today = DateTime.UtcNow.Date;
    string D(DateTime d) => d.ToString(fmt);
    string Url(DateTime s, DateTime e) => Model.SingleDate
        ? $"/directoryentry/report/{Model.Section}?end={D(e)}"
        : $"/directoryentry/report/{Model.Section}?start={D(s)}&end={D(e)}";
    var sections = new (string Key, string Label)[]
    {
        ("", "Overview"),
        ("active", "Active over time"),
        ("categories", "Categories"),
        ("countries", "Countries"),
        ("trust", "Trust by country"),
    };
}

<p class="u-m-0-0-75em-0">
    @for (int i = 0; i < sections.Length; i++)
    {
        var s = sections[i];
        if (s.Key == Model.Section)
        {
            <strong>@s.Label</strong>
        }
        else
        {
            <a href="/directoryentry/report@(string.IsNullOrEmpty(s.Key) ? "" : "/" + s.Key)">@s.Label</a>
        }
        @if (i < sections.Length - 1)
        {
            <text> | </text>
        }
    }
</p>

@if (!string.IsNullOrEmpty(Model.Section))
{
    <hr />
    @if (Model.SingleDate)
    {
        <p>
            As of:
            <a href="@Url(today, today)">Today</a> |
            <a href="@Url(today, today.AddDays(-30))">30 days ago</a> |
            <a href="@Url(today, today.AddMonths(-6))">6 months ago</a> |
            <a href="@Url(today, today.AddYears(-1))">1 year ago</a> |
            <a href="@Url(today, today.AddYears(-2))">2 years ago</a>
        </p>
        <form method="get" action="/directoryentry/report/@Model.Section" class="form-row align-items-end mb-4">
            <div class="form-group col-md-3">
                <label for="end">Date (UTC)</label>
                <input id="end" name="end" type="date" class="form-control"
                       min="@D(Model.Earliest)" max="@D(today)" value="@D(Model.End)" />
            </div>
            <div class="form-group col-md-2">
                <button type="submit" class="btn btn-primary">Run</button>
            </div>
        </form>
        <p>Showing listings as they were at the end of <strong>@D(Model.End)</strong> (UTC).</p>
    }
    else
    {
        <p>
            Range:
            <a href="@Url(today.AddDays(-30), today)">Last 30 days</a> |
            <a href="@Url(today.AddDays(-90), today)">90 days</a> |
            <a href="@Url(today.AddMonths(-6), today)">6 months</a> |
            <a href="@Url(today.AddYears(-1), today)">1 year</a> |
            <a href="@Url(today.AddYears(-2), today)">2 years</a> |
            <a href="@Url(Model.Earliest, today)">All (since @D(Model.Earliest))</a>
        </p>
        <form method="get" action="/directoryentry/report/@Model.Section" class="form-row align-items-end mb-4">
            <div class="form-group col-md-3">
                <label for="start">Start date (UTC)</label>
                <input id="start" name="start" type="date" class="form-control"
                       min="@D(Model.Earliest)" max="@D(today)" value="@D(Model.Start)" />
            </div>
            <div class="form-group col-md-3">
                <label for="end">End date (UTC)</label>
                <input id="end" name="end" type="date" class="form-control"
                       min="@D(Model.Earliest)" max="@D(today)" value="@D(Model.End)" />
            </div>
            <div class="form-group col-md-2">
                <button type="submit" class="btn btn-primary">Run</button>
            </div>
        </form>
        <p>Showing <strong>@D(Model.Start)</strong> to <strong>@D(Model.End)</strong> (UTC).</p>
    }
}
