@model DirectoryManager.Web.Models.ListingReports.TrustByCountryReportViewModel
@{
    PageMeta.Title = "Listings Report: Trust by Country";
    Layout = "_CenteredLayout";
    var fmt = DirectoryManager.Common.Constants.StringConstants.DateFormat;
}

@section PageContent {
    <h1>@PageMeta.Title</h1>
    @await Html.PartialAsync("_AdminMenu")
    @await Html.PartialAsync("_ReportNav", Model)

    <p class="u-m-0-0-5em-0">
        Each bar is 100% of a country's active listings, sorted with the most listings at the top.
        The red (Scam) segment shows how untrustworthy a country's listings are; the exact scam rate
        is printed to the right of each bar. The number in parentheses is that country's total active
        listings (sample size).
    </p>
    <p class="u-m-0-0-75em-0-fw-bold">
        <span class="u-inline-block-w-14px-h-14px-bg-2ca02c-valign-middle-mr-4px"></span>Verified&nbsp;&nbsp;
        <span class="u-inline-block-w-14px-h-14px-bg-1f77b4-valign-middle-mr-4px"></span>Admitted&nbsp;&nbsp;
        <span class="u-inline-block-w-14px-h-14px-bg-ff7f0e-valign-middle-mr-4px"></span>Questionable&nbsp;&nbsp;
        <span class="u-inline-block-w-14px-h-14px-bg-d62728-valign-middle-mr-4px"></span>Scam
    </p>
    <img class="u-w-100pct"
         src="/directoryentry/report/trust-chart?end=@Model.End.ToString(fmt)"
         alt="Active listings by country on @Model.End.ToString(fmt), broken down by status" />

    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Country</th>
                    <th class="u-text-right">Total</th>
                    <th class="u-text-right">Verified</th>
                    <th class="u-text-right">Admitted</th>
                    <th class="u-text-right">Questionable</th>
                    <th class="u-text-right">Scam</th>
                    <th class="u-text-right">Scam %</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.Country</td>
                        <td class="u-text-right">@r.Total</td>
                        <td class="u-text-right">@r.Verified</td>
                        <td class="u-text-right">@r.Admitted</td>
                        <td class="u-text-right">@r.Questionable</td>
                        <td class="u-text-right">@r.Scam</td>
                        <td class="u-text-right">@r.ScamPercent.ToString("0.#")%</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
