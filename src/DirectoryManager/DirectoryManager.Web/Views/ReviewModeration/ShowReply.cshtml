@using DirectoryManager.Data.Models.Reviews
@using DirectoryManager.Utilities.Helpers
@using DirectoryManager.Web.Constants
@using DirectoryManager.Data.Models
@using DirectoryManager.Data.Enums

@model DirectoryManager.Web.Models.Reviews.ShowReplyViewModel
@inject DirectoryManager.Web.Services.Implementations.MemberKeyDirectory MemberKeys
@inject DirectoryManager.Data.Repositories.Interfaces.IReviewTagRepository ReviewTags
@inject DirectoryManager.Data.Repositories.Interfaces.IDirectoryEntryReviewTagRepository ReviewTagLinks

@{
    Layout = "_CenteredLayout";
    var reply = Model.Comment;
    var isEditMode = Model.IsEditMode;
    PageMeta.Title = $"Reply #{reply.DirectoryEntryReviewCommentId}";
}

@section PageContent {
    <h1>@PageMeta.Title</h1>

    @await Html.PartialAsync("_AdminMenu")

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (!ViewContext.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @Html.ValidationSummary(excludePropertyErrors: true, message: "Please fix the errors below.")
        </div>
    }

    <dl class="row">
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@reply.ModerationStatus</dd>

        <dt class="col-sm-3">Review Id</dt>
        <dd class="col-sm-9">
            <a asp-action="Show"
               asp-route-id="@reply.DirectoryEntryReviewId">@reply.DirectoryEntryReviewId</a>
        </dd>

        <dt class="col-sm-3">Parent Comment Id</dt>
        <dd class="col-sm-9">@(reply.ParentCommentId?.ToString() ?? "-")</dd>

        <dt class="col-sm-3">Author (PGP / Member)</dt>
        <dd class="col-sm-9"><code>@(DirectoryManager.Web.Helpers.MemberAuthor.ForAdmin(reply.AuthorFingerprint, reply.AuthorUserId, reply.AuthorUsername, await MemberKeys.FingerprintForAsync(reply.AuthorUserId)))</code></dd>

        <dt class="col-sm-3">Created (UTC)</dt>
        <dd class="col-sm-9">@reply.CreateDate.ToString(DirectoryManager.Common.Constants.StringConstants.DateFormat)</dd>

        <dt class="col-sm-3">Updated (UTC)</dt>
        <dd class="col-sm-9">@((reply.UpdateDate?.ToString(DirectoryManager.Common.Constants.StringConstants.DateFormat)) ?? "-")</dd>

        @if (reply.RatingChangedTo.HasValue)
        {
            <dt class="col-sm-3">Rating change</dt>
            <dd class="col-sm-9">The review's author changed their rating from <b>@(reply.RatingChangedFrom?.ToString() ?? "none")</b> to <b>@reply.RatingChangedTo / 5</b> with this reply (already applied).</dd>
        }

        @if (reply.RequestedReviewTagIdsCsv != null)
        {
            var allTags = (await ReviewTags.ListAllAsync()).ToDictionary(t => t.ReviewTagId);
            var currentIds = await ReviewTagLinks.GetTagIdsForReviewAsync(reply.DirectoryEntryReviewId);
            string Names(IEnumerable<int> ids) => string.Join(", ", ids.Select(id => allTags.TryGetValue(id, out var t) ? t.Name : "#" + id).DefaultIfEmpty("(none)"));
            var currentPublic = DirectoryManager.Web.Helpers.OwnReviewEdit.CurrentPublicTags(currentIds, allTags.Values);
            var requested = DirectoryManager.Web.Helpers.OwnReviewEdit.FromCsv(reply.RequestedReviewTagIdsCsv);
            <dt class="col-sm-3">Tag change requested</dt>
            <dd class="col-sm-9">
                The review's author asks to change their review's tags:
                <br /><span class="text-muted">Now:</span> @Names(currentPublic)
                <br /><span class="text-muted">Requested:</span> <b>@Names(requested)</b>
                <br />
                @if (reply.RequestedTagsAppliedUtc is DateTime applied)
                {
                    <small class="text-muted">Applied @applied.ToString(DirectoryManager.Common.Constants.StringConstants.DateFormat) UTC.</small>
                }
                else
                {
                    <small class="text-muted">Approving this reply applies the requested tags (admin-only tags such as Valid Order are kept). Rejecting it leaves the tags as they are.</small>
                }
            </dd>
        }

        <dt class="col-sm-3">Body</dt>
        <dd class="col-sm-9">
            @if (isEditMode)
            {
                <form asp-action="EditReply"
                      asp-route-id="@reply.DirectoryEntryReviewCommentId"
                      method="post">
                    @Html.AntiForgeryToken()
                    <textarea id="body" name="body" class="form-control" rows="10" maxlength="4000">@reply.Body</textarea>
                    @Html.ValidationMessage("body", new { @class = "text-danger" })
                    <div class="mt-2">
                        <button type="submit">Save</button>
                        <a asp-action="ShowReply" asp-route-id="@reply.DirectoryEntryReviewCommentId">Cancel</a>
                    </div>
                </form>
            }
            else
            {
                <pre class="u-ws-pre-wrap">@Html.Raw(StringHelpers.RenderBodyWithLinksHtml(reply.Body, cssClass: "multi-line-text", ugcContent: true, maskEmails: false))</pre>
                <a asp-action="EditReply" asp-route-id="@reply.DirectoryEntryReviewCommentId">Edit</a>
            }
        </dd>
    </dl>

    <div class="mt-3">
        <a asp-action="Pending">Back to Pending</a> |
        <a asp-action="All">Back to All</a>
    </div>

    <hr />

    <div class="mt-3">
        @if (reply.ModerationStatus != ReviewModerationStatus.Approved)
        {
            <form asp-action="ApproveReply"
                  asp-route-id="@reply.DirectoryEntryReviewCommentId"
                  method="post"
                  class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit">Approve</button>
            </form>
        }

        <form asp-action="RejectReply"
              asp-route-id="@reply.DirectoryEntryReviewCommentId"
              method="post"
              class="mt-3">
            @Html.AntiForgeryToken()

            <div class="mb-2">
                <label for="reason" class="form-label">Rejection reason (required to reject)</label>
                <br />
                <textarea id="reason" name="reason" class="form-control" rows="3">@reply.RejectionReason</textarea>
                @Html.ValidationMessage("reason", new { @class = "text-danger" })
            </div>

            <button type="submit">Reject</button>
        </form>

        <form asp-action="DeleteReply"
              asp-route-id="@reply.DirectoryEntryReviewCommentId"
              method="post"
              class="mt-3">
            @Html.AntiForgeryToken()
            <button type="submit">
                Delete
            </button>
        </form>
    </div>
}
