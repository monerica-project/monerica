@using DirectoryManager.Data.Models.Reviews
@using DirectoryManager.Utilities.Helpers
@using DirectoryManager.Web.Constants
@using DirectoryManager.Data.Models
@using DirectoryManager.Data.Enums

@model DirectoryManager.Web.Models.Reviews.ShowReplyViewModel

@{
    Layout = "_CenteredLayout";
    var reply = Model.Comment;
    var isEditMode = Model.IsEditMode;
    PageMeta.Title = $"Reply #{reply.DirectoryEntryReviewCommentId}";
}

@section PageContent {
    <h1>@PageMeta.Title</h1>

    @await Html.PartialAsync("_AdminMenu")

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (!ViewContext.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @Html.ValidationSummary(excludePropertyErrors: true, message: "Please fix the errors below.")
        </div>
    }

    <dl class="row">
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@reply.ModerationStatus</dd>

        <dt class="col-sm-3">Review Id</dt>
        <dd class="col-sm-9">
            <a asp-action="Show"
               asp-route-id="@reply.DirectoryEntryReviewId">@reply.DirectoryEntryReviewId</a>
        </dd>

        <dt class="col-sm-3">Parent Comment Id</dt>
        <dd class="col-sm-9">@(reply.ParentCommentId?.ToString() ?? "-")</dd>

        <dt class="col-sm-3">Author Fingerprint</dt>
        <dd class="col-sm-9"><code>@reply.AuthorFingerprint</code></dd>

        <dt class="col-sm-3">Created (UTC)</dt>
        <dd class="col-sm-9">@reply.CreateDate.ToString(DirectoryManager.Common.Constants.StringConstants.DateFormat)</dd>

        <dt class="col-sm-3">Updated (UTC)</dt>
        <dd class="col-sm-9">@((reply.UpdateDate?.ToString(DirectoryManager.Common.Constants.StringConstants.DateFormat)) ?? "-")</dd>

        <dt class="col-sm-3">Body</dt>
        <dd class="col-sm-9">
            @if (isEditMode)
            {
                <form asp-action="EditReply"
                      asp-route-id="@reply.DirectoryEntryReviewCommentId"
                      method="post">
                    @Html.AntiForgeryToken()
                    <textarea id="body" name="body" class="form-control" rows="10" maxlength="4000">@reply.Body</textarea>
                    @Html.ValidationMessage("body", new { @class = "text-danger" })
                    <div class="mt-2">
                        <button type="submit">Save</button>
                        <a asp-action="ShowReply" asp-route-id="@reply.DirectoryEntryReviewCommentId">Cancel</a>
                    </div>
                </form>
            }
            else
            {
                <pre class="u-ws-pre-wrap">@Html.Raw(StringHelpers.RenderBodyWithLinksHtml(reply.Body, cssClass: "multi-line-text", ugcContent: true, maskEmails: false))</pre>
                <a asp-action="EditReply" asp-route-id="@reply.DirectoryEntryReviewCommentId">Edit</a>
            }
        </dd>
    </dl>

    <div class="mt-3">
        <a asp-action="Pending">Back to Pending</a> |
        <a asp-action="All">Back to All</a>
    </div>

    <hr />

    <div class="mt-3">
        @if (reply.ModerationStatus != ReviewModerationStatus.Approved)
        {
            <form asp-action="ApproveReply"
                  asp-route-id="@reply.DirectoryEntryReviewCommentId"
                  method="post"
                  class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit">Approve</button>
            </form>
        }

        <form asp-action="RejectReply"
              asp-route-id="@reply.DirectoryEntryReviewCommentId"
              method="post"
              class="mt-3">
            @Html.AntiForgeryToken()

            <div class="mb-2">
                <label for="reason" class="form-label">Rejection reason (required to reject)</label>
                <br />
                <textarea id="reason" name="reason" class="form-control" rows="3">@reply.RejectionReason</textarea>
                @Html.ValidationMessage("reason", new { @class = "text-danger" })
            </div>

            <button type="submit">Reject</button>
        </form>

        <form asp-action="DeleteReply"
              asp-route-id="@reply.DirectoryEntryReviewCommentId"
              method="post"
              class="mt-3">
            @Html.AntiForgeryToken()
            <button type="submit"
                    onclick="return confirm('Delete this reply permanently?');">
                Delete
            </button>
        </form>
    </div>
}
