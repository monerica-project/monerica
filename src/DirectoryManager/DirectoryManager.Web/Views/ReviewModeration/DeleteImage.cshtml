@model DirectoryManager.Web.Models.Reviews.ReviewImageActionViewModel
@{
    ViewData["Title"] = $"Delete {Model.FieldLabel}";
    Layout = "_CenteredLayout";
}
@section PageContent {
    <div style="max-width:640px;margin:0 auto;">
        <h1>Delete @Model.FieldLabel?</h1>
        <p class="text-muted">Review #@Model.DirectoryEntryReviewId</p>
        <p>This permanently deletes the image file and clears the field. This cannot be undone.</p>

        @if (!string.IsNullOrWhiteSpace(Model.CurrentUrl))
        {
            <div class="mb-3">
                <img src="@Model.CurrentUrl" alt="@Model.FieldLabel" class="img-fluid" style="max-height:240px;border:1px solid #ccc;border-radius:6px;" />
                <div class="form-text"><a href="@Model.CurrentUrl" target="_blank">@Model.CurrentUrl</a></div>
            </div>
        }

        <form asp-action="DeleteImageConfirmed" asp-route-id="@Model.DirectoryEntryReviewId" asp-route-field="@Model.Field" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">Confirm delete</button>
            <a class="btn btn-secondary" href="/admin/reviews/@Model.DirectoryEntryReviewId/edit">Cancel</a>
        </form>
    </div>
}
