@using DirectoryManager.Web.Constants
@using DirectoryManager.Web.Models
@model PagedListViewModel<DirectoryManager.Data.Models.SponsoredListings.SponsoredListingOpeningNotification>

@{
    PageMeta.Title = "Manage Notifications";
    Layout = "_CenteredLayout";
}

@section PageContent {
    <h1>@PageMeta.Title</h1>

    @await Html.PartialAsync("_AdminMenu")

    @{
        var listingNames = ViewBag.ListingNames as Dictionary<int, string> ?? new Dictionary<int, string>();
        var eligibility = ViewBag.Eligibility as Dictionary<int, (bool Eligible, string? Reason)> ?? new Dictionary<int, (bool Eligible, string? Reason)>();
        var filterLabel = ViewBag.FilterLabel as string;
    }

    @if (filterLabel != null)
    {
        <h2>Waiting for: @filterLabel</h2>
        <p>Everyone here is emailed when this spot opens. Oldest first. <a href="@Url.Action("List")">Show all notifications</a></p>
    }
    else
    {
        <h2>Manage Notifications</h2>
    }

    <div class="u-m-10px-0">
        <span>
            Showing <strong>@Model.FirstItemNumber</strong>-<strong>@Model.LastItemNumber</strong>
            of <strong>@Model.TotalCount</strong>
        </span>

        <span class="u-ml-16px">
            Page <strong>@Model.Page</strong> of <strong>@Model.TotalPages</strong>
        </span>
    </div>

    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Listing</th>
                    <th>Eligible now</th>
                    <th>Email</th>
                    <th>Create Date</th>
                    <th>Sponsorship Type</th>
                    <th>Type Id</th>
                    <th>Reminder Sent</th>
                    <th>In Queue (Active)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.TotalCount == 0)
                {
                    <tr>
                        <td colspan="9">No notifications found.</td>
                    </tr>
                }
                else
                {
                    foreach (var notification in Model.Items)
                    {
                        <tr>
                            <td>@(notification.DirectoryEntryId is int eid && listingNames.TryGetValue(eid, out var lname) ? lname : "")</td>
                            <td>
                                @if (eligibility.TryGetValue(notification.SponsoredListingOpeningNotificationId, out var el))
                                {
                                    if (el.Eligible)
                                    {
                                        <span class="text-success">&#9989; Yes</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">&#10060; No</span> <span class="u-opacity-5">&middot; @el.Reason</span>
                                    }
                                }
                            </td>
                            <td>@notification.Email</td>
                            <td>@notification.CreateDate.ToString(DirectoryManager.Common.Constants.StringConstants.DateTimeFormat)</td>
                            <td>@notification.SponsorshipType</td>
                            <td>@notification.TypeId</td>
                            <td>@notification.IsReminderSent</td>
                            <td>@(notification.IsActive ? "Yes" : "No")</td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = notification.SponsoredListingOpeningNotificationId })">Edit</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="u-mt-12px-flex-gap-8px-items-center-flexwrap-wrap">
            @* Previous *@
            @if (Model.HasPrevious)
            {
                <a href="@Url.Action("List", new { type = (object?)ViewBag.FilterType, typeId = (object?)ViewBag.FilterTypeId, page = Model.Page - 1, pageSize = Model.PageSize })">← Prev</a>
            }
            else
            {
                <span class="u-opacity-5">← Prev</span>
            }

            @* Page numbers (windowed) *@
            @{
                var window = 3; // pages on each side
                var start = Math.Max(1, Model.Page - window);
                var end = Math.Min(Model.TotalPages, Model.Page + window);

                // Ensure at least a small window when near edges
                if (Model.Page <= window)
                {
                    end = Math.Min(Model.TotalPages, 1 + (window * 2));
                }
                else if (Model.Page + window > Model.TotalPages)
                {
                    start = Math.Max(1, Model.TotalPages - (window * 2));
                }
            }

            @if (start > 1)
            {
                <a href="@Url.Action("List", new { type = (object?)ViewBag.FilterType, typeId = (object?)ViewBag.FilterTypeId, page = 1, pageSize = Model.PageSize })">1</a>
                @if (start > 2)
                {
                    <span>…</span>
                }
            }

            @for (int i = start; i <= end; i++)
            {
                if (i == Model.Page)
                {
                    <strong class="u-p-2px-6px-border-1px-solid-ccc-rounded-4px">@i</strong>
                }
                else
                {
                    <a href="@Url.Action("List", new { type = (object?)ViewBag.FilterType, typeId = (object?)ViewBag.FilterTypeId, page = i, pageSize = Model.PageSize })">@i</a>
                }
            }

            @if (end < Model.TotalPages)
            {
                if (end < Model.TotalPages - 1)
                {
                    <span>…</span>
                }
                <a href="@Url.Action("List", new { type = (object?)ViewBag.FilterType, typeId = (object?)ViewBag.FilterTypeId, page = Model.TotalPages, pageSize = Model.PageSize })">@Model.TotalPages</a>
            }

            @* Next *@
            @if (Model.HasNext)
            {
                <a href="@Url.Action("List", new { type = (object?)ViewBag.FilterType, typeId = (object?)ViewBag.FilterTypeId, page = Model.Page + 1, pageSize = Model.PageSize })">Next →</a>
            }
            else
            {
                <span class="u-opacity-5">Next →</span>
            }

            @* Page size *@
            <span class="u-ml-10px-opacity-8">Page size:</span>
            @{
                int[] sizes = new[] { 25, 50, 100, 200 };
            }
            @foreach (var s in sizes)
            {
                if (s == Model.PageSize)
                {
                    <strong>@s</strong>
                }
                else
                {
                    <a href="@Url.Action("List", new { type = (object?)ViewBag.FilterType, typeId = (object?)ViewBag.FilterTypeId, page = 1, pageSize = s })">@s</a>
                }
            }
        </nav>
    }
}
