@using DirectoryManager.Data.Enums
@model DirectoryManager.Data.Models.VideoSponsorships.VideoIdea
@{
    var isNew = Model.VideoIdeaId == 0;
    PageMeta.Title = isNew ? "Add Video Idea" : "Edit Video Idea";
    Layout = "_CenteredLayout";
    VideoIdeaStatus[] statuses = { VideoIdeaStatus.Queued, VideoIdeaStatus.Completed, VideoIdeaStatus.Retired };
}

@section PageContent {
    <h1>@PageMeta.Title</h1>
    @await Html.PartialAsync("_Nav")

    <form method="post" action="~/admin/video-sponsorship/videos/edit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="videoIdeaId" value="@Model.VideoIdeaId" />

        <div class="form-group">
            <label for="title"><b>Topic</b></label>
            <input class="form-control" id="title" name="title" type="text" value="@Model.Title" maxlength="200" required />
        </div>
        <div class="form-group">
            <label for="description"><b>Description</b> (shown to buyers and on the public upcoming list)</label>
            <textarea class="form-control" id="description" name="description" rows="4" maxlength="2000">@Model.Description</textarea>
        </div>
        <div class="form-group">
            <label for="status"><b>Status</b></label>
            <select class="form-select select-fit" id="status" name="status">
                @foreach (var s in statuses)
                {
                    <option value="@s" selected="@(Model.Status == s)">@s</option>
                }
            </select>
            <div class="form-text">Queued = upcoming and can be sponsored. Completed = published. Retired = dropped and hidden.</div>
        </div>
        <div class="form-group">
            <label for="sortOrder"><b>Display order</b> (lowest first)</label>
            <input class="form-control u-w-200px-imp" id="sortOrder" name="sortOrder" type="number" value="@Model.SortOrder" />
        </div>
        <div class="form-group">
            <label for="videoUrl"><b>Published video URL</b> (optional)</label>
            <input class="form-control" id="videoUrl" name="videoUrl" type="text" value="@Model.VideoUrl" maxlength="500" />
            <div class="form-text">For a sponsored video, set the URL on its order instead; that is what sends the buyer their email.</div>
        </div>
        <br />
        <button class="btn btn-primary" type="submit">Save</button>
        <a class="btn btn-secondary" href="~/admin/video-sponsorship/videos">Cancel</a>
    </form>
}
