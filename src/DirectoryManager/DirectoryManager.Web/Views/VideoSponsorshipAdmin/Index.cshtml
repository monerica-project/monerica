@model DirectoryManager.Web.Models.VideoSponsorship.VideoSponsorAdminHomeVm
@{
    PageMeta.Title = "Video Sponsorship";
    Layout = "_CenteredLayout";
}

@section PageContent {
    <h1>Video Sponsorship</h1>
    @await Html.PartialAsync("_Nav")

    <h2>Status</h2>
    <ul>
        <li>
            Feature:
            @if (Model.IsEnabled)
            {
                <strong class="text-success">ON</strong>
            }
            else
            {
                <strong class="text-danger">OFF</strong> <span class="text-muted">(public pages return Not Found)</span>
            }
        </li>
        <li>
            Payment store:
            @if (Model.IsPaymentConfigured)
            {
                <strong class="text-success">configured</strong>
            }
            else
            {
                <strong class="text-danger">not configured</strong>
                <span class="text-muted">(checkout stays unavailable until it is)</span>
            }
        </li>
        <li>Videos in the queue: <strong>@Model.QueuedVideos</strong> (<strong>@Model.OpenToSponsor</strong> open to a sponsor)</li>
        <li>Paid orders: <a href="~/admin/video-sponsorship/orders"><strong>@Model.PaidOrders</strong></a></li>
        <li>Paid videos still to deliver: <a href="~/admin/video-sponsorship/orders?filter=outstanding"><strong>@Model.VideosOutstanding</strong></a></li>
        <li>
            Orders needing attention:
            <a href="~/admin/video-sponsorship/orders?filter=attention"><strong class="@(Model.OrdersNeedingAttention > 0 ? "text-danger" : "")">@Model.OrdersNeedingAttention</strong></a>
        </li>
    </ul>

    <h2>Settings</h2>
    <form method="post" action="~/admin/video-sponsorship/settings">
        @Html.AntiForgeryToken()
        <div class="form-check">
            <label class="form-check-label u-flex-items-center-gap-8px-flexwrap-wrap">
                <input class="form-check-input" type="checkbox" id="isEnabled" name="isEnabled" value="true" @(Model.IsEnabled ? "checked" : "") />
                <span><b>Video sponsorship is on</b></span>
            </label>
            <input type="hidden" name="isEnabled" value="false" />
            <div class="form-text">Turns the public pages and checkout on or off. Admin pages always work.</div>
        </div>
        <div class="form-group">
            <label for="channelUrl"><b>YouTube channel URL</b></label>
            <input class="form-control" id="channelUrl" name="channelUrl" type="text" value="@Model.ChannelUrl" maxlength="300" />
            <div class="form-text">Shown to buyers before checkout.</div>
        </div>
        <div class="form-group">
            <label for="videoSiteUrl"><b>Video site URL</b></label>
            <input class="form-control" id="videoSiteUrl" name="videoSiteUrl" type="text" value="@Model.VideoSiteUrl" maxlength="300" />
            <div class="form-text">Our own site where the same videos are also published. Shown on the sponsorship page; leave empty to hide.</div>
        </div>
        <div class="form-group">
            <label for="blogUrl"><b>Blog URL</b></label>
            <input class="form-control" id="blogUrl" name="blogUrl" type="text" value="@Model.BlogUrl" maxlength="300" />
            <div class="form-text">Each sponsored video also gets a blog article here. Shown on the sponsorship pages; leave empty to hide.</div>
        </div>
        <br />
        <button class="btn btn-primary" type="submit">Save settings</button>
    </form>

    <hr />
    <h2>Public pages</h2>
    <ul>
        <li><a href="~/video-sponsorship">/video-sponsorship</a> &mdash; who sponsored which video (not linked from anywhere)</li>
        <li><a href="~/video-sponsorship/upcoming">/video-sponsorship/upcoming</a> &mdash; upcoming videos</li>
        <li><a href="~/video-sponsorship/start">/video-sponsorship/start</a> &mdash; start of checkout</li>
    </ul>

    <h2>Payment store setup</h2>
    <p>
        Video sponsorships use their own BTCPay store. Its settings are in the site's
        appsettings (the <code>PaymentProcessors:BTCPayServer</code> section):
        <code>VideoSponsorStoreId</code> and <code>VideoSponsorWebhookSecret</code> are required;
        <code>VideoSponsorApiKey</code> is optional and falls back to the main API key.
        Changing them needs a redeploy.
    </p>
    <p>In that BTCPay store, add a webhook (all invoice events) pointing to:</p>
    <p><code>@Model.WebhookUrl</code></p>
}
