@using DirectoryManager.Web.Constants;

@{
    PageMeta.Title = "Unsubscribe";
}

@{
    Layout = "_CenteredLayout";
}

@section PageContent {
    <div class="page-header-bar">
        <h1 class="page-title">@PageMeta.Title</h1>
        @await Html.PartialAsync("_SiteLogo")
    </div>

@if (string.IsNullOrWhiteSpace(Model))
{
    <p>Please enter your email to unsubscribe</p>

    @if (!ViewContext.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @Html.ValidationSummary()
        </div>
    }
    <form asp-controller="EmailSubscription" asp-action="Unsubscribe" method="post">

        @Html.AntiForgeryToken()

        <div class="form-group">
            <input class="form-control input-width" name="formEmail" type="email" id="inlineFormInput" placeholder="yourname@email.com" value="@(ViewBag.PrefillEmail as string)" required>
        </div>

        @await Html.PartialAsync("_CaptchaBlock", "newsletter-unsubscribe")

        <button type="submit" class="btn btn-primary ui-submit btn-cta">Unsubscribe</button>
    </form>
}
else
{
    <p>The email <strong>@Model</strong> has been successfully unsubscribed.</p>
}
}