@model DirectoryManager.Web.Models.LoginViewModel
@using DirectoryManager.Web.Constants;

@{
    PageMeta.Title = "Admin home";
    Layout = "_CenteredLayout";
}

@functions {
    // Smallest-unit compact relative time: 45m / 3h / 2d.
    // Only one unit is shown, whichever is the current "bucket".
    static string FormatAgoCompact(DateTime? utc)
    {
        if (!utc.HasValue)
        {
            return string.Empty;
        }

        var diff = DateTime.UtcNow - utc.Value;
        if (diff.TotalSeconds < 60)
        {
            return "just now";
        }

        if (diff.TotalMinutes < 60)
        {
            return $"{(int)diff.TotalMinutes}m ago";
        }

        if (diff.TotalHours < 24)
        {
            return $"{(int)diff.TotalHours}h ago";
        }

        return $"{(int)diff.TotalDays}d ago";
    }
}

@functions {
    // Bold red count when something is waiting, grey dash when nothing is.
    static Microsoft.AspNetCore.Html.IHtmlContent WaitingCell(int count) =>
        new Microsoft.AspNetCore.Html.HtmlString(count > 0
            ? $"<b class=\"u-color-c0392b\">{count}</b>"
            : "<span class=\"u-color-888\">0</span>");

    // "3h ago" with the exact UTC time on hover; a grey dash when there's none.
    static Microsoft.AspNetCore.Html.IHtmlContent AgoCell(DateTime? utc) =>
        new Microsoft.AspNetCore.Html.HtmlString(utc is DateTime t
            ? $"<span title=\"{t.ToString(DirectoryManager.Common.Constants.StringConstants.DateTimeShortFormat)} UTC\">{FormatAgoCompact(t)}</span>"
            : "<span class=\"u-color-888\">—</span>");

    // "$250" (or "$12.50") and a small "1.234 XMR" underneath.
    static string Money(decimal? usd, decimal? xmr)
    {
        var parts = new List<string>();
        if (usd is decimal u && u > 0)
        {
            parts.Add("<b>$" + u.ToString(u % 1 == 0 ? "N0" : "N2", System.Globalization.CultureInfo.InvariantCulture) + "</b>");
        }

        if (xmr is decimal x && x > 0)
        {
            parts.Add("<small class=\"task-xmr\">" + x.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) + " XMR</small>");
        }

        return string.Join(" ", parts);
    }

    // Last paid: "3d ago" (hover = exact time) with the amount underneath.
    static Microsoft.AspNetCore.Html.IHtmlContent PaidCell(object? pay)
    {
        if (pay is not ValueTuple<DateTime?, decimal?, decimal?> p || p.Item1 is not DateTime t)
        {
            return new Microsoft.AspNetCore.Html.HtmlString("<span class=\"u-color-888\">—</span>");
        }

        var money = Money(p.Item2, p.Item3);
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<span title=\"{t.ToString(DirectoryManager.Common.Constants.StringConstants.DateTimeShortFormat)} UTC\">{FormatAgoCompact(t)}</span>" +
            (money.Length > 0 ? "<br />" + money : string.Empty));
    }

    // Payments stuck in between: seen but unconfirmed (pending) or too little sent (underpaid).
    static Microsoft.AspNetCore.Html.IHtmlContent PaymentAttention(int pending, int underPaid)
    {
        var parts = new List<string>();
        if (underPaid > 0)
        {
            parts.Add($"{underPaid} underpaid");
        }

        if (pending > 0)
        {
            parts.Add($"{pending} pending");
        }

        return new Microsoft.AspNetCore.Html.HtmlString(parts.Count > 0
            ? $"<b class=\"u-color-c0392b\">⚠ {string.Join(", ", parts)}</b>"
            : "<span class=\"u-color-888\">—</span>");
    }

    // Too much sent recently: the sponsorship is live, but the excess may need refunding.
    static Microsoft.AspNetCore.Html.IHtmlContent OverpaidNote(int overPaid) =>
        new Microsoft.AspNetCore.Html.HtmlString(overPaid > 0
            ? $"<small class=\"u-color-c0392b\" title=\"Overpaid in the last 30 days\">({overPaid} overpaid)</small>"
            : string.Empty);
}

@section PageContent {

    <h1>@PageMeta.Title</h1>

    <p><b>Current UTC time:</b> @DateTime.UtcNow.ToString(DirectoryManager.Common.Constants.StringConstants.DateTimeShortFormat) UTC <i class="u-opacity-5">(as of page load)</i></p>

    <hr />

    <i>Signed in as: </i> @User?.Identity?.Name

    <p class="mt-2">
        <b>Public site (monerica.com &rarr; Bunny):</b>
        <br />
        &nbsp;&nbsp;<b>Files last synced</b> (content actually uploaded):
        @if (ViewBag.LastBunnyFilesSyncedUtc is DateTime filesSynced)
        {
            <span class="u-color-888">@filesSynced.ToString(DirectoryManager.Common.Constants.StringConstants.DateTimeShortFormat) UTC (@FormatAgoCompact(filesSynced))</span>
        }
        else
        {
            <span class="u-color-888">unknown</span>
        }
        <br />
        &nbsp;&nbsp;Last checked (ran, changes or not):
        @if (ViewBag.LastBunnyCheckedUtc is DateTime lastChecked)
        {
            var stale = (DateTime.UtcNow - lastChecked) > TimeSpan.FromMinutes(15);
            <span class="@(stale ? "u-color-c0392b" : "u-color-888")">
                @lastChecked.ToString(DirectoryManager.Common.Constants.StringConstants.DateTimeShortFormat) UTC (@FormatAgoCompact(lastChecked))@(stale ? " — ⚠ stale, the syncer may have stopped" : string.Empty)
            </span>
        }
        else
        {
            <span class="u-color-c0392b">status unavailable — the syncer hasn't reported a successful run</span>
        }
        <br />
        <small class="u-color-888"><i>The public site is a cached static mirror. The syncer checks every 5 minutes but only uploads files when the content has actually changed.</i></small>
    </p>

    <hr />

    @* =============================================================
       DAILY TASKS — pinned at top.
       ============================================================= *@
    @{ var lastPay = ViewBag.LastPayment as ValueTuple<DateTime, decimal?, decimal?, string, string>?; }
    @if (lastPay is { } lp)
    {
        @* Most recent money in, of any kind, linked to what it was for. *@
        <p class="last-payment">
            <b>Last payment:</b>
            @lp.Item1.ToString(DirectoryManager.Common.Constants.StringConstants.DateTimeShortFormat) UTC
            <small class="u-color-888">(@FormatAgoCompact(lp.Item1))</small>
            &middot; @Html.Raw(Money(lp.Item2, lp.Item3))
            &middot; <a href="@lp.Item5">@lp.Item4</a>
        </p>
    }
    <h3>Daily Tasks</h3>
    @{
        int pendingSubs = Convert.ToInt32(ViewBag.TotalPendingSubmissions ?? 0);
        int pendingRevs = Convert.ToInt32(ViewBag.TotalPendingReviewReviews ?? 0);
        int pendingComments = Convert.ToInt32(ViewBag.TotalPendingReviewComments ?? 0);
        int pendingProblems = Convert.ToInt32(ViewBag.TotalPendingProblemReports ?? 0);
        int pendingVerifs = Convert.ToInt32(ViewBag.TotalPendingVerificationRequests ?? 0);
        var newestSub = ViewBag.NewestPendingSubmissionUtc as DateTime?;
        var newestRev = ViewBag.NewestPendingReviewUtc as DateTime?;
        var newestProb = ViewBag.NewestPendingProblemUtc as DateTime?;
        var newestVerif = ViewBag.NewestPendingVerificationUtc as DateTime?;
        var unpaidCheckout = ViewBag.LastInvoicePendingUtc as DateTime?;
        var invAttn = ViewBag.InvoiceAttention is ValueTuple<int, int, int> ia ? ia : (0, 0, 0);
        var vidAttn = ViewBag.VideoAttention is ValueTuple<int, int, int, DateTime?> va ? va : (0, 0, 0, (DateTime?)null);

        // The single newest thing a user sent that still needs looking at.
        var waiting = new List<(string Label, DateTime When, string Url)>();
        if (newestSub is DateTime w1) { waiting.Add(("Submission", w1, "/submission/index")); }
        if (newestRev is DateTime w2) { waiting.Add(("Review", w2, "/admin/reviews")); }
        if (newestProb is DateTime w3) { waiting.Add(("Problem report", w3, "/admin/problem-reports")); }
        if (newestVerif is DateTime w4) { waiting.Add(("Verification request", w4, "/admin/verification-requests")); }
        var newestWaiting = waiting.OrderByDescending(x => x.When).FirstOrDefault();
        int totalWaiting = pendingSubs + pendingRevs + pendingComments + pendingProblems + pendingVerifs;
    }
    <p class="admin-needs-attention">
        @if (waiting.Count > 0)
        {
            <b class="u-color-c0392b">Needs attention:</b>
            <span>@totalWaiting waiting &middot; newest is a</span>
            <a href="@newestWaiting.Url"><b>@newestWaiting.Label.ToLowerInvariant()</b></a>
            <span title="@newestWaiting.When.ToString(DirectoryManager.Common.Constants.StringConstants.DateTimeShortFormat) UTC">from @FormatAgoCompact(newestWaiting.When)</span>
        }
        else
        {
            <b>All caught up ✓</b> <span class="u-color-888">nothing is waiting for review.</span>
        }
    </p>
    <div class="table-wrapper">
        <table class="table table-sm admin-daily-tasks">
            <colgroup><col class="c-task" /><col class="c-wait" /><col class="c-paid" /><col class="c-new" /></colgroup>
            <thead>
                <tr>
                    <th>Task</th>
                    <th>Waiting</th>
                    <th>Last paid</th>
                    <th>Newest waiting</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="task-name"><a href="~/submission/index">Submissions</a></td>
                    <td data-label="Waiting">@WaitingCell(pendingSubs)</td>
                    <td data-label="Last paid">@PaidCell(ViewBag.PaySubmission)</td>
                    <td data-label="Newest">@AgoCell(newestSub)</td>
                </tr>
                <tr>
                    <td class="task-name"><a href="~/admin/reviews">Reviews</a></td>
                    <td data-label="Waiting">
                        @WaitingCell(pendingRevs + pendingComments)
                        @if (pendingRevs + pendingComments > 0)
                        {
                            <small class="u-color-888">(@pendingRevs reviews, @pendingComments replies)</small>
                        }
                    </td>
                    <td data-label="Last paid"><span class="u-color-888">—</span></td>
                    <td data-label="Newest">@AgoCell(newestRev)</td>
                </tr>
                <tr>
                    <td class="task-name"><a href="~/admin/problem-reports">Problems</a></td>
                    <td data-label="Waiting">@WaitingCell(pendingProblems)</td>
                    <td data-label="Last paid">@PaidCell(ViewBag.PayProblem)</td>
                    <td data-label="Newest">@AgoCell(newestProb)</td>
                </tr>
                <tr>
                    <td class="task-name"><a href="~/admin/verification-requests">Verifications</a></td>
                    <td data-label="Waiting">@WaitingCell(pendingVerifs)</td>
                    <td data-label="Last paid">@PaidCell(ViewBag.PayVerification)</td>
                    <td data-label="Newest">@AgoCell(newestVerif)</td>
                </tr>
                <tr>
                    <td class="task-name"><a href="~/sponsoredlistinginvoice">Site Sponsors</a></td>
                    <td data-label="Waiting">@PaymentAttention(invAttn.Item1, invAttn.Item2)</td>
                    <td data-label="Last paid">@PaidCell(ViewBag.PayInvoice) @OverpaidNote(invAttn.Item3)</td>
                    <td data-label="Newest">@AgoCell(unpaidCheckout)</td>
                </tr>
                <tr>
                    <td class="task-name">
                        <a href="~/admin/video-sponsorship/sponsors">Video Sponsors</a>
                        <a class="task-sub" href="~/admin/video-sponsorship/orders">orders</a>
                    </td>
                    <td data-label="Waiting">@PaymentAttention(vidAttn.Item1, vidAttn.Item2)</td>
                    <td data-label="Last paid">@PaidCell(ViewBag.PayVideo) @OverpaidNote(vidAttn.Item3)</td>
                    <td data-label="Newest">@AgoCell(vidAttn.Item4)</td>
                </tr>
            </tbody>
        </table>
    </div>
    <small class="u-color-888"><i>Newest waiting = the most recent item not yet handled (blank when nothing is waiting). Hover a time for the exact date (UTC). Paid = payment detected by BTCPay. For sponsors, "pending" = payment seen but not confirmed, "underpaid" = too little sent (not activated), "overpaid" = too much sent in the last 30 days (activated; excess may need refunding).</i></small>
    <p class="u-mt-4px"><a href="~/admin/activity"><b>Activity report</b></a> &mdash; everything people submitted (listings, edits, reviews, replies, problems, verifications) per week and month.</p>

    <hr />

