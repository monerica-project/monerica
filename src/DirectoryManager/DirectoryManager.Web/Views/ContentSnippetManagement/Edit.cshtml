@model DirectoryManager.Web.Models.ContentSnippet.ContentSnippetEditModel
@using DirectoryManager.Web.Constants

@{
    PageMeta.Title = "Edit Snippet";
    Model.FormAction = "Edit";
    Model.SubmitLabel = "Update";
    ViewBag.SnippetTypes = Html.GetEnumSelectList<DirectoryManager.Data.Enums.SiteConfigSetting>();
}

@{
    Layout = "_CenteredLayout";
}

@section PageContent {

<h1>@PageMeta.Title</h1>

@await Html.PartialAsync("_AdminMenu")

@await Html.PartialAsync("_ContentSnippetForm", Model)
}