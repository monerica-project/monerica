@using DirectoryManager.Data.Enums
@model DirectoryManager.Web.Models.ProblemReports.ProblemReportQueueViewModel
@{
    ViewData["Title"] = "Problem Reports";
    Layout = "_CenteredLayout";

    ProblemReportStatus[] tabs =
    {
        ProblemReportStatus.Pending,
        ProblemReportStatus.Reviewed,
        ProblemReportStatus.Dismissed
    };

    // Items arrive newest-first from the repository. Group them by listing so multiple
    // reports for the same listing sit together, ordering the groups by their newest
    // report (newest group at the top) and each group's reports newest-first.
    var groups = Model.Items
        .GroupBy(r => r.DirectoryEntryId)
        .Select(g => new
        {
            DirectoryEntryId = g.Key,
            Entry = g.Select(x => x.DirectoryEntry).FirstOrDefault(x => x != null),
            Requests = g.OrderByDescending(x => x.CreateDate)
                        .ThenByDescending(x => x.ProblemReportId)
                        .ToList()
        })
        .OrderByDescending(g => g.Requests[0].CreateDate)
        .ThenByDescending(g => g.Requests[0].ProblemReportId)
        .ToList();
}

@section PageContent {
    <div class="container py-4">
        <h1 class="mb-3">Problem Reports</h1>
        <hr />
        @await Html.PartialAsync("_AdminMenu")

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

        <ul class="nav nav-pills mb-3">
            @foreach (var t in tabs)
            {
                <li class="nav-item">
                    <a class="nav-link @(Model.Status == t ? "active" : "")"
                       href="/admin/problem-reports?status=@t">@t</a>
                </li>
            }
        </ul>

        <p class="text-muted">
            @Model.Total @Model.Status report@(Model.Total == 1 ? "" : "s")
            across @groups.Count listing@(groups.Count == 1 ? "" : "s").
        </p>

        @if (groups.Count == 0)
        {
            <p class="text-muted">Nothing here.</p>
        }
        else
        {
            <div class="table-wrapper">
                <table class="table table-sm align-middle u-tablelayout-fixed-w-100pct vr-table">
                    <colgroup>
                        <col class="u-w-26pct" />
                        <col class="u-w-130px" />
                        <col />
                        <col class="u-w-130px" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Listing</th>
                            <th>Reported</th>
                            <th>Problem</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var groupIndex = 0; }
                        @foreach (var grp in groups)
                        {
                            // Explicit per-group background so each listing reads as one block
                            // (and to override the default even-row striping under rowspan).
                            var tint = groupIndex % 2 == 1
                                ? "rgba(255,255,255,0.03)"
                                : "transparent";
                            var rowCount = grp.Requests.Count;

                            for (var i = 0; i < rowCount; i++)
                            {
                                var r = grp.Requests[i];
                                <tr style="background-color:@tint;@(i == 0 ? "border-top:2px solid var(--border-strong);" : "")">
                                    @if (i == 0)
                                    {
                                        <td class="u-valign-top-ws-normal-wordbreak-break-word" rowspan="@rowCount" data-label="Listing">
                                            @if (grp.Entry != null)
                                            {
                                                <div>
                                                    <a href="/site/@grp.Entry.DirectoryEntryKey" target="_blank" rel="noopener">@grp.Entry.Name</a>
                                                    @if (rowCount > 1)
                                                    {
                                                        <span class="badge bg-info u-ml-6px">@rowCount reports</span>
                                                    }
                                                </div>
                                                <div>
                                                    <a href="/directoryentry/edit/@grp.DirectoryEntryId" class="small">Edit listing / change status &rarr;</a>
                                                </div>
                                                <div>
                                                    <a href="/admin/reviews/entry/@grp.DirectoryEntryId" class="small">Open in review moderation &rarr;</a>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">#@grp.DirectoryEntryId</span>
                                            }
                                        </td>
                                    }
                                    <td class="u-valign-top" data-label="Reported">
                                        <div class="text-nowrap">@r.CreateDate.ToString(DirectoryManager.Common.Constants.StringConstants.DateFormat)</div>
                                        <div class="u-mt-4px">
                                            @if (r.PaidUtc != null)
                                            {
                                                <span class="badge bg-success u-badge-wrap" title="Donation received @r.PaidUtc?.ToString(DirectoryManager.Common.Constants.StringConstants.DateFormat)">
                                                    &#128176; Paid@(r.PaidAmount is decimal amt && amt > 0 ? $" {amt:0.##} {r.PaidCurrency}" : "")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary u-display-ib">Not paid</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="u-valign-top" data-label="Problem">
                                        <div class="u-webkitbox-lineclamp-2-boxorient-vertical-overflow-hidden" title="@r.Comment">@r.Comment</div>
                                        <a href="/admin/problem-reports/@r.ProblemReportId" class="small">View full text &rarr;</a>
                                    </td>
                                    <td class="u-valign-top" data-label="Actions">
                                        @if (r.Status == ProblemReportStatus.Pending)
                                        {
                                            <div class="u-flex-flexdir-column-gap-4px-items-stretch">
                                                <form action="/admin/problem-reports/@r.ProblemReportId/reviewed" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-primary u-w-100pct" title="Mark this report reviewed">&#10003; Reviewed</button>
                                                </form>
                                                <form action="/admin/problem-reports/@r.ProblemReportId/dismiss" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary u-w-100pct">Dismiss</button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@r.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                            groupIndex++;
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Total > Model.PageSize)
            {
                var totalPages = Math.Max(1, (int)Math.Ceiling(Model.Total / (double)Model.PageSize));
                <nav class="mt-3" aria-label="Problem report pages">
                    <ul class="pagination pagination-sm mb-0 u-flex-wrap">
                        @if (Model.Page > 1)
                        {
                            <li class="page-item"><a class="page-link" href="/admin/problem-reports?status=@Model.Status&page=@(Model.Page - 1)">&larr; Newer</a></li>
                        }
                        <li class="page-item disabled"><span class="page-link">Page @Model.Page of @totalPages</span></li>
                        @if (Model.Page < totalPages)
                        {
                            <li class="page-item"><a class="page-link" href="/admin/problem-reports?status=@Model.Status&page=@(Model.Page + 1)">Older &rarr;</a></li>
                        }
                    </ul>
                </nav>
            }
        }
    </div>
}
