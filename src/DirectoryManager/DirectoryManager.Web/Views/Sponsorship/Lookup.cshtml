@model DirectoryManager.Web.Models.Sponsorship.SponsorshipIndexVm
@{
    PageMeta.Title = "Find Your Sponsorship Options";
    Layout = "_CenteredLayout";

    var q = (Model.Query ?? string.Empty).Trim();
}

@section PageContent {

    <div class="page-header-bar">
        <h1 class="page-title">Sponsorship options &amp; prices</h1>
        @await Html.PartialAsync("_SiteLogo")
    </div>

    @await Html.PartialAsync("_BackToHome")
    <hr />

    <p class="u-m-6px-0-10px-0-fs-105rem">
        Search your listing to see <strong>every placement</strong> — Main (site-wide), Category, and Subcategory —
        with <strong>live prices</strong> and which spots are <strong>open right now</strong>.
        Main can be full while your Category/Subcategory spots are still open.
    </p>
    <p class="u-m-0-0-14px-0-opacity-9">
        Not listed yet? <a href="~/submit">Submit it first →</a>
        · <a href="~/sponsoredlisting/offers">View full price list</a>
        · <a href="~/sponsors">See current sponsors</a>
    </p>
    @await Html.PartialAsync("_VideoSponsorPromo")

    <!-- ELIGIBILITY — stated up front, before the search, so nobody has to ask -->
    @* Neutral (non-orange) callout — adspace-full would force orange 18px on every <p>. *@
    <div class="u-callout">
        <p><strong>Who can sponsor: both of these are required</strong></p>
        <ol class="u-m-0-0-12px-0-pl-22px">
            <li>
                Your listing is <strong>Verified</strong> — the green checkmark
                (&#9989;) shown on the listing.
            </li>
            <li>
                Your listing has been in the directory for at least
                <strong>@DirectoryManager.Common.Constants.IntegerConstants.MinimumDaysListedBeforeSponsoring days</strong>.
            </li>
        </ol>
        @* u-ws-nowrap keeps "Full requirements →" together so the arrow can't wrap
           onto a line by itself. *@
        <p>
            Search below to see which requirement is missing and how long is left.
            <a class="u-ws-nowrap" href="~/faq#sponsorship-requirements">Full requirements &rarr;</a>
        </p>
    </div>

    <!-- SEARCH -->
    <form method="get" action="@Url.Action("Search", "Sponsorship")" class="search-form u-m-16px-0">
        <input type="search"
 name="q"
 value="@q"
 placeholder="Search listings…"
 class="form-control u-maxw-340px" />
        <button type="submit" class="btn btn-primary btn-cta">Find my listing</button>
    </form>


    <hr />
    @await Html.PartialAsync("_SponsorshipPackages", Model.PricingSummaries)

    @if (Model.RecentPaid != null)
    {
        <div class="u-m-18px-0">
            @await Html.PartialAsync("_RecentPaid", Model.RecentPaid)
        </div>
    }
}
