@model DirectoryManager.Web.Models.Sponsorship.SponsorshipIndexVm
@inject DirectoryManager.Web.Services.Interfaces.IUrlResolutionService UrlResolver
@* Sponsorship search result rows + numbered pager (used by /sponsorship/search). *@
@{
    var q = (Model.Query ?? string.Empty).Trim();

    // Numbered pages around the current one: 1 … 4 5 [6] 7 8 … 20
    var pages = new List<int>();
    for (int i = 1; i <= Model.TotalPages; i++)
    {
        if (i == 1 || i == Model.TotalPages || Math.Abs(i - Model.Page) <= 2)
        {
            pages.Add(i);
        }
    }
}

<div class="search-results">
    @foreach (var r in Model.Results)
    {
        var meta = r.Status;
        if (!string.IsNullOrWhiteSpace(r.Category)) { meta += $" · {r.Category}"; }
        if (!string.IsNullOrWhiteSpace(r.Subcategory)) { meta += $" » {r.Subcategory}"; }
        meta += $" · listed {r.AgeDays} days";

        <div class="result-row sponsor-search-row u-flex-flexwrap-wrap-items-center-gap-8px-16px-p-12px-0">
            <div class="u-flex-1-1-240px-minw-0">
                <div class="u-fs-105em-fw-600">
                    @* Name links to the listing's profile on this directory, not its own website. *@
                    @if (!string.IsNullOrWhiteSpace(r.DirectoryEntryKey))
                    {
                        <a class="no-app-link" href="@UrlResolver.ResolveToRoot(DirectoryManager.Utilities.Helpers.UrlBuilder.ListingPath(r.DirectoryEntryKey))">@r.Name</a>
                    }
                    else
                    {
                        @r.Name
                    }
                </div>
                <div class="u-opacity-8-fs-9em-mt-2px">@meta</div>

                @if (!r.CanAdvertise && r.Reasons != null && r.Reasons.Any())
                {
                    <ul class="u-m-6px-0-0-18px-opacity-85-fs-9em">
                        @foreach (var reason in r.Reasons)
                        {
                            <li>@reason</li>
                        }
                    </ul>
                }
            </div>

            <form class="u-flex-0-0-auto-m-0" method="post" action="@Url.Action("Select", "Sponsorship")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="directoryEntryId" value="@r.DirectoryEntryId" />
                @* Orange action button that names the listing, so it's clearly clickable and clearly for this row. *@
                <button type="submit" class="btn @(r.CanAdvertise ? "btn-primary btn-cta" : "btn-secondary") sponsor-search-spots-btn">
                    See spots for @r.Name &rarr;
                </button>
            </form>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Search result pages" class="u-m-12px-0-22px-0">
        <ul class="pagination">
            @if (Model.Page > 1)
            {
                <li class="page-item"><a class="page-link" href="@Url.Action("Search", "Sponsorship", new { q, page = Model.Page - 1 })">&larr; Prev</a></li>
            }
            @for (int i = 0; i < pages.Count; i++)
            {
                if (i > 0 && pages[i] - pages[i - 1] > 1)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }

                <li class="page-item @(pages[i] == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Search", "Sponsorship", new { q, page = pages[i] })">@pages[i]</a>
                </li>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <li class="page-item"><a class="page-link" href="@Url.Action("Search", "Sponsorship", new { q, page = Model.Page + 1 })">Next &rarr;</a></li>
            }
        </ul>
    </nav>
}
