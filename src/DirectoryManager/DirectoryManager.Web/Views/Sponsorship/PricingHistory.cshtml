@model DirectoryManager.Web.Models.Sponsorship.PublicPricingViewModel
@using DirectoryManager.Web.Constants
@using DirectoryManager.Data.Enums

@{
    Layout = "_CenteredLayout";
    PageMeta.Title = "Sponsorship Pricing History";
    var chartV = $"{Model.RangeDays}-{DateTime.UtcNow.ToString(DirectoryManager.Common.Constants.StringConstants.CompactDateFormat)}-{(string.IsNullOrEmpty(Model.Placement) ? "all" : Model.Placement)}";
}

@section PageContent {
    <div class="page-header-bar">
        <h1 class="page-title">Sponsorship Pricing History</h1>
        @await Html.PartialAsync("_SiteLogo")
    </div>
    <hr />
    <a class="app-link" href="~/sponsoredlisting/offers">&larr; back to offers &amp; pricing</a>
    <hr />

    <p class="u-opacity-9">
        See what advertisers have actually <strong>paid per day</strong> for each sponsorship placement over the
        last @Model.WindowDays&nbsp;days. Pick a placement &mdash; the main sponsor slot, every category or
        subcategory page, or one specific page &mdash; then adjust the date range. Leave it on
        <em>All placements (compare)</em> to overlay Main, Category and Subcategory.
        Category and subcategory pages can each have their own price, so one page's history can differ from the average.
    </p>

    <form method="get" asp-controller="Sponsorship" asp-action="PricingHistory">
        <div class="form-row">
            <div class="form-group col-md-6">
                <label for="placement">Placement</label>
                <select id="placement" name="placement" class="form-control" asp-items="Model.PlacementOptions"></select>
            </div>
            <div class="form-group col-md-4">
                <label for="rangeDays">Time Range</label>
                <select id="rangeDays" name="rangeDays" class="form-control" asp-items="Model.RangeOptions"></select>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Update chart</button>
    </form>

    <p class="u-opacity-85 u-mt-8px">
        Showing @Model.StartDate.ToString(DirectoryManager.Common.Constants.StringConstants.FriendlyDateFormat) &ndash; @Model.EndDate.ToString(DirectoryManager.Common.Constants.StringConstants.FriendlyDateFormat)
        @if (!string.IsNullOrEmpty(Model.PlacementLabel))
        {
            <text>&nbsp;·&nbsp; <strong>@Model.PlacementLabel</strong></text>
        }
        <span class="u-opacity-8"> — the public view can look back at most @Model.WindowDays&nbsp;days.</span>
    </p>

    <div class="table-wrapper u-mt-10px">
        <img class="u-w-100pct"
             src="@Url.Action("PricingHistoryChart", "Sponsorship", new {
                 rangeDays = Model.RangeDays,
                 placement = Model.Placement,
                 v = chartV })"
             alt="Sponsorship pricing history over the selected date range" />
    </div>
}
