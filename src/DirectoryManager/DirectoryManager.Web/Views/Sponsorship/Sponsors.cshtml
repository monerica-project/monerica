@model DirectoryManager.Web.Models.Sponsorship.SponsorsPageVm
@using DirectoryManager.Data.Enums
@inject DirectoryManager.Web.Services.Interfaces.ICacheService cacheHelper
@{
    var siteName = await cacheHelper.GetSnippetAsync(SiteConfigSetting.SiteName);
    ViewData[DirectoryManager.Web.Constants.StringConstants.TitleHeader] = "Sponsors";
    Layout = "_CenteredLayout";

    var sponsors = Model.CurrentSponsors ?? new List<DirectoryManager.Web.Models.Sponsorship.CurrentSponsorItemVm>();
}

@section PageContent {

    <style>
        .sponsor-expiring-soon {
            display: block;
            margin-top: 2px;
            font-size: 0.78em;
            font-weight: 700;
            color: #d9534f;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
    </style>

    <div class="page-header-bar">
        <h1 class="page-title">Sponsors</h1>
        @await Html.PartialAsync("_SiteLogo")
    </div>

    @await Html.PartialAsync("_BackToHome")

    <p class="u-m-6px-0-4px-0">
        The businesses currently sponsoring @siteName, and when each sponsorship term expires.
        Longest remaining term is listed first; the soonest to expire is at the bottom.
    </p>
    <p class="u-m-0-0-16px-0-opacity-85">
        <strong>@sponsors.Count</strong> active sponsorship@(sponsors.Count == 1 ? string.Empty : "s")
        &middot; current time:
        <strong>@Model.CurrentUtc.ToString(DirectoryManager.Common.Constants.StringConstants.DateTimeFormat4) (UTC)</strong>
    </p>

    @if (sponsors.Any())
    {
        <div class="table-wrapper">
            <table class="table u-w-100pct">
                <thead>
                    <tr>
                        <th>Sponsor</th>
                        <th>Placement</th>
                        <th class="u-text-right">Start (UTC)</th>
                        <th class="u-text-right">Expires (UTC)</th>
                        <th class="u-text-right">Renew</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in sponsors)
                    {
                        var isMain = item.SponsorshipTypeEnum == SponsorshipType.MainSponsor;
                        <tr class="@(isMain ? "sponsor-row-main" : "")">
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.ListingUrl))
                                {
                                    <a href="@item.ListingUrl" target="_blank" rel="noopener">@item.ListingName</a>
                                }
                                else
                                {
                                    @item.ListingName
                                }
                            </td>
                            <td>
                                @if (isMain)
                                {
                                    <strong class="sponsor-type-main">&#9733; @item.SponsorshipType</strong>
                                }
                                else
                                {
                                    @item.SponsorshipType
                                }
                                @if (!string.IsNullOrWhiteSpace(item.ScopeLabel))
                                {
                                    <div class="u-fs-8em u-opacity-85">@item.ScopeLabel</div>
                                }
                            </td>
                            <td class="u-text-right">@item.StartUtc.ToString(DirectoryManager.Common.Constants.StringConstants.DateFormat)</td>
                            <td class="u-text-right">
                                @item.ExpiresUtc.ToString(DirectoryManager.Common.Constants.StringConstants.DateFormat)
                                @if ((item.ExpiresUtc - Model.CurrentUtc).TotalDays < 7)
                                {
                                    <span class="sponsor-expiring-soon">Expiring Soon</span>
                                }
                            </td>
                            <td class="u-text-right">
                                @if (!string.IsNullOrWhiteSpace(item.RenewUrl))
                                {
                                    <a class="btn btn-primary btn-sm" href="@item.RenewUrl">Renew</a>
                                }
                                else
                                {
                                    <span class="u-opacity-6">&mdash;</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="u-opacity-85">No active sponsors right now.</p>
    }

    <p class="u-m-26px-0-8px-0">
        Want a spot? <a href="~/sponsorship">See sponsorship options and prices &rarr;</a>
    </p>
}
