@using DirectoryManager.Data.Enums
@using DirectoryManager.Data.Models
@using DirectoryManager.Data.Repositories.Interfaces
@using DirectoryManager.Utilities.Helpers
@using DirectoryManager.Web.Constants
@using DirectoryManager.Web.Helpers
@using DirectoryManager.Web.Models
@model DirectoryManager.Web.Models.CategoryEntriesViewModel
@inject DirectoryManager.Data.Repositories.Interfaces.IDirectoryEntryAdditionalSubcategoryRepository additionalSubcategoryRepo
@inject DirectoryManager.Web.Services.Interfaces.ICacheService cacheHelper
@inject DirectoryManager.Data.Repositories.Interfaces.ISponsoredListingRepository sponsoredListingRepository
@inject ICategoryRepository categoryRepo
@inject ISubcategoryRepository subCatRepo
@inject DirectoryManager.Web.Services.Interfaces.IUrlResolutionService UrlResolver
@inject DirectoryManager.Data.Repositories.Interfaces.IDirectoryEntryReviewRepository directoryEntryReviewRepository

@{
    PageMeta.CurrentCategoryKey = Model.CategoryKey;
    PageMeta.CurrentSubCategoryKey = null;
}

@{
  Layout = "_LayoutWithNav";
  var siteNameForSeo = await cacheHelper.GetSnippetAsync(SiteConfigSetting.SiteName);
  var currencyNameForSeo = await cacheHelper.GetSnippetAsync(SiteConfigSetting.DirectoryCurrencyName);
  PageMeta.Title = Model.CategoryName;

  // Keyword first, at most 60 characters: "Exchanges for Monero (XMR) | Monerica".
  // A hand-written SeoTitle (Categories.SeoTitle) wins; page 2+ gets the same "(Page N)" suffix.
  PageMeta.SeoTitle = !string.IsNullOrWhiteSpace(Model.SeoTitle)
      ? SeoTitleBuilder.WithPage(Model.SeoTitle, Model.CurrentPage)
      : SeoTitleBuilder.ForCategory(Model.CategoryName, currencyNameForSeo, siteNameForSeo, Model.CurrentPage);

  // H1: the hand-written heading, else the generated title without the site name
  // ("Exchanges for Monero (XMR)"), so the heading names the subject, not just "Exchanges".
  var pageHeading = !string.IsNullOrWhiteSpace(Model.Heading)
      ? Model.Heading
      : SeoTitleBuilder.ForCategory(Model.CategoryName, currencyNameForSeo, null);
  var baseDescription = string.IsNullOrWhiteSpace(Model.MetaDescription)
      ? SeoDescriptionBuilder.ForListPage(Model.CategoryName, Model.PagedEntries?.TotalCount ?? 0, currencyNameForSeo, siteNameForSeo)
      : Model.MetaDescription;
  PageMeta.MetaDescription = SeoDescriptionBuilder.Shorten(
      Model.CurrentPage > 1 ? $"Page {Model.CurrentPage}. {baseDescription}" : baseDescription);
}
 
@{
    var domain = await cacheHelper.GetSnippetAsync(SiteConfigSetting.CanonicalDomain);

    // Build your breadcrumb list dynamically based on page context
    var breadcrumbs = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Position = 1, Name = "Home", Url = UrlHelper.MakeFullUrl(domain,"/") },
        new BreadcrumbItem { Position = 2, Name = Model.CategoryName, Url = UrlHelper.MakeFullUrl(domain,$"/{@Model.CategoryKey}") }
    };
    PageMeta.StructuredData.Add(JsonLdBuilder.BreadcrumbList(breadcrumbs));

    // ItemList of the listings on this page (positions continue across pages).
    var itemListStart = ((Math.Max(1, Model.CurrentPage) - 1) * Math.Max(1, Model.PageSize)) + 1;
    PageMeta.StructuredData.Add(JsonLdBuilder.ItemList(
        Model.CategoryName,
        PageMeta.CanonicalUrl,
        (Model.PagedEntries?.Items ?? Enumerable.Empty<DirectoryManager.DisplayFormatting.Models.DirectoryEntryViewModel>())
            .Select(e => (e.Name, UrlHelper.MakeFullUrl(domain, UrlBuilder.ListingPath(e.DirectoryEntryKey)))),
        itemListStart));
}
 
 @section PageContent {

 
<h1>@pageHeading</h1>

<hr />

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a class="no-app-link" href="@UrlResolver.ResolveToRoot("~/")">Home</a>
        </li>
        <li class="breadcrumb-item" aria-current="page">
            @Model.CategoryName
        </li>
    </ol>
</nav>

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    // Same rule as subcategory PageDetails: block-level HTML goes in a <div>, plain text in a <p>.
    var descriptionHtml = ContentSanitizer.Sanitize(Model.Description);
    if (descriptionHtml.TrimStart().StartsWith("<p", StringComparison.OrdinalIgnoreCase)
        || descriptionHtml.TrimStart().StartsWith("<ul", StringComparison.OrdinalIgnoreCase))
    {
        <div class="page-intro">@Html.Raw(descriptionHtml)</div>
    }
    else
    {
        <p><span>@Html.Raw(descriptionHtml)</span></p>
    }
}

@if (!string.IsNullOrWhiteSpace(Model.Note))
{
    <p><i>Note: @Html.Raw(ContentSanitizer.Sanitize(Model.Note))</i></p>
}

    @{
        var link2Name = await cacheHelper.GetSnippetAsync(SiteConfigSetting.Link2Name);
        var link3Name = await cacheHelper.GetSnippetAsync(SiteConfigSetting.Link3Name);

        var categorySponsors = await sponsoredListingRepository.GetActiveSponsorsByTypeAsync(SponsorshipType.CategorySponsor);

        // find the sponsor for this category (if any)
        // The sponsor of this category is the one that bought THIS category. A listing can be here
        // through an additional subcategory, and is then shown under that subcategory's name and links.
        var catSponsor = categorySponsors
            .FirstOrDefault(s => (s.CategoryId ?? s.DirectoryEntry?.SubCategory?.CategoryId) == Model.CategoryId);
        var catSponsorEntry = catSponsor?.DirectoryEntry;
        if (catSponsorEntry != null && catSponsor!.SubCategoryId is int catSponsorSubId && catSponsorSubId != catSponsorEntry.SubCategoryId)
        {
            var altHere = (await additionalSubcategoryRepo.GetByDirectoryEntryIdAsync(catSponsorEntry.DirectoryEntryId))
                .FirstOrDefault(x => x.SubCategoryId == catSponsorSubId);
            if (altHere != null)
            {
                catSponsorEntry = altHere.ApplyTo(catSponsorEntry);
            }
        }

        var catSponsorCount = categorySponsors.Count();

        // ✅ Pull rating summary (AvgRating + ReviewCount) for the sponsor entry
        DirectoryManager.Data.Models.TransferModels.RatingSummaryDto? sponsorRating = null;

        if (catSponsorEntry != null)
        {
            var sponsorId = catSponsorEntry.DirectoryEntryId;

            var ratingDict = await directoryEntryReviewRepository.GetRatingSummariesAsync(new[] { sponsorId });

            if (ratingDict.TryGetValue(sponsorId, out var dto))
            {
                sponsorRating = dto;
            }
        }

        var categorySponsorModel = new DirectoryManager.Web.Models.CategorySponsorModel()
        {
            CategoryId = Model.CategoryId,
            TotalActiveCategoryListings = catSponsorCount,

            DirectoryEntry = (catSponsor != null && catSponsorEntry != null)
                ? new DirectoryManager.DisplayFormatting.Models.DirectoryEntryViewModel()
                {
                    CountryCode = catSponsorEntry.CountryCode,

                    CreateDate = catSponsorEntry.CreateDate,
                    UpdateDate = catSponsorEntry.UpdateDate,
                    DateOption = DirectoryManager.DisplayFormatting.Enums.DateDisplayOption.NotDisplayed,

                    Link = catSponsorEntry.Link,
                    LinkA = catSponsorEntry.LinkA,
                    Link2 = catSponsorEntry.Link2,
                    Link2A = catSponsorEntry.Link2A,
                    Link3 = catSponsorEntry.Link3,
                    Link3A = catSponsorEntry.Link3A,

                    Name = catSponsorEntry.Name,
                    Description = catSponsorEntry.Description,
                    DirectoryEntryId = catSponsorEntry.DirectoryEntryId,
                    DirectoryStatus = catSponsorEntry.DirectoryStatus,
                    StreetAddress = catSponsorEntry.StreetAddress,
                    City = catSponsorEntry.City,
                    StateRegion = catSponsorEntry.StateRegion,
                    PostalCode = catSponsorEntry.PostalCode,
                    Note = catSponsorEntry.Note,
                    Processor = catSponsorEntry.Processor,

                    SubCategoryId = catSponsorEntry.SubCategoryId,
                    SubCategory = catSponsorEntry.SubCategory,

                    DirectoryEntryKey = catSponsorEntry.DirectoryEntryKey,

                    // ✅ needed for (count) link to #reviews if your helper uses ItemPath
                    ItemPath = UrlBuilder.ListingPath(catSponsorEntry.DirectoryEntryKey),

                    IsSponsored = true,
                    DisplayAsSponsoredItem = false,

                    Link2Name = link2Name,
                    Link3Name = link3Name,

                    // IMPORTANT: you want listing page links here (your existing choice)
                    LinkType = DirectoryManager.DisplayFormatting.Enums.LinkType.ListingPage,

                    // ✅ Ratings mapped from RatingSummaryDto
                    AverageRating = (sponsorRating != null && sponsorRating.ReviewCount > 0)
                        ? sponsorRating.AvgRating
                        : null,

                    ReviewCount = (sponsorRating != null && sponsorRating.ReviewCount > 0)
                        ? sponsorRating.ReviewCount
                        : null
                }
                : null
        };
    }
    @await Html.PartialAsync("_SponsoredListingCategoryPartial", categorySponsorModel)
 
    @{
        var grouped = Model.PagedEntries.Items
            .GroupBy(e => e.SubCategory?.Name ?? "Uncategorized")
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase);
    }

    @{
        // Featured picks for this page: the category's own pick, and each subcategory section's pick.
        var categoryPick = (await categoryRepo.GetByIdAsync(Model.CategoryId))?.FeaturedDirectoryEntryId;
        var subcategoryPicks = (await subCatRepo.GetAllActiveSubCategoriesAsync())
            .Where(s => s.FeaturedDirectoryEntryId.HasValue)
            .ToDictionary(s => s.SubCategoryId, s => s.FeaturedDirectoryEntryId!.Value);
    }

    @foreach (var group in grouped)
    {
        <h2 class="subcat-heading">@group.Key</h2>
        <ul class="blank_list_item">
            @foreach (var entryVm in group)
            {
                entryVm.LinkType = DirectoryManager.DisplayFormatting.Enums.LinkType.ListingPage;
                entryVm.IsFeaturedInThisList = entryVm.DirectoryEntryId == categoryPick
                    || (entryVm.SubCategoryId is int sid && subcategoryPicks.TryGetValue(sid, out var pick) && pick == entryVm.DirectoryEntryId);

                if (Model.SponsoredDirectoryEntryIds.Contains(entryVm.DirectoryEntryId) ||
                    Model.SponsoredSubcategoryRows.Contains((entryVm.DirectoryEntryId, entryVm.SubCategoryId ?? 0)))
                {
                    entryVm.IsSponsored = true;
                    entryVm.DisplayAsSponsoredItem = true;
                    entryVm.LinkType = DirectoryManager.DisplayFormatting.Enums.LinkType.ListingPage;
                }

                @await Html.PartialAsync("_DirectoryEntryPartial", entryVm)
            }
        </ul>
    }

    @{
        var categoryKey = Model.CategoryKey;
        int totalPages = (int)Math.Ceiling(Model.PagedEntries.TotalCount / (double)Model.PageSize);
        int currentPage = Model.CurrentPage < 1 ? 1 : Model.CurrentPage;
    }

    @if (totalPages > 1)
    {
        <nav aria-label="Pagination">
            <ul class="pagination">
                @for (int p = 1; p <= totalPages; p++)
                {
                    // Build the raw path: page 1 is "/{categoryKey}", subsequent pages add "/page/{p}"
                    string rawPath = $"/{categoryKey}" + (p > 1 ? $"/page/{p}" : "");

                    // Page 1 → canonical root; pages 2+ → app domain
                    string href = p == 1
                        ? UrlResolver.BaseUrl.TrimEnd('/') + rawPath
                        : UrlResolver.ResolveToApp(rawPath);

                    var isActive = (p == currentPage);

                    <li class="page-item @(isActive ? "active" : "")">
                        @if (isActive)
                        {
                            <span class="page-link" aria-current="page">@p</span>
                        }
                        else
                        {
                            <a class="page-link no-app-link" href="@href">@p</a>
                        }
                    </li>
                }
            </ul>
        </nav>
    }

<hr />

@await Html.PartialAsync("_SponsoredListingPartial")

}