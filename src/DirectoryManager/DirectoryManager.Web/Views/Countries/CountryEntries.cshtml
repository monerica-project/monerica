@using DirectoryManager.Utilities
@inject DirectoryManager.Web.Services.Interfaces.ICacheService seoCache
@model DirectoryManager.Web.Models.CountryEntriesViewModel
@inject DirectoryManager.Web.Services.Interfaces.IUrlResolutionService UrlResolver

@{
    Layout = "_LayoutWithNav";
    int totalPages = (int)Math.Ceiling(Model.PagedEntries.TotalCount / (double)Model.PageSize);
    string pageSuffix = Model.CurrentPage > 1 ? $" – Page {Model.CurrentPage}" : "";
    PageMeta.Title = $"Country: {Model.CountryName}{pageSuffix}";
    var seoSite = await seoCache.GetSnippetAsync(DirectoryManager.Data.Enums.SiteConfigSetting.SiteName);
    var seoCurrency = await seoCache.GetSnippetAsync(DirectoryManager.Data.Enums.SiteConfigSetting.DirectoryCurrencyName);
    var seoAbout = string.IsNullOrWhiteSpace(seoCurrency) ? string.Empty : $" that accept or relate to {seoCurrency}";
    var seoListings = string.IsNullOrWhiteSpace(seoCurrency) ? "Listings" : $"{seoCurrency} Listings";
    PageMeta.SeoTitle = DirectoryManager.Web.Helpers.SeoTitleBuilder.ForSubject(Model.CountryName, seoListings, seoSite, Model.CurrentPage);
    PageMeta.MetaDescription = DirectoryManager.Web.Helpers.SeoDescriptionBuilder.Shorten($"{(Model.CurrentPage > 1 ? $"Page {Model.CurrentPage}. " : string.Empty)}{Model.PagedEntries.TotalCount} businesses and services in {Model.CountryName}{seoAbout}, listed on {seoSite} with KYC policies, ratings and reviews.");
}

@section PageContent {
    <div class="page-header-bar">
        <h1 class="page-title">@Model.CountryName</h1>
        @await Html.PartialAsync("_SiteLogo")
    </div>
  
    <hr />
    @await Html.PartialAsync("_BackToHome")
    <hr />

    <a class="no-app-link" href="@(UrlResolver.ResolveToRoot("/countries"))">All Countries</a>
    <br />

    @if (!Model.PagedEntries.Items.Any())
    {
        <p>No listings found for this country.</p>
    }
    else
    {
        <ul class="blank_list_item">
            @foreach (var entry in Model.PagedEntries.Items)
            {
                entry.LinkType = DirectoryManager.DisplayFormatting.Enums.LinkType.ListingPage;
                @await Html.PartialAsync("_DirectoryEntryPartial", entry)
            }
        </ul>

        <nav aria-label="Pagination">
            <ul class="pagination">
                @for (int p = 1; p <= totalPages; p++)
                {
                    string rawPath = $"/countries/{Model.CountryKey}" + (p > 1 ? $"/page/{p}" : "");
                    string href = p == 1
                        ? UrlResolver.BaseUrl.TrimEnd('/') + rawPath
                        : UrlResolver.ResolveToApp(rawPath);

                    string linkClass = "no-app-link";
                    string activeClass = p == Model.CurrentPage ? "active" : "";

                    <li class="page-item @activeClass">
                        <a class="page-link @linkClass" href="@href">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }

    <hr />
    @await Html.PartialAsync("_SponsoredListingPartial")
}
