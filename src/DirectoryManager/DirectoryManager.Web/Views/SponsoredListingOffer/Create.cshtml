@model DirectoryManager.Data.Models.SponsoredListings.SponsoredListingOffer
@using DirectoryManager.Data.Models
@using DirectoryManager.Web.Constants;
@{
    PageMeta.Title = "Create Sponsored Listing Offer";
    SelectList sponsorshipTypeSelectList = new SelectList(Enum.GetValues(typeof(DirectoryManager.Data.Enums.SponsorshipType)));
    var orderedSubCategories = new[]
    {
        new { SubCategoryId = (int?)null, DisplayName = "(none)" }
    }
    .Concat(
        ((IEnumerable<Subcategory>)ViewBag.SubCategories)
        .OrderBy(sc => sc.Category.Name)
        .ThenBy(sc => sc.Name)
        .Select(sc => new
        {
            SubCategoryId = (int?)sc.SubCategoryId,
            DisplayName = $"{sc.Category.Name} > {sc.Name}"
        })
    );
}

@{
    Layout = "_CenteredLayout";
    var orderedCategories = new[] { new { CategoryId = (int?)null, DisplayName = "(none)" } }
        .Concat(((IEnumerable<Category>)ViewBag.Categories)
            .Where(c => c.IsEnabled || c.CategoryId == Model?.CategoryId)
            .OrderBy(c => c.Name)
            .Select(c => new { CategoryId = (int?)c.CategoryId, DisplayName = c.Name }));
}

@section PageContent {
<h1>@PageMeta.Title</h1>

@await Html.PartialAsync("_AdminMenu")

<a href="~/sponsoredlistingoffer/index">&lt; back</a>
<hr />
<form asp-action="Create">
    <div class="form-group">
        <label asp-for="SponsorshipType" class="control-label"></label>
        @Html.DropDownListFor(model => model.SponsorshipType, sponsorshipTypeSelectList, new { @class = "form-control" })
        <span asp-validation-for="SponsorshipType" class="text-danger"></span>
    </div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <p class="u-opacity-9">
        Which page this price is for. <strong>Main sponsor</strong>: leave both empty.
        <strong>Category sponsor</strong>: pick a category for that category page's own price, or leave both empty for the
        standard price every other category page uses. <strong>Subcategory sponsor</strong>: pick a subcategory, or leave
        both empty for the standard subcategory price.
    </p>
    <div class="form-group">
        <label asp-for="CategoryId">Category page (category sponsor only)</label>
        <select asp-for="CategoryId" asp-items="@(new SelectList(orderedCategories, "CategoryId", "DisplayName"))"></select>
    </div>
    <div class="form-group">
        <label asp-for="SubcategoryId">Subcategory page (subcategory sponsor only)</label>
        <select asp-for="SubcategoryId" asp-items="@(new SelectList(orderedSubCategories, "SubCategoryId", "DisplayName"))"></select>
    </div>
    <div class="form-group">
        <label asp-for="Description" class="control-label"></label>
        <textarea cols="100" asp-for="Description"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Days" class="control-label"></label>
        <input asp-for="Days" class="form-control" />
        <span asp-validation-for="Days" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Price (@DirectoryManager.Data.Enums.Currency.USD.ToString())</label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
        <div class="form-group">
            <label asp-for="IsEnabled" class="control-label"></label>
            <input asp-for="IsEnabled" />
        </div>
    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-primary" />
    </div>
</form>
}