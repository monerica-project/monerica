@model IEnumerable<DirectoryManager.Data.Models.SponsoredListings.SponsoredListingOffer>
@using DirectoryManager.Web.Constants;

@{
    PageMeta.Title = "Sponsored Listing Offers";
    Layout = "_CenteredLayout";
}


@section PageContent {


<h1>@PageMeta.Title</h1>

@await Html.PartialAsync("_AdminMenu")

<a asp-action="Create">Create New</a>
<hr />

@await Html.PartialAsync("_SponsorshipOptions",  Model.Where(x => x.SponsorshipType == DirectoryManager.Data.Enums.SponsorshipType.MainSponsor)) 

@await Html.PartialAsync("_SponsorshipOptions", Model.Where(x => x.SponsorshipType == DirectoryManager.Data.Enums.SponsorshipType.CategorySponsor))

@await Html.PartialAsync("_SponsorshipOptions", Model.Where(x => x.SponsorshipType == DirectoryManager.Data.Enums.SponsorshipType.SubcategorySponsor)) 

}
