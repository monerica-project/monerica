@using DirectoryManager.Web.Constants
@using DirectoryManager.Data.Enums
@inject DirectoryManager.Web.Services.Interfaces.ICacheService _cacheHelper
@inject DirectoryManager.Web.Services.Interfaces.IUrlResolutionService Urls
@inject DirectoryManager.Web.Services.Interfaces.IFeaturedListingBuilder FeaturedBuilder
@inject DirectoryManager.Data.Repositories.Interfaces.ISubcategoryRepository SubcategoryRepo
@inject DirectoryManager.Web.Services.Interfaces.ISponsorableScopeService SponsorableScopes
@model DirectoryManager.Web.Models.SubcategorySponsorModel

@{
    var link2Name = await _cacheHelper.GetSnippetAsync(SiteConfigSetting.Link2Name);
    var link3Name = await _cacheHelper.GetSnippetAsync(SiteConfigSetting.Link3Name);

    var vm = Model?.DirectoryEntry; // DisplayFormatting.Models.DirectoryEntryViewModel

    // Only offer "Advertise here" when at least one listing in this subcategory could actually
    // buy the slot (same rule as checkout: Verified + listed long enough, or a current sponsor).
    bool canAdvertise = Model != null && !Model.SponsorshipDisabled
        && Model.TotalActiveSubCategoryListings >= DirectoryManager.Common.Constants.IntegerConstants.MinRequiredSubcategories
        && await SponsorableScopes.SubcategoryHasBuyerAsync(Model.SubCategoryId);

    // Unpaid admin-picked "Featured" listing — only when no paid subcategory sponsor is showing.
    DirectoryManager.DisplayFormatting.Models.DirectoryEntryViewModel? featured = null;
    if (Model != null && vm == null)
    {
        var sub = await SubcategoryRepo.GetByIdAsync(Model.SubCategoryId);
        featured = await FeaturedBuilder.BuildAsync(sub?.FeaturedDirectoryEntryId, Model.SubCategoryId);
    }
}

@if (Model != null && vm != null)
{
    // Ensure link labels exist
    vm.Link2Name = string.IsNullOrWhiteSpace(vm.Link2Name) ? link2Name : vm.Link2Name;
    vm.Link3Name = string.IsNullOrWhiteSpace(vm.Link3Name) ? link3Name : vm.Link3Name;

    // Ensure sponsor behavior
    vm.IsSponsored = true;
    vm.DisplayAsSponsoredItem = false;
    vm.IsSubCategorySponsor = true;

    // Tell DisplayMarkUpHelper (via _DirectoryEntryPartial) to render:
    // Name | Tor | I2P Flag
    vm.SponsorInlineHeader = true;

    // Not strictly required in this mode, but safe
    vm.SkipLinksBlock = true;

    // Quiet "See profile" link on its own line under the description.
    vm.ShowProfileLink = true;

    <div class="sponsored-section">
        <p><b>Sponsored</b></p>
        <ul class="blank_list_item">
            @await Html.PartialAsync("_DirectoryEntryPartial", vm)
        </ul>
    </div>
}
else if (featured != null)
{
    <div class="sponsored-section featured-section">
        <div class="featured-head">
            <span class="featured-label">Featured</span>
            @if (canAdvertise)
            {
                @* Smaller CTA while a featured pick fills the spot; buying the slot replaces it. *@
                <form method="get" action="@Urls.ResolveToApp("/sponsoredlisting/selectlisting")" class="advertise-here-form">
                    <input type="hidden" name="subCategoryId" value="@Model!.SubCategoryId" />
                    <input type="hidden" name="sponsorshipType" value="@SponsorshipType.SubcategorySponsor" />
                    <button type="submit" class="advertise-here-btn advertise-here-btn--small">Advertise here</button>
                </form>
            }
        </div>
        <ul class="blank_list_item">
            @await Html.PartialAsync("_DirectoryEntryPartial", featured)
        </ul>
        @if (!string.IsNullOrWhiteSpace(featured.LinkA))
        {
            <p class="featured-disclosure">Affiliate link: we may earn a commission.</p>
        }
    </div>
}
else if (canAdvertise)
{
    <p class="sub-category-sponsored-listing">
        @* Submit button (not a link) so crawlers/prefetch don't hit it and skew analytics — lands on the same Select Listing page. *@
        <form method="get" action="@Urls.ResolveToApp("/sponsoredlisting/selectlisting")" class="advertise-here-form">
            <input type="hidden" name="subCategoryId" value="@Model.SubCategoryId" />
            <input type="hidden" name="sponsorshipType" value="@SponsorshipType.SubcategorySponsor" />
            <button type="submit" class="advertise-here-btn">Advertise here</button>
        </form>
    </p>
}
