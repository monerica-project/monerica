@inject DirectoryManager.Web.Services.Interfaces.ICacheService cacheHelper
@using DirectoryManager.Data.Enums
@using DirectoryManager.Web.Constants
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    @{
        // <title>: an explicit SeoTitle wins; otherwise the page Title plus " | SiteName" when it
        // still fits in 60 characters (SeoTitleBuilder). Social tags (og:*, twitter:*) are built for
        // every page from the same values; raw MetaContent (the homepage meta-tags snippet) only
        // supplies fallbacks, and its copies of generated tags are dropped so none appear twice.
        var layoutSiteName = await cacheHelper.GetSnippetAsync(SiteConfigSetting.SiteName);
        var documentTitle = !string.IsNullOrWhiteSpace(PageMeta.SeoTitle)
            ? PageMeta.SeoTitle
            : DirectoryManager.Web.Helpers.SeoTitleBuilder.WithBrand(PageMeta.Title, layoutSiteName);
        var socialImage = PageMeta.ImageUrl;
        if (string.IsNullOrWhiteSpace(socialImage)
            && !DirectoryManager.Web.Helpers.SocialMetaTags.Parse(PageMeta.MetaContent).ContainsKey("og:image"))
        {
            socialImage = await cacheHelper.GetSnippetAsync(SiteConfigSetting.SiteLogoUrl);
        }

        var socialTags = DirectoryManager.Web.Helpers.SocialMetaTags.Build(
            documentTitle,
            PageMeta.MetaDescription,
            PageMeta.CanonicalUrl,
            PageMeta.OgType,
            layoutSiteName,
            socialImage,
            PageMeta.MetaContent);
        var remainingMetaContent = DirectoryManager.Web.Helpers.SocialMetaTags.RemoveGenerated(PageMeta.MetaContent);
    }
    <title>@documentTitle</title>
    @foreach (var tag in socialTags)
    {
        if (tag.Attribute == "property")
        {
            <meta property="@tag.Key" content="@tag.Value" />
        }
        else
        {
            <meta name="@tag.Key" content="@tag.Value" />
        }
    }
    @if (!string.IsNullOrWhiteSpace(remainingMetaContent))
    {
        @Html.Raw(remainingMetaContent)
    }
    @{
        var torUrl = await cacheHelper.GetSnippetAsync(SiteConfigSetting.FullRootTorUrl);
        string? onionLocation = null;
        if (!string.IsNullOrWhiteSpace(torUrl))
        {
            var currentPath = Context.Request.Path + Context.Request.QueryString;
            onionLocation = DirectoryManager.Web.Helpers.UrlHelper.NormalizeUrl(torUrl) + currentPath;
        }
    }
    @if (onionLocation != null)
    {
        @* The preceding og: tags (from raw MetaContent) don't end with a newline, so force one
           here to keep this tag on its own line. The value stays Razor-encoded (no Html.Raw on it). *@
        @Html.Raw("\n    ")<meta http-equiv="onion-location" content="@onionLocation" />
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <meta name="referrer" content="no-referrer">
    @if (!string.IsNullOrWhiteSpace(PageMeta.CanonicalUrl))
    {
        <link rel="canonical" href="@PageMeta.CanonicalUrl" />
    }
    @if (PageMeta.IsIndexable == false)
    {
        <meta name="robots" content="noindex" />
    }
    @foreach (var jsonLd in PageMeta.StructuredData)
    {
        @* Serialized by JsonLdBuilder (System.Text.Json escapes <, > and &), so it is script-safe.
           Written raw: the script tag helper would otherwise encode the "+" in the type attribute. *@
        @Html.Raw("<script type=\"application/ld+json\">" + jsonLd + "</script>")
    }
    @Html.Raw(await cacheHelper.GetSnippetAsync(SiteConfigSetting.HeaderHtml))
</head>
<body>
    @Html.Raw(await cacheHelper.GetSnippetAsync(SiteConfigSetting.TopBannerHtml))
    @RenderSection("ChromeBeforeMain", required: false)
    @RenderBody()
    @RenderSection("ChromeAfterMain", required: false)
    <footer class="site-footer">
        <nav class="footer-nav">
            @Html.Raw(await cacheHelper.GetSnippetAsync(SiteConfigSetting.FooterHtml))
        </nav>
        <div class="footer-network u-mt-05rem">
            <a href="/network">@(await cacheHelper.GetSnippetAsync(DirectoryManager.Data.Enums.SiteConfigSetting.SiteName)) Network</a>
        </div>
    </footer>
</body>
</html>
