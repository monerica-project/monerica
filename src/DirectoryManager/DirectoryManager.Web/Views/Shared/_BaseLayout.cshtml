@inject DirectoryManager.Web.Services.Interfaces.ICacheService cacheHelper
@using DirectoryManager.Data.Enums
@using DirectoryManager.Web.Constants
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>@PageMeta.Title</title>
    @if (!string.IsNullOrWhiteSpace(PageMeta.MetaDescription))
    {
        <meta name="description" content="@PageMeta.MetaDescription" />
        <meta name="twitter:description" content="@PageMeta.MetaDescription" />
    }
    @if (!string.IsNullOrWhiteSpace(PageMeta.MetaContent))
    {
        @Html.Raw(PageMeta.MetaContent)
    }
    @{
        var torUrl = await cacheHelper.GetSnippetAsync(SiteConfigSetting.FullRootTorUrl);
        string? onionLocation = null;
        if (!string.IsNullOrWhiteSpace(torUrl))
        {
            var currentPath = Context.Request.Path + Context.Request.QueryString;
            onionLocation = DirectoryManager.Web.Helpers.UrlHelper.NormalizeUrl(torUrl) + currentPath;
        }
    }
    @if (onionLocation != null)
    {
        @* The preceding og: tags (from raw MetaContent) don't end with a newline, so force one
           here to keep this tag on its own line. The value stays Razor-encoded (no Html.Raw on it). *@
        @Html.Raw("\n    ")<meta http-equiv="onion-location" content="@onionLocation" />
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <meta name="referrer" content="no-referrer">
    @if (!string.IsNullOrWhiteSpace(PageMeta.CanonicalUrl))
    {
        <link rel="canonical" href="@PageMeta.CanonicalUrl" />
    }
    @if (PageMeta.IsIndexable == false)
    {
        <meta name="robots" content="noindex" />
    }
    @Html.Raw(await cacheHelper.GetSnippetAsync(SiteConfigSetting.HeaderHtml))
</head>
<body>
    @Html.Raw(await cacheHelper.GetSnippetAsync(SiteConfigSetting.TopBannerHtml))
    @RenderSection("ChromeBeforeMain", required: false)
    @RenderBody()
    @RenderSection("ChromeAfterMain", required: false)
    <footer class="site-footer">
        <nav class="footer-nav">
            @Html.Raw(await cacheHelper.GetSnippetAsync(SiteConfigSetting.FooterHtml))
        </nav>
        <div class="footer-network u-mt-05rem">
            <a href="/network">@(await cacheHelper.GetSnippetAsync(DirectoryManager.Data.Enums.SiteConfigSetting.SiteName)) Network</a>
        </div>
    </footer>
</body>
</html>
