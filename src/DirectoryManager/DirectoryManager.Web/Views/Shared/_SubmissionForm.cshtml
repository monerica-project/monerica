@using DirectoryManager.Data.Enums
@using DirectoryManager.Utilities.Helpers
@using DirectoryManager.Web.Constants
@model DirectoryManager.Web.Models.SubmissionRequest
@inject DirectoryManager.Web.Services.Interfaces.ICacheService cacheHelper

<p class="text-muted"><i>Emojis aren't allowed in listings and will be removed automatically.</i></p>

<!-- Hidden fields for Submission and DirectoryEntry Ids -->
@Html.HiddenFor(x => x.SubmissionId)
@Html.HiddenFor(x => x.DirectoryEntryId)

<h3>Required Information</h3>

@if (Model.DirectoryEntryId != null)
{
    <div class="form-group">
        <label asp-for="DirectoryStatus">Directory Status</label>
        <select asp-for="DirectoryStatus" name="DirectoryStatus" class="form-control select-fit">
            @foreach (var status in Enum.GetValues(typeof(DirectoryManager.Data.Enums.DirectoryStatus)))
            {
                if ((DirectoryManager.Data.Enums.DirectoryStatus)status == DirectoryManager.Data.Enums.DirectoryStatus.Unknown)
                {
                    continue;
                }
                <option value="@((int)status)">@status.ToString()</option>
            }
        </select>
    </div>
}

<div class="form-group">
    <label asp-for="SubCategoryId">Subcategory</label>
    <select asp-for="SubCategoryId"
    class="form-control select-fit"
            asp-items="@(new SelectList(ViewBag.SubCategories, "SubcategoryId", "DisplayName"))"
            required></select>
</div>

<div class="form-group">
    <label asp-for="Name">Name</label>
    <input autocomplete="off" asp-for="Name" class="form-control input-width" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Link">Link</label>
    <input autocomplete="off" asp-for="Link" class="form-control input-width" />    
    <span asp-validation-for="Link" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Description">Description</label>
    @* Native maxlength (no JS) gives a hard client-side stop at the same limit the server enforces,
       so nobody discovers the cap only at Preview. Value comes from the server constant so the two
       can never drift. Note: browsers silently truncate pasted text beyond maxlength, so the hint
       below states the limit up front. *@
    <textarea asp-for="Description" class="form-control input-width" required
              maxlength="@DirectoryManager.Web.Models.SubmissionRequest.DescriptionMaxLength"
              aria-describedby="descriptionHint"></textarea>
    <small id="descriptionHint" class="text-muted">Maximum @DirectoryManager.Web.Models.SubmissionRequest.DescriptionMaxLength characters.</small>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<hr />

<h3>Optional Information</h3>

<div class="form-group">
    <label asp-for="Link2">@await cacheHelper.GetSnippetAsync(SiteConfigSetting.Link2Name)</label>
    <input autocomplete="off" asp-for="Link2" class="form-control input-width" />
    <span asp-validation-for="Link2" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Link3">@await cacheHelper.GetSnippetAsync(SiteConfigSetting.Link3Name)</label>
    <input autocomplete="off" asp-for="Link3" class="form-control input-width" />
    <span asp-validation-for="Link3" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="ProofLink">Proof Link</label>
    <input autocomplete="off" asp-for="ProofLink" class="form-control input-width" />
    <small class="form-text text-muted">
        A page <strong>on the site itself</strong> (its own domain or .onion) that shows it accepts Monero —
        e.g. its checkout, payment, or FAQ page. <strong>Do not</strong> submit blockchain-explorer links,
        transaction links, or screenshots on other sites; those are not proof and will be rejected.
        Leave blank if the main link already shows Monero acceptance.
    </small>
    <span asp-validation-for="ProofLink" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="VideoLink">Video Link</label>
    <input autocomplete="off" asp-for="VideoLink" class="form-control input-width" />
    <span asp-validation-for="VideoLink" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="SourceCodeLink">Source Code Link</label>
    <input autocomplete="off" asp-for="SourceCodeLink" class="form-control input-width" placeholder="Optional. Link to the site's source code (e.g. GitHub, Codeberg)" />
    <span asp-validation-for="SourceCodeLink" class="text-danger"></span>
</div>


<div class="form-group">
    <label asp-for="Email">Email</label>
    <input autocomplete="off" asp-for="Email" class="form-control input-width" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Messenger">Messenger</label>
    <input autocomplete="off" asp-for="Messenger" class="form-control input-width" />
    <span asp-validation-for="Messenger" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Social">Social</label>
    <input autocomplete="off" asp-for="Social" class="form-control input-width" />
    <span asp-validation-for="Social" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Processor">Payment Processor</label>
    <select asp-for="Processor"
            class="form-control select-fit"
            asp-items="ViewBag.ProcessorOptions">
    </select>
    <span asp-validation-for="Processor" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Location">City, State/Region</label>
    <input autocomplete="off" asp-for="Location" class="form-control input-width" />
    <span asp-validation-for="Location" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="CountryCode" class="control-label"></label>
    <select asp-for="CountryCode" asp-items="ViewBag.CountryCode" class="form-control select-fit"></select>
    <span asp-validation-for="CountryCode" class="text-danger"></span>
</div>

<div class="form-group">
    <label for="KycPolicy" class="control-label">KYC Policy</label>
    <select class="form-control select-fit" id="KycPolicy" name="KycPolicy">
        <option value="" selected="@(Model.KycPolicy == null)">Not Stated</option>
        @foreach (var kp in Enum.GetValues<KycPolicy>())
        {
            if (kp == KycPolicy.NotStated || kp == KycPolicy.Unknown) { continue; }
            <option value="@((int)kp)" selected="@(Model.KycPolicy == kp)">@EnumHelper.GetDescription(kp)</option>
        }
    </select>
</div>

@* Liquidity fields — primarily for instant-swap exchanges; all optional. *@
<div class="form-group">
    <label for="Liquidity" class="control-label">Liquidity</label>
    <p class="text-muted"><i>Primarily for exchanges. Leave as "Not Applicable" if it doesn't apply.</i></p>
    <select class="form-control select-fit" id="Liquidity" name="Liquidity">
        @foreach (var lq in LiquidityExtensions.Selectable)
        {
            <option value="@((int)lq)" selected="@(Model.Liquidity == lq)">@EnumHelper.GetDescription(lq)</option>
        }
    </select>
</div>

@* Deposit guarantees — up to @DirectoryManager.Web.Constants.IntegerConstants.MaxGuarantees (link + USD amount).
   Optional; each row needs both a link and an amount to count. Collapsed by default (no JS needed). *@
<details class="form-group">
    <summary>Deposit guarantees (optional)</summary>
    <p class="text-muted"><i>Links to deposits that show a liquidity guarantee, so people feel safe exchanging. Up to @DirectoryManager.Web.Constants.IntegerConstants.MaxGuarantees.</i></p>
    @for (int gi = 0; gi < DirectoryManager.Web.Constants.IntegerConstants.MaxGuarantees; gi++)
    {
        var g = Model.Guarantees != null && gi < Model.Guarantees.Count ? Model.Guarantees[gi] : new DirectoryManager.Data.Models.GuaranteeItem();
        <fieldset class="guarantee-group">
            <legend>Guarantee @(gi + 1)</legend>
            <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
                <input autocomplete="off" name="Guarantees[@gi].Link" value="@g.Link" class="form-control" style="flex:3 1 240px;" placeholder="Proof link, e.g. https://bitcointalk.org/" />
                <input autocomplete="off" name="Guarantees[@gi].Amount" value="@(g.Amount > 0 ? g.Amount.Value.ToString("0.############", System.Globalization.CultureInfo.InvariantCulture) : string.Empty)" type="number" min="0" step="any" class="form-control" style="flex:1 1 120px;" placeholder="Amount, e.g. 30000" />
                <select name="Guarantees[@gi].Currency" class="form-control" style="flex:0 1 90px;">
                    <option value="2" selected="@(g.Currency == DirectoryManager.Data.Enums.Currency.USD)">USD</option>
                    <option value="3" selected="@(g.Currency == DirectoryManager.Data.Enums.Currency.BTC)">BTC</option>
                    <option value="1" selected="@(g.Currency == DirectoryManager.Data.Enums.Currency.XMR)">XMR</option>
                </select>
            </div>
        </fieldset>
    }
</details>

<div class="form-group">
    <label asp-for="Note">Note</label>
    <textarea asp-for="Note" class="form-control input-width"></textarea>
    <span asp-validation-for="Note" class="text-danger"></span>
</div>

<div class="form-group">
    <label>Founded Date (YYYY MM DD)</label>

    <div class="u-flex-gap-8px-items-center-flexwrap-wrap">
        <input asp-for="FoundedYear"
 class="form-control u-flex-0-0-auto u-minw-0 u-w-110px"
 autocomplete="off"
 inputmode="numeric"
 pattern="[0-9]*"
 maxlength="4"
 placeholder="YYYY" />

        <input asp-for="FoundedMonth"
 class="form-control u-flex-0-0-auto u-minw-0 u-w-90px"
 autocomplete="off"
 inputmode="numeric"
 pattern="[0-9]*"
 maxlength="2"
 placeholder="MM" />

        <input asp-for="FoundedDay"
 class="form-control u-flex-0-0-auto u-minw-0 u-w-90px"
 autocomplete="off"
 inputmode="numeric"
 pattern="[0-9]*"
 maxlength="2"
 placeholder="DD" />
    </div>

    <span class="text-danger">
        @Html.ValidationMessage(nameof(Model.FoundedYear))
    </span>
</div>


<div class="form-group">
    <label asp-for="PgpKey">PGP Key</label>
    <textarea class="input-width" asp-for="PgpKey"></textarea>
</div>

@{
    var allTags = ViewBag.AllTags as IEnumerable<dynamic>;
}

@if (allTags != null && allTags.Any())
{
    <h4 class="u-mb-8px">Tags</h4>

    <div class="tag-grid">
        @foreach (var t in allTags)
        {
            var id = (int)t.TagId;

            // ✅ support BOTH flows:
            // - existing listing edit (Model.SelectedTagIds)
            // - submission review page (ViewBag.SelectedTagIds is a HashSet<int>)
            var selectedSet = ViewBag.SelectedTagIds as HashSet<int>;
            var isChecked =
            (selectedSet != null && selectedSet.Contains(id)) ||
            (Model.SelectedTagIds != null && Model.SelectedTagIds.Contains(id));

            <label class="tag-chip">
                <input type="checkbox"
                       name="SelectedTagIds"
                       value="@id"
                       @(isChecked ? "checked" : "") />
                <span>@t.Name</span>
            </label>
        }
    </div>
}

<div class="form-group">
    <label asp-for="Tags">Suggested Tags (if choice not provided) <i>comma-separated</i></label>
    <input maxlength="100" asp-for="Tags" class="form-control input-width" />
    <span asp-validation-for="Tags" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="SuggestedSubCategory">Suggested Category (if choice not provided)</label>
    <input autocomplete="off" asp-for="SuggestedSubCategory" class="form-control input-width" />
    <span asp-validation-for="SuggestedSubCategory" class="text-danger"></span>
</div>

<h4>Related Links</h4>
<p class="text-muted">Forum posts, docs, reviews, etc. (not Tor/I2P links)</p>

<!-- ✅ make sure these bind + post back correctly -->
<div class="form-group">
    <label asp-for="RelatedLink1"></label>
    <input autocomplete="off" asp-for="RelatedLink1" class="form-control input-width" />
    <span asp-validation-for="RelatedLink1" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="RelatedLink2"></label>
    <input autocomplete="off" asp-for="RelatedLink2" class="form-control input-width" />
    <span asp-validation-for="RelatedLink2" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="RelatedLink3"></label>
    <input autocomplete="off" asp-for="RelatedLink3" class="form-control input-width" />
    <span asp-validation-for="RelatedLink3" class="text-danger"></span>
</div>

<hr />

<h3>To Reviewer</h3>
<div class="form-group">
    <label asp-for="NoteToAdmin">Note To Admin (private)</label>
    <textarea asp-for="NoteToAdmin" class="form-control input-width" maxlength="@DirectoryManager.Web.Models.SubmissionRequest.NoteToAdminMaxLength"></textarea>
    <span asp-validation-for="NoteToAdmin" class="text-danger"></span>
    <small class="form-text text-muted">Max @DirectoryManager.Web.Models.SubmissionRequest.NoteToAdminMaxLength characters.</small>
</div>

@* Captcha moved to the preview/confirm step so a wrong answer never discards
   the changes entered here — see Views/Submission/Preview.cshtml. *@
