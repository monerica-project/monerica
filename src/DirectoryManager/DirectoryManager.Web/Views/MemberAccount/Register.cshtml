@model DirectoryManager.Web.Models.Members.MemberRegisterViewModel
@using DirectoryManager.Web.Constants
@using DirectoryManager.Web.Helpers
@{
    PageMeta.Title = "Create a member account";
    PageMeta.IsIndexable = false;
    Layout = "_CenteredLayout";
    var open = ViewBag.RegistrationOpen as bool? ?? false;
    var signInHref = MemberAuth.SignInPath + (string.IsNullOrEmpty(Model.ReturnUrl) ? string.Empty : "?returnUrl=" + Uri.EscapeDataString(Model.ReturnUrl));
}

@section PageContent {
<h1>@PageMeta.Title</h1>
<hr />

<p>
    The usual way to review here is with a PGP key (the <b>Leave a review</b> button on a listing).
    This is the easier option: a username and a password. No email and no personal details are asked for.
</p>

@if (!open)
{
    <div class="alert alert-secondary" role="status">
        New member accounts are paused right now. You can still review with a PGP key, and existing members can
        <a href="@signInHref">sign in</a>.
    </div>
}
else
{
    <div class="alert alert-warning" role="note">
        <strong>Save your username and password before you continue.</strong>
        There is no email on a member account, so there is <b>no password recovery</b>: if you lose either one,
        the account can't be recovered. A password manager is the easiest place to keep them.
    </div>

    <form method="post" action="@MemberAuth.RegisterPath">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @* The username is assigned by the site and cannot be changed: shown as text, carried in a signed token. *@
        <input type="hidden" name="UsernameToken" value="@Model.UsernameToken" />
        <div class="form-group">
            @* Inline styles on purpose (same approach as the Moderator tag): no stylesheet change needed. *@
            <div style="border:2px solid #f26822;border-radius:8px;padding:12px 16px;margin:4px 0 6px;max-width:520px;">
                <div style="font-size:0.85rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;">Your username</div>
                <div style="font-family:monospace;font-size:1.7rem;font-weight:700;line-height:1.3;word-break:break-all;user-select:all;">@Model.Username</div>
            </div>
            <small>This username was picked for you and can't be changed. Save it together with your password.</small>
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            @* type="text" on purpose: the suggested password must be visible so it can be saved. *@
            <input asp-for="Password" type="text" class="form-control input-width" autocomplete="new-password" maxlength="@MemberAccountRules.MaxPasswordLength" spellcheck="false" />
            <small>A strong random password was generated for you. Keep it or type your own (at least @MemberAccountRules.MinPasswordLength characters).</small>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <input asp-for="SavedCredentials" />
            <label asp-for="SavedCredentials">I have saved my username and password somewhere safe.</label>
            <span asp-validation-for="SavedCredentials" class="text-danger"></span>
        </div>

        @await Html.PartialAsync("_CaptchaBlock", "member-register")

        <button type="submit" class="btn btn-primary">Create account</button>
    </form>

    <p class="u-mt-12px">
        <small>
            Reviews from member accounts are labeled "(account)", and every one is checked by a moderator before it appears.
        </small>
    </p>
}

<p class="u-mt-12px">Already have an account? <a href="@signInHref">Sign in</a></p>
}
