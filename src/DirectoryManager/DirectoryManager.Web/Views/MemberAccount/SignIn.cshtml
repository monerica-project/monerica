@model DirectoryManager.Web.Models.Members.MemberSignInViewModel
@using DirectoryManager.Web.Constants
@{
    PageMeta.Title = "Member sign in";
    PageMeta.IsIndexable = false;
    Layout = "_CenteredLayout";
    var registerHref = MemberAuth.RegisterPath + (string.IsNullOrEmpty(Model.ReturnUrl) ? string.Empty : "?returnUrl=" + Uri.EscapeDataString(Model.ReturnUrl));
}

@section PageContent {
<h1>@PageMeta.Title</h1>
<hr />

<p>For member accounts (username and password). Reviewing with a PGP key needs no account.</p>

<form method="post" action="@MemberAuth.SignInPath">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Username"></label>
        <input asp-for="Username" class="form-control input-width" autocomplete="username" spellcheck="false" />
    </div>
    <div class="form-group">
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" class="form-control input-width" autocomplete="current-password" />
    </div>
    <div class="form-group">
        <input asp-for="RememberMe" />
        <label asp-for="RememberMe"></label>
    </div>

    @await Html.PartialAsync("_CaptchaBlock", "member-signin")

    <button type="submit" class="btn btn-primary">Sign in</button>
</form>

<p class="u-mt-12px">
    No account yet? <a href="@registerHref">Create one</a> with just a username and password.
</p>
<p><small>Lost your password? Member accounts have no email, so a lost password can't be reset. You can create a new account.</small></p>
}
