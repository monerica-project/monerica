@model DirectoryManager.Web.Models.Members.MemberChangePasswordViewModel
@using DirectoryManager.Web.Constants
@using DirectoryManager.Web.Helpers
@{
    PageMeta.Title = "Change password";
    PageMeta.IsIndexable = false;
    Layout = "_CenteredLayout";
}

@section PageContent {
<h1>@PageMeta.Title</h1>
<hr />

<form method="post" action="/members/change-password">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="CurrentPassword"></label>
        <input asp-for="CurrentPassword" type="password" class="form-control input-width" autocomplete="current-password" />
        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="NewPassword"></label>
        <input asp-for="NewPassword" type="password" class="form-control input-width" autocomplete="new-password" maxlength="@MemberAccountRules.MaxPasswordLength" />
        <small>At least @MemberAccountRules.MinPasswordLength characters. Save it first: it can't be recovered.</small>
        <span asp-validation-for="NewPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Change password</button>
</form>

<p class="u-mt-12px"><a href="@MemberAuth.AccountPath">Back to my account</a></p>
}
