@model DirectoryManager.Web.Models.VideoSponsorship.VideoSponsorStartVm
@inject DirectoryManager.Web.Services.Interfaces.IUrlResolutionService UrlResolver
@{
    PageMeta.Title = "Sponsor a Video";
    Layout = "_CenteredLayout";
}

@section PageContent {
    <h1>Sponsor a Video</h1>
    @await Html.PartialAsync("_BackToHome")
    <hr />
    @await Html.PartialAsync("_Steps", 1)

    <p><a href="@Url.Action("Examples", "VideoSponsorship")">See examples of finished sponsored videos &rarr;</a></p>

    <div class="u-callout">
        <p><strong>Who can sponsor a video: both of these are required</strong></p>
        <ol class="u-m-0-0-12px-0-pl-22px">
            <li>Your listing is <strong>Verified</strong> (the green checkmark &#9989;).</li>
            <li>
                Your listing has been in the directory for at least
                <strong>@DirectoryManager.Common.Constants.IntegerConstants.MinimumDaysListedBeforeSponsoring days</strong>.
            </li>
        </ol>
    </div>

    <form method="get" action="@Url.Action("Start", "VideoSponsorship")" class="search-form search-form-compact u-m-16px-0">
        <input type="search" name="q" value="@Model.Query" placeholder="Search listings…" class="form-control" />
        <button type="submit" class="btn btn-primary btn-cta">Find my listing</button>
    </form>

    @if (Model.HasSearched)
    {
        <h2 class="u-mt-18px">Search results</h2>
        <p class="u-m-6px-0-12px-0">
            @Model.TotalCount result@(Model.TotalCount == 1 ? "" : "s")
            @if (Model.TotalPages > 1)
            {
                <span> — page @Model.Page of @Model.TotalPages</span>
            }
        </p>

        <div class="search-results">
            @foreach (var r in Model.Results)
            {
                <div class="result-row sponsor-search-row u-flex-flexwrap-wrap-items-center-gap-8px-16px-p-12px-0">
                    <div class="u-flex-1-1-240px-minw-0">
                        <div class="u-fs-105em-fw-600">
                            @* Name links to the listing's profile on this directory. *@
                            @if (!string.IsNullOrWhiteSpace(r.DirectoryEntryKey))
                            {
                                <a class="no-app-link" href="@UrlResolver.ResolveToRoot(DirectoryManager.Utilities.Helpers.UrlBuilder.ListingPath(r.DirectoryEntryKey))">@r.Name</a>
                            }
                            else
                            {
                                @r.Name
                            }
                        </div>
                        <div class="u-opacity-8-fs-9em-mt-2px">@r.Category</div>
                        @if (!r.CanSponsor && r.Reasons.Any())
                        {
                            <ul class="u-m-6px-0-0-18px-opacity-85-fs-9em">
                                @foreach (var reason in r.Reasons)
                                {
                                    <li>@reason</li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="u-flex-0-0-auto-m-0">
                        @if (r.CanSponsor)
                        {
                            @* Orange action button that names the listing, like the site-sponsor search. *@
                            <a class="btn btn-primary btn-cta sponsor-search-spots-btn" href="@Url.Action("Type", "VideoSponsorship", new { directoryEntryId = r.DirectoryEntryId })">Sponsor a video as @r.Name &rarr;</a>
                        }
                        else
                        {
                            <span class="text-muted">Not eligible yet</span>
                        }
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <p class="u-m-12px-0-22px-0">
                @if (Model.Page > 1)
                {
                    <a href="@Url.Action("Start", "VideoSponsorship", new { q = Model.Query, page = Model.Page - 1 })">&larr; Previous</a>
                }
                @if (Model.Page < Model.TotalPages)
                {
                    <span>&nbsp;</span>
                    <a href="@Url.Action("Start", "VideoSponsorship", new { q = Model.Query, page = Model.Page + 1 })">Next &rarr;</a>
                }
            </p>
        }
    }
}
