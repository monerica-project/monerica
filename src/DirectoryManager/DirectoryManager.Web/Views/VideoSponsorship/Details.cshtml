@using System.Globalization
@inject DirectoryManager.Web.Services.Interfaces.ICacheService cacheHelper
@model DirectoryManager.Web.Models.VideoSponsorship.VideoSponsorCheckoutVm
@{
    var siteName = await cacheHelper.GetSnippetAsync(DirectoryManager.Data.Enums.SiteConfigSetting.SiteName);
    ViewData[DirectoryManager.Web.Constants.StringConstants.TitleHeader] = "Review & Pay";
    Layout = "_CenteredLayout";
    var usd = new CultureInfo(DirectoryManager.Common.Constants.StringConstants.DefaultCulure);
    var hasPerk = Model.DiscountPercent > 0m;
    var hasDemoCost = Model.DemoCostUsd > 0m;
    var demoYes = hasDemoCost || Model.DemoCostInput != null;
    var demoThreshold = DirectoryManager.Common.Constants.IntegerConstants.VideoSponsorDemoCostThresholdUsd;
    var offer = Model.SelectedOffer!;
    var backUrl = offer.RequiresVideoSelection
        ? Url.Action("Videos", "VideoSponsorship", new { directoryEntryId = Model.DirectoryEntryId, offerId = offer.VideoSponsorOfferId, v = Model.SelectedVideoIds })
        : Url.Action("Type", "VideoSponsorship", new { directoryEntryId = Model.DirectoryEntryId, offerId = offer.VideoSponsorOfferId });
}

@section PageContent {
    <h1>Review &amp; Pay</h1>
    <hr />
    @await Html.PartialAsync("_Steps", 3)

    <div class="alert alert-info" role="alert">
        This is a <strong>video sponsorship</strong> on the @siteName YouTube channel@(string.IsNullOrWhiteSpace(Model.ChannelUrl) ? "." : ":")
        @if (!string.IsNullOrWhiteSpace(Model.ChannelUrl))
        {
            <a href="@Model.ChannelUrl" target="_blank" rel="noopener">@Model.ChannelUrl</a>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Notice))
    {
        <div class="alert alert-warning" role="alert"><strong>Total updated.</strong> @Model.Notice</div>
    }

    <h2>Your Order</h2>
    <table>
        <tr><td><b>Listing:</b></td><td>@Model.ListingName</td></tr>
        <tr><td><b>Video type:</b></td><td>@offer.Name</td></tr>
        @if (offer.RequiresVideoSelection)
        {
            <tr>
                <td><b>Videos (@Model.Quantity):</b></td>
                <td>
                    <ul class="u-m-0-0-12px-0-pl-22px">
                        @foreach (var v in Model.SelectedVideos)
                        {
                            <li>@v.Title</li>
                        }
                    </ul>
                </td>
            </tr>
            <tr><td><b>Price per video:</b></td><td>@offer.Price.ToString("C2", usd) USD</td></tr>
        }
        @if (hasPerk)
        {
            <tr>
                <td><b>Regular price:</b></td>
                <td><s class="price-strike">@Model.OriginalAmount.ToString("C2", usd) USD</s></td>
            </tr>
            <tr>
                <td><b>Existing sponsor perk:</b></td>
                <td class="text-danger">
                    @Model.DiscountPercent.ToString("0.##")% off (&minus;@Model.DiscountAmount.ToString("C2", usd))
                </td>
            </tr>
        }
        @if (hasDemoCost)
        {
            <tr><td><b>Sponsorship:</b></td><td>@Model.SponsorshipTotal.ToString("C2", usd) USD</td></tr>
            <tr><td><b>Product demo cost:</b></td><td>@Model.DemoCostUsd.ToString("C2", usd) USD (no discount applies)</td></tr>
        }
        <tr><td><b>Total:</b></td><td><b>@Model.Total.ToString("C2", usd) USD</b>, paid in Monero (XMR)</td></tr>
    </table>
    <p><a href="@backUrl">&larr; Change selection</a></p>

    <ul>
        <li>Each video is published within <strong>@Model.DeliveryDays days</strong> of payment.</li>
        <li>
            If we can't make the video as requested or in time, we refund your payment to the
            refund address below. <strong>Any refund is your payment minus Monero network fees.</strong>
            The same applies if the demo turns out to cost more than you entered and we can't
            agree on the difference.
        </li>
    </ul>

    <hr />
    <form method="post" action="@Url.Action("Checkout", "VideoSponsorship")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="directoryEntryId" value="@Model.DirectoryEntryId" />
        <input type="hidden" name="offerId" value="@offer.VideoSponsorOfferId" />
        <input type="hidden" name="v" value="@Model.SelectedVideoIds" />
        <input type="hidden" name="shownDemoCost" value="@Model.DemoCostUsd.ToString("0.00", CultureInfo.InvariantCulture)" />

        <div class="text-danger">@Html.ValidationSummary(true)</div>

        <div class="form-group">
            <label for="notes">
                <b>@(offer.RequiresVideoSelection ? "Notes for your sponsor segment (optional)" : "Describe the video you want")</b>
            </label>
            <p class="text-muted">What should we say or show? Include links, key points and anything we should avoid.</p>
            <textarea id="notes" name="notes" rows="6" maxlength="4000" class="form-control">@Model.Notes</textarea>
            <div class="text-danger">@Html.ValidationMessage("Notes")</div>
        </div>

        <div class="form-group">
            <label><b>Does demonstrating your product in the video cost more than $@demoThreshold?</b></label>
            <p class="text-muted">
                For example, buying your product or doing a swap on camera. If it costs more than $@demoThreshold,
                you cover that cost in full and it is added to your total (no discount applies to it).
                If it is $@demoThreshold or less, we cover it.
            </p>
            <div class="form-check u-mb-8px">
                <label class="form-check-label u-flex-items-center-gap-8px-flexwrap-wrap">
                    <input class="form-check-input" type="radio" name="demoOver100" id="demoNo" value="false" @(demoYes ? "" : "checked") />
                    <span>No, it costs $@demoThreshold or less (or nothing)</span>
                </label>
            </div>
            <div class="form-check u-mb-8px">
                <label class="form-check-label u-flex-items-center-gap-8px-flexwrap-wrap">
                    <input class="form-check-input" type="radio" name="demoOver100" id="demoYes" value="true" @(demoYes ? "checked" : "") />
                    <span>Yes, it costs more than $@demoThreshold</span>
                </label>
            </div>
            <label for="demoCost">Demo cost in USD (only if you chose Yes)</label>
            <input id="demoCost" name="demoCost" type="text" inputmode="decimal" maxlength="12" autocomplete="off" placeholder="e.g. 250"
                   value="@(hasDemoCost ? Model.DemoCostUsd.ToString("0.00", CultureInfo.InvariantCulture) : Model.DemoCostInput)" class="form-control u-w-200px-imp" />
            <div class="text-danger">@Html.ValidationMessage("DemoCost")</div>
        </div>

        <div class="form-group">
            <label for="refundAddress"><b>Monero refund address (required)</b></label>
            <p class="text-muted">
                Used only if we have to refund you. <strong>Refunds are sent minus Monero network fees.</strong>
                Use an address you control, not an exchange deposit address.
            </p>
            <input id="refundAddress" name="refundAddress" type="text" value="@Model.RefundAddress" maxlength="120" autocomplete="off" class="form-control" />
            <div class="text-danger">@Html.ValidationMessage("RefundAddress")</div>
        </div>

        <div class="form-group">
            <label for="email"><b>Email (optional)</b></label>
            <p class="text-muted">We'll send you the link when your video is published.</p>
            <input id="email" name="email" type="email" value="@Model.Email" maxlength="100" placeholder="yourname@email.com" autocomplete="off" class="form-control input-width u-w-18pct" />
            <div class="text-danger">@Html.ValidationMessage("Email")</div>
        </div>

        <div class="alert alert-info" role="alert">
            <strong>&#9888; Important &mdash; Monero wallet sync</strong><br />
            Before paying, make sure your Monero wallet is <strong>fully synced</strong>.
            The invoice expires shortly after it is created, and your selected videos are held for you until then.
        </div>

        <hr />
        <div>
            @await Html.PartialAsync("_CaptchaBlock", DirectoryManager.Web.Controllers.VideoSponsorshipController.CaptchaContext)
            <div class="text-danger u-mt-4px">@Html.ValidationMessage("Captcha")</div>
        </div>
        <hr />

        @if (Model.CheckoutAvailable)
        {
            <button class="btn btn-cta" type="submit">Continue to payment</button>
            <p class="text-muted u-mt-4px">If you enter a demo cost, you'll see the updated total and confirm it before the invoice is created.</p>
        }
        else
        {
            <p class="text-danger">Checkout isn't available right now. Please check back soon.</p>
        }
    </form>
}
