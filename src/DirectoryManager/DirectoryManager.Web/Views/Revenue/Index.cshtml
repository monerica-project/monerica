@model DirectoryManager.Web.Models.Reports.RevenueReportViewModel
@using DirectoryManager.Web.Constants
@using DirectoryManager.Web.Revenue
@using System.Globalization
@{
    PageMeta.Title = "Revenue";
    PageMeta.MetaContent = StringConstants.MetaTagNoIndex;
    Layout = "_CenteredLayout";

    var usd = CultureInfo.GetCultureInfo("en-US");
    var earned = Model.Basis == RevenueBasis.Earned;
    var chartQuery = string.IsNullOrEmpty(Model.ChartQuery) ? "?" : Model.ChartQuery + "&";
    var cacheBust = DateTime.UtcNow.ToString(DirectoryManager.Common.Constants.StringConstants.CompactDateTimeFormat, CultureInfo.InvariantCulture);
    var xmr = Model.InXmr;
    string Money(decimal amount, bool precise = false) => RevenueMoney.Format(amount, xmr, precise);

    // Same period/basis, other unit.
    string UnitLink(string currency)
    {
        var q = new List<string> { "period=" + Uri.EscapeDataString(Model.Period), "basis=" + Model.Basis };
        if (Model.Period == "custom")
        {
            q.Add("from=" + Model.From.ToString(DirectoryManager.Common.Constants.StringConstants.DateFormat, CultureInfo.InvariantCulture));
            q.Add("to=" + Model.To.AddDays(-1).ToString(DirectoryManager.Common.Constants.StringConstants.DateFormat, CultureInfo.InvariantCulture));
        }

        if (currency == "xmr")
        {
            q.Add("currency=xmr");
        }

        return "/admin/revenue?" + string.Join("&", q);
    }
}

@section PageContent {
    <h1>@PageMeta.Title</h1>
    @await Html.PartialAsync("_AdminMenu")

    <p>
        <strong>Revenue</strong> |
        <a href="~/admin/revenue/forecast">Forecast</a> |
        <a href="~/report">Sponsorship invoice report</a>
    </p>
    <p>
        Show amounts in:
        @if (xmr)
        {
            <a href="@UnitLink("usd")">USD</a> <text>|</text> <strong>XMR</strong>
        }
        else
        {
            <strong>USD</strong> <text>|</text> <a href="@UnitLink("xmr")">XMR</a>
        }
    </p>
    <hr />

    <form method="get" action="~/admin/revenue">
        @if (xmr)
        {
            <input type="hidden" name="currency" value="xmr" />
        }
        <div class="form-row">
            <div class="form-group col-md-3">
                <label for="period">Period</label>
                <select id="period" name="period" class="form-control">
                    @foreach (var (key, label) in Model.PeriodOptions)
                    {
                        <option value="@key" selected="@(key == Model.Period)">@label</option>
                    }
                </select>
            </div>
            <div class="form-group col-md-3">
                <label for="from">From (custom)</label>
                <input id="from" name="from" type="date" class="form-control" value="@(Model.Period == "custom" ? Model.From.ToString(DirectoryManager.Common.Constants.StringConstants.DateFormat) : "")" />
            </div>
            <div class="form-group col-md-3">
                <label for="to">To (custom, inclusive)</label>
                <input id="to" name="to" type="date" class="form-control" value="@(Model.Period == "custom" ? Model.To.AddDays(-1).ToString(DirectoryManager.Common.Constants.StringConstants.DateFormat) : "")" />
            </div>
            <div class="form-group col-md-3">
                <label for="basis">Count revenue as</label>
                <select id="basis" name="basis" class="form-control">
                    <option value="Earned" selected="@earned">Earned (spread over service days)</option>
                    <option value="Cash" selected="@(!earned)">Cash (when paid)</option>
                </select>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Show</button>
    </form>

    <p class="text-muted u-mt-4px">
        @if (earned)
        {
            <text>Earned: each sponsorship counts a little every day it runs (amount ÷ days paid for), so a year paid up front doesn't look like a one-month spike. Review and verification payments, video sponsorships and affiliate commissions count on the day they were paid.</text>
        }
        else
        {
            <text>Cash: everything counts on the day the money arrived, including sponsorships paid months in advance.</text>
        }
    </p>

    <h2>@Model.PeriodLabel: @Money(Model.Report.GrandTotal, xmr) in revenue</h2>
    <p class="text-muted u-mt-4px">
        @if (xmr)
        {
            <text>The XMR actually paid (no price conversion). In USD: @RevenueMoney.Format(Model.OtherUnitTotal, false).</text>
        }
        else
        {
            <text>Paid in XMR: @RevenueMoney.Format(Model.OtherUnitTotal, true, precise: true).</text>
        }
    </p>
    @if (xmr && Model.NotPaidInXmrCount > 0)
    {
        <p class="text-warning">
            @Model.NotPaidInXmrCount payment(s) in this period (@RevenueMoney.Format(Model.NotPaidInXmrUsd, false, precise: true))
            weren't paid in XMR or have no XMR amount recorded (for example affiliate commissions and USD-priced
            review payments), so they aren't included in the XMR figures.
        </p>
    }
    <p class="text-muted">
        This is money received, <strong>not profit</strong>. Submission review, verification and problem report payments
        pay for the review work they buy, and video sponsorships carry production costs (including any product demo cost
        the sponsor paid for). None of those costs are subtracted here.
    </p>

    <img class="u-maxw-100pct-h-auto-block-m-0-auto-pb-10px" alt="Revenue by source, @Model.PeriodLabel" src="~/admin/revenue/pie.png@(chartQuery)v=@cacheBust" width="900" height="520" />

    <div class="u-overflowx-auto">

    <table class="table table-sm">
        <thead>
            <tr>
                <th>Source</th>
                <th class="text-right">Amount</th>
                <th class="text-right">Share</th>
                <th class="text-right">@(earned ? "Payments / sponsorships" : "Payments")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Report.Totals)
            {
                <tr>
                    <td>@RevenueReportBuilder.Label(t.Source)</td>
                    <td class="text-right">@Money(t.AmountUsd, true)</td>
                    <td class="text-right">@t.SharePct.ToString("0.#", CultureInfo.InvariantCulture)%</td>
                    <td class="text-right">@t.Count</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th>Total</th>
                <th class="text-right">@Money(Model.Report.GrandTotal, true)</th>
                <th></th>
                <th class="text-right">@Model.Report.Totals.Sum(t => t.Count)</th>
            </tr>
        </tfoot>
    </table>
    </div>

    @if (!xmr && Model.MissingUsdCount > 0)
    {
        <p class="text-warning">@Model.MissingUsdCount paid review or verification payment(s) in this period have no USD value recorded, so they count as $0 above.</p>
    }

    <h2>By month</h2>
    <img class="u-maxw-100pct-h-auto-block-m-0-auto-pb-10px" alt="Revenue by month and source" src="~/admin/revenue/monthly.png@(chartQuery)v=@cacheBust" width="1400" height="600" />

    @if (Model.Report.Months.Count > 1)
    {
        <div class="u-overflowx-auto">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Month</th>
                    @foreach (var s in RevenueReportBuilder.Sources)
                    {
                        <th class="text-right">@RevenueReportBuilder.Label(s)</th>
                    }
                    <th class="text-right">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Report.Months)
                {
                    <tr>
                        <td>@m.Month.ToString(DirectoryManager.Common.Constants.StringConstants.MonthYearFormat, CultureInfo.InvariantCulture)</td>
                        @foreach (var s in RevenueReportBuilder.Sources)
                        {
                            <td class="text-right">@Money(m.BySource[s])</td>
                        }
                        <td class="text-right"><strong>@Money(m.Total)</strong></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
}
