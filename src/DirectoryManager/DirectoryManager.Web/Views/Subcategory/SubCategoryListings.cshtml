@model DirectoryManager.Web.Models.CategorySubCategoriesViewModel
@using DirectoryManager.Data.Models
@using DirectoryManager.Data.Repositories.Interfaces
@using DirectoryManager.Web.Constants;
@using DirectoryManager.Data.Enums;
@using DirectoryManager.Web.Enums
@using DirectoryManager.Web.Helpers
@using DirectoryManager.Web.Models
@using DirectoryManager.Utilities.Helpers
@inject DirectoryManager.Web.Services.Interfaces.ICacheService cacheHelper
@inject DirectoryManager.Data.Repositories.Interfaces.ISponsoredListingRepository sponsoredListingRepository
@inject DirectoryManager.Data.Repositories.Interfaces.IDirectoryEntryRepository directoryEntryRepository
@inject DirectoryManager.Web.Services.Interfaces.ICacheService cacheHelper
@inject ICategoryRepository categoryRepo
@inject ISubcategoryRepository subCatRepo
@inject DirectoryManager.Web.Services.Interfaces.IUrlResolutionService UrlResolver
@inject DirectoryManager.Data.Repositories.Interfaces.IDirectoryEntryReviewRepository directoryEntryReviewRepository
@inject DirectoryManager.Data.Repositories.Interfaces.IDirectoryEntryAdditionalSubcategoryRepository additionalSubcategoryRepo

@{
    var siteNameForSeo = await cacheHelper.GetSnippetAsync(SiteConfigSetting.SiteName);
    var currencyNameForSeo = await cacheHelper.GetSnippetAsync(SiteConfigSetting.DirectoryCurrencyName);
    PageMeta.Title = Model.PageTitle;

    // Keyword first, at most 60 characters: "Instant Swaps: Monero (XMR) Exchanges | Monerica".
    // A hand-written SeoTitle (Subcategories.SeoTitle) wins; page 2+ gets "(Page N)".
    PageMeta.SeoTitle = !string.IsNullOrWhiteSpace(Model.SeoTitle)
        ? SeoTitleBuilder.WithPage(Model.SeoTitle, Model.CurrentPage)
        : SeoTitleBuilder.ForSubcategory(
            Model.SubcategoryName,
            Model.CategoryName,
            currencyNameForSeo,
            siteNameForSeo,
            Model.CurrentPage);

    // H1: the hand-written heading, else the generated title without the site name
    // ("Instant Swaps: Monero (XMR) Exchanges") instead of "Exchanges » Instant Swaps"
    // (the breadcrumb right below already shows the category path).
    var pageHeading = !string.IsNullOrWhiteSpace(Model.Heading)
        ? Model.Heading
        : SeoTitleBuilder.ForSubcategory(Model.SubcategoryName, Model.CategoryName, currencyNameForSeo, null);
    var baseDescription = string.IsNullOrWhiteSpace(Model.MetaDescription)
        ? SeoDescriptionBuilder.ForListPage($"{Model.SubcategoryName} ({Model.CategoryName})", Model.PagedEntries?.TotalCount ?? 0, currencyNameForSeo, siteNameForSeo)
        : Model.MetaDescription;
    PageMeta.MetaDescription = SeoDescriptionBuilder.Shorten(
        Model.CurrentPage > 1 ? $"Page {Model.CurrentPage}. {baseDescription}" : baseDescription);
    var categoryKey = ViewBag.CategoryKey as string;
    var subCategoryKey = ViewBag.SubCategoryKey as string;
    var categoryName = ViewBag.CategoryName as string;
    var subCategoryName = ViewBag.SubCategoryName as string;
    var domain = await cacheHelper.GetSnippetAsync(SiteConfigSetting.CanonicalDomain);

    // Build your breadcrumb list dynamically based on page context
    var breadcrumbs = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Position = 1, Name = "Home", Url = UrlHelper.MakeFullUrl(domain,"/") },
        new BreadcrumbItem { Position = 2, Name = @categoryName, Url = UrlHelper.MakeFullUrl(domain,$"/{@categoryKey}") },
        new BreadcrumbItem { Position = 3, Name = @subCategoryName, Url = UrlHelper.MakeFullUrl(domain,$"/{@categoryKey}/{@subCategoryKey}")  }
    };
    PageMeta.StructuredData.Add(JsonLdBuilder.BreadcrumbList(breadcrumbs));

    // ItemList of the listings on this page (positions continue across pages).
    var itemListStart = ((Math.Max(1, Model.CurrentPage) - 1) * Math.Max(1, Model.PageSize)) + 1;
    PageMeta.StructuredData.Add(JsonLdBuilder.ItemList(
        Model.SubcategoryName,
        PageMeta.CanonicalUrl,
        Model.EntryViewModels.Select(e => (e.Name, UrlHelper.MakeFullUrl(domain, UrlBuilder.ListingPath(e.DirectoryEntryKey)))),
        itemListStart));
}

@{
    PageMeta.CurrentCategoryKey = Model.Category.CategoryKey;
    PageMeta.CurrentSubCategoryKey = Model.SubCategoryKey;
    Layout = "_LayoutWithNav";
}

  @section PageContent {


    
<h1>@pageHeading</h1>

<hr />

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a class="no-app-link" href="@UrlResolver.ResolveToRoot("~/")">Home</a>
        </li>
        <li class="breadcrumb-item">
                <a class="no-app-link" href="@UrlResolver.ResolveToRoot(Model.CategoryRelativePath)">@Model.CategoryName</a>
        </li>
        <li class="breadcrumb-item" aria-current="page">
            @Model.SubcategoryName
        </li>
    </ol>
</nav>

@if (!string.IsNullOrWhiteSpace(Model.PageDetails))
{
    // Plain text keeps the old single <p>. HTML that brings its own blocks (<p>, <ul>) goes in a
    // <div>, because a <p> or <ul> nested inside a <p> is invalid and the browser splits it.
    var pageDetailsHtml = ContentSanitizer.Sanitize(Model.PageDetails);
    if (pageDetailsHtml.TrimStart().StartsWith("<p", StringComparison.OrdinalIgnoreCase)
        || pageDetailsHtml.TrimStart().StartsWith("<ul", StringComparison.OrdinalIgnoreCase))
    {
        <div class="page-intro">@Html.Raw(pageDetailsHtml)</div>
    }
    else
    {
        <p>@Html.Raw(pageDetailsHtml)</p>
    }
}

@if (!string.IsNullOrWhiteSpace(Model.Note))
{
    <p><i>Note: @Html.Raw(ContentSanitizer.Sanitize(Model.Note))</i></p>
}

    @{
        var subCategorySponsors = await this.sponsoredListingRepository.GetSponsoredListingsForSubCategory(Model.SubCategoryId);
        var link2Name = await cacheHelper.GetSnippetAsync(SiteConfigSetting.Link2Name);
        var link3Name = await cacheHelper.GetSnippetAsync(SiteConfigSetting.Link3Name);

        var viewModelList = Model.EntryViewModels
            ?? new List<DirectoryManager.DisplayFormatting.Models.DirectoryEntryViewModel>();

        var subCategorySponsor = subCategorySponsors.FirstOrDefault();
        var activeEntries = await directoryEntryRepository.GetActiveEntriesBySubcategoryAsync(Model.SubCategoryId);

        // ✅ Pull rating summary for subcategory sponsor (AvgRating + ReviewCount)
        DirectoryManager.Data.Models.TransferModels.RatingSummaryDto? sponsorRating = null;

        if (subCategorySponsor?.DirectoryEntry != null)
        {
            var sponsorId = subCategorySponsor.DirectoryEntry.DirectoryEntryId;

            var ratingDict = await directoryEntryReviewRepository.GetRatingSummariesAsync(new[] { sponsorId });

            if (ratingDict.TryGetValue(sponsorId, out var dto))
            {
                sponsorRating = dto;
            }
        }

        // A sponsorship bought for one of the listing's ADDITIONAL subcategories shows that
        // subcategory's name/links/description here (only on this subcategory's page).
        var sponsorEntry = subCategorySponsor?.DirectoryEntry;
        if (sponsorEntry != null && sponsorEntry.SubCategoryId != Model.SubCategoryId)
        {
            var altRows = await additionalSubcategoryRepo.GetByDirectoryEntryIdAsync(sponsorEntry.DirectoryEntryId);
            var altHere = altRows.FirstOrDefault(a => a.SubCategoryId == Model.SubCategoryId);
            if (altHere != null)
            {
                sponsorEntry = altHere.ApplyTo(sponsorEntry);
            }
        }

        var subCategorySponsorModel = new DirectoryManager.Web.Models.SubcategorySponsorModel
        {
            SubCategoryId = Model.SubCategoryId,
            TotalActiveSubCategoryListings = activeEntries.Count(),
            SponsorshipDisabled = (ViewBag.SponsorshipDisabled as bool?) ?? false,
            DirectoryEntry = (sponsorEntry != null)
                ? new DirectoryManager.DisplayFormatting.Models.DirectoryEntryViewModel
                {
                    CountryCode = sponsorEntry!.CountryCode,

                    DateOption = DirectoryManager.DisplayFormatting.Enums.DateDisplayOption.NotDisplayed,

                    Link = sponsorEntry!.Link,
                    LinkA = sponsorEntry!.LinkA,

                    Name = sponsorEntry!.Name,
                    Description = sponsorEntry!.Description,
                    DirectoryEntryId = sponsorEntry!.DirectoryEntryId,
                    DirectoryEntryKey = sponsorEntry!.DirectoryEntryKey,
                    DirectoryStatus = sponsorEntry!.DirectoryStatus,

                    Link2 = sponsorEntry!.Link2,
                    Link2A = sponsorEntry!.Link2A,
                    Link3 = sponsorEntry!.Link3,
                    Link3A = sponsorEntry!.Link3A,

                    StreetAddress = sponsorEntry!.StreetAddress,
                    City = sponsorEntry!.City,
                    StateRegion = sponsorEntry!.StateRegion,
                    PostalCode = sponsorEntry!.PostalCode,
                    Note = sponsorEntry!.Note,
                    Processor = sponsorEntry!.Processor,
                    SubCategoryId = sponsorEntry!.SubCategoryId,

                    CreateDate = sponsorEntry!.CreateDate,
                    UpdateDate = sponsorEntry!.UpdateDate,

                    LinkType = DirectoryManager.DisplayFormatting.Enums.LinkType.ListingPage,
                    IsSponsored = true,
                    DisplayAsSponsoredItem = false,

                    Link2Name = link2Name,
                    Link3Name = link3Name,

                    // ✅ needed if rating count links to #reviews
                    ItemPath = "/site/" + sponsorEntry!.DirectoryEntryKey,

                    // ✅ ratings from RatingSummaryDto
                    AverageRating = (sponsorRating != null && sponsorRating.ReviewCount > 0)
                        ? sponsorRating.AvgRating
                        : null,

                    ReviewCount = (sponsorRating != null && sponsorRating.ReviewCount > 0)
                        ? sponsorRating.ReviewCount
                        : null
                }
                : null
        };
    }


    @* THIS must stay to keep the CTA *@
    @await Html.PartialAsync("_SponsoredListingSubCategoryPartial", subCategorySponsorModel)

    @{
        // Highlight set: every listing with ANY active sponsorship (main, category or subcategory,
        // for any category/subcategory) is shown as a sponsor wherever it appears (owner's rule, 2026-11-08).
        var mainSponsors = await sponsoredListingRepository.GetActiveSponsorsByTypeAsync(SponsorshipType.MainSponsor);
        var categorySponsors = await sponsoredListingRepository.GetActiveSponsorsByTypeAsync(SponsorshipType.CategorySponsor);
        var subcategorySponsors = await sponsoredListingRepository.GetActiveSponsorsByTypeAsync(SponsorshipType.SubcategorySponsor);

        var highlightIds = new HashSet<int>(
            (mainSponsors ?? Enumerable.Empty<DirectoryManager.Data.Models.SponsoredListings.SponsoredListing>())
                .Concat(categorySponsors ?? Enumerable.Empty<DirectoryManager.Data.Models.SponsoredListings.SponsoredListing>())
                .Concat(subcategorySponsors ?? Enumerable.Empty<DirectoryManager.Data.Models.SponsoredListings.SponsoredListing>())
                .Select(s => s.DirectoryEntryId));

        // do not double-highlight the subcategory sponsor that’s already shown above
        int? subSponsorEntryId = subCategorySponsorModel.DirectoryEntry?.DirectoryEntryId;
    }

    @{
        var subcategoryPick = (await subCatRepo.GetByIdAsync(Model.SubCategoryId))?.FeaturedDirectoryEntryId;
    }

    <ul class="blank_list_item">
        @foreach (var viewModel in viewModelList)
        {
            viewModel.LinkType = DirectoryManager.DisplayFormatting.Enums.LinkType.ListingPage;
            viewModel.IsFeaturedInThisList = viewModel.DirectoryEntryId == subcategoryPick;

            if (highlightIds.Contains(viewModel.DirectoryEntryId) ||
            (subSponsorEntryId.HasValue && viewModel.DirectoryEntryId == subSponsorEntryId.Value))
            {
                viewModel.IsSponsored = true;
                viewModel.DisplayAsSponsoredItem = true;
            }

            @await Html.PartialAsync("_DirectoryEntryPartial", viewModel)
        }
    </ul>

    @{
        int totalPages = (int)Math.Ceiling(Model.PagedEntries.TotalCount / (double)Model.PageSize);
        int currentPage = Model.CurrentPage < 1 ? 1 : Model.CurrentPage;

        string categoryKey2 = Model.Category.CategoryKey;
        string subCategoryKey2 = Model.SubCategoryKey;
    }

    @if (totalPages > 1)
    {
        <nav aria-label="Pagination">
            <ul class="pagination">
                @for (int p = 1; p <= totalPages; p++)
                {
                    string rawPath = (p == 1)
                        ? $"/{categoryKey2}/{subCategoryKey2}"
                        : $"/{categoryKey2}/{subCategoryKey2}/page/{p}";

                    string href = (p == 1)
                        ? UrlResolver.BaseUrl.TrimEnd('/') + rawPath
                        : UrlResolver.ResolveToApp(rawPath);

                    var isActive = (p == currentPage);

                    <li class="page-item @(isActive ? "active" : "")">
                        @if (isActive)
                        {
                            <span class="page-link" aria-current="page">@p</span>
                        }
                        else
                        {
                            <a class="page-link no-app-link" href="@href">@p</a>
                        }
                    </li>
                }
            </ul>
        </nav>
    }


<hr />

@await Html.PartialAsync("_SponsoredListingPartial")

 }