@using DirectoryManager.Web.Constants
@{
    PageMeta.MetaContent = StringConstants.MetaTagNoIndex;
    PageMeta.Title = "Report a Problem – CAPTCHA";
    Layout = "_CenteredLayout";
}

@section PageContent {
    <h1>@PageMeta.Title</h1>
    <hr />

    <div asp-validation-summary="All" class="text-danger"></div>

    <form asp-action="CaptchaPost" asp-controller="ProblemReports" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="flowId" value="@ViewBag.FlowId" />

        @await Html.PartialAsync("_CaptchaBlock", (string)"report")

        <br />
        <button type="submit" class="btn btn-primary btn-cta">Continue</button>
    </form>
}
