@model DirectoryManager.Web.Models.ProblemReports.ProblemReportPayViewModel
@using DirectoryManager.Web.Constants
@{
    ViewData[StringConstants.MetaContent] = StringConstants.MetaTagNoIndex;
    ViewData[StringConstants.TitleHeader] = "Cover Our Review Costs (Optional)";
    Layout = "_CenteredLayout";
}

@section PageContent {
    <div class="page-header-bar">
        <h1 class="page-title">@ViewData[StringConstants.TitleHeader]</h1>
        @await Html.PartialAsync("_SiteLogo")
    </div>
    <hr />

    @if (this.TempData["PayError"] is string payError)
    {
        <div class="alert alert-danger">@payError</div>
    }

    @if (Model.AlreadyPaid)
    {
        <p><b>Thank you — a donation for this problem report has already been received.</b></p>
        <p>Your report is in the queue. There's nothing more you need to do.</p>
        @await Html.PartialAsync("_BackToHome")
        return;
    }

    <p>
        <b>Reporting a problem is free — you don't need to pay anything.</b>
        Your report about <b>@Model.EntryName</b> has already been submitted either way.
    </p>

    <div class="u-callout">
        <p>
            But due to the volume of reports, a donation helps us
            <b>investigate without a cost to us</b> — including any fees we'd incur while
            re-testing the listing. It is <b>not required</b>, but it does help us <b>prioritize</b> your report.
        </p>
        <p>Proceeding creates a <b>unique payment address tied to your problem report</b>, and you choose the amount.</p>
        <p><b>Payment does not change the outcome.</b> It only helps cover our review costs and prioritize the queue &mdash; what we do about the listing depends entirely on our review.</p>

        @if (Model.IsExchange)
        {
            <p>
                <b>If this is an exchange:</b> the most useful contribution is the
                <b>swapping fees for swapping between $1,000–$5,000</b> — not that amount of money,
                just the fees it would cost to swap it — so we can properly re-test the service.
            </p>
        }
    </div>

    <form method="post" action="~/problem-reports/pay/@Model.Token" class="u-m-0">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary btn-cta">Proceed to pay →</button>
    </form>

    <p class="u-note-sm u-mt-10px">
        You'll be taken to a secure Monero checkout. Paying is entirely optional — your report stays in the queue regardless.
    </p>

    @await Html.PartialAsync("_BackToHome")
}
