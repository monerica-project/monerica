@using DirectoryManager.Data.Enums
@using DirectoryManager.Web.Constants
@using DirectoryManager.Web.Helpers
@using DirectoryManager.Web.Models
@using DirectoryManager.Web.Models.Sponsorship
@using DirectoryManager.Web.Models.SponsoredListing
@using Microsoft.Extensions.Caching.Memory
@model SponsoredListingOffersViewModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor httpContextAccessor
@inject DirectoryManager.Common.Interfaces.IRateConversionService rateConversionService
@inject IMemoryCache memoryCache

@{
    PageMeta.Title = "Sponsored Listing Offers";
    Layout = "_CenteredLayout";

    var conversionResult = await CurrencyConversionHelper.GetConversionContextAsync(
        httpContextAccessor, memoryCache, rateConversionService);
    bool showConverted = conversionResult.showConverted;
    decimal conversionRate = conversionResult.conversionRate;
}

@section PageContent {
    <div class="page-header-bar">
        <h1 class="page-title">@PageMeta.Title</h1>
        @await Html.PartialAsync("_SiteLogo")
    </div>
    <hr />
    @await Html.PartialAsync("_BackToHome")
    <hr />

    <h2>Offers</h2>
    <p>
        What each placement costs, by length. Read across a row to compare durations.
        There are three placements: the <b>main sponsor</b> slot (sitewide), a <b>category page</b>
        (for example /exchanges) and a <b>subcategory page</b> (for example /exchanges/instant-swaps).
        Each category and subcategory page can have its own price; a page without one uses the
        <b>standard price</b>. Rates change with demand.
    </p>
    <p>
        <a class="btn btn-primary" href="~/sponsoredlisting">Buy Advertising</a>
        <a class="btn btn-info u-ml-8px" href="~/sponsor-options">Look up your listing&#39;s options &amp; prices &rarr;</a>
    </p>

    <p class="u-opacity-9">
        Want to see what advertisers have actually <strong>paid per day</strong>? Each row below links to a
        <strong>180-day price history</strong> chart for that placement &mdash; or
        <a href="~/sponsorship/pricing">explore all pricing history &rarr;</a>.
    </p>

    @if (Model.LastUpdatedDate.HasValue)
    {
        <p>
            Rates last updated on:
            @Model.LastUpdatedDate.Value.ToString(DirectoryManager.Common.Constants.StringConstants.DateTimeFormat)
        </p>
    }
    else
    {
        <p>Rates last updated on: (not available)</p>
    }

    @await Html.PartialAsync(
        "_SponsorshipOffersMatrix",
        new SponsorshipOffersTableViewModel
        {
            SponsorshipType = SponsorshipType.MainSponsor,
            Offers = Model.MainSponsorshipOffers,
            ConversionRate = conversionRate,
            SelectedCurrency = "XMR",
            ShowConverted = showConverted
        })

    @await Html.PartialAsync(
        "_SponsorshipOffersMatrix",
        new SponsorshipOffersTableViewModel
        {
            SponsorshipType = SponsorshipType.CategorySponsor,
            Offers = Model.CategorySponsorshipOffers,
            ConversionRate = conversionRate,
            SelectedCurrency = "XMR",
            ShowConverted = showConverted
        })

    @await Html.PartialAsync(
        "_SponsorshipOffersMatrix",
        new SponsorshipOffersTableViewModel
        {
            SponsorshipType = SponsorshipType.SubcategorySponsor,
            Offers = Model.SubCategorySponsorshipOffers,
            ConversionRate = conversionRate,
            SelectedCurrency = "XMR",
            ShowConverted = showConverted
        })
}