@model DirectoryManager.Data.Models.SubmissionBlockedDomain
@using DirectoryManager.Web.Constants;
@{
    PageMeta.Title = "Add Blocked Domain";
    Layout = "_CenteredLayout";
}

@section PageContent {

<h1>@PageMeta.Title</h1>

@await Html.PartialAsync("_AdminMenu")
<hr />

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Domain"></label>
        <input asp-for="Domain" class="form-control" placeholder="muse.ai" />
        <span asp-validation-for="Domain" class="text-danger"></span>
        <small class="u-opacity-85">
            A domain or any link on it (https://muse.ai/files/... becomes muse.ai). Subdomains are blocked too.
        </small>
    </div>

    <div class="form-group u-mt-10px">
        <label asp-for="Message"></label>
        <input asp-for="Message" class="form-control"
               placeholder="Leave blank to use the default message" />
        <span asp-validation-for="Message" class="text-danger"></span>
    </div>

    <div class="form-check u-mt-10px">
        <input asp-for="IsEnabled" class="form-check-input" />
        <label asp-for="IsEnabled" class="form-check-label"></label>
    </div>

    <div class="u-mt-10px">
        <button type="submit" class="btn btn-primary">Add</button>
        <a class="btn btn-secondary" href="~/submissionblockeddomains">Cancel</a>
    </div>
</form>
}
