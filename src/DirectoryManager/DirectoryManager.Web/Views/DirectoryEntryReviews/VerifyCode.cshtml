@using DirectoryManager.Web.Constants
@{
    PageMeta.Title = "Leave a Review – Verify Code";
    Layout = "_CenteredLayout";

    // This wrapper tells the shared partial where to post
    ViewBag.PostController = "DirectoryEntryReviews";
    ViewBag.PostAction = "VerifyCodePost";
}

@section PageContent {
    <h1>@PageMeta.Title</h1>
    <hr />

    @await Html.PartialAsync("_PgpVerifyCode")
}
