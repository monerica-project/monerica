@{
    var current = ViewContext.RouteData.Values["action"]?.ToString();
    (string Action, string Label)[] tabs =
    {
        ("Abandoned", "Abandoned checkouts"),
        ("Renewals", "Renewals & win-backs"),
        ("Prospects", "Never-sponsored prospects"),
    };
}
<p>
    @for (int i = 0; i < tabs.Length; i++)
    {
        if (i > 0) { <text> · </text> }
        if (tabs[i].Action == current) { <b>@tabs[i].Label</b> }
        else { <a asp-action="@tabs[i].Action">@tabs[i].Label</a> }
    }
    · <a href="~/admin/sponsor-interest">Sponsor interest</a>
    · <a href="~/admin/revenue">Revenue</a>
</p>
