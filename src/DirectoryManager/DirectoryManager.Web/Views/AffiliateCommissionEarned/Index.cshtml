@using DirectoryManager.Data.Enums
@model DirectoryManager.Web.Models.AffiliateCommissionPaid.AffiliateCommissionEarnedListViewModel
@{
    ViewData["Title"] = "Affiliate Commissions Earned";
    Layout = "_CenteredLayout";

    // Format a payment-currency total: USD as currency, crypto trimmed to significant decimals.
    Func<Currency, decimal, string> formatCurrencyTotal = (currency, amount) =>
        currency == Currency.USD
            ? amount.ToString("C")
            : $"{amount.ToString("0.########")} {currency}";

    // Stable display order: XMR, BTC, USD, then anything else, nonzero only.
    var currencyOrder = new[] { Currency.XMR, Currency.BTC, Currency.USD };
    var orderedCurrencyTotals = Model.CurrencyTotals
        .Where(kvp => kvp.Value != 0m)
        .OrderBy(kvp => Array.IndexOf(currencyOrder, kvp.Key) is var i && i >= 0 ? i : int.MaxValue)
        .ThenBy(kvp => kvp.Key.ToString())
        .ToList();
}

 @section PageContent {

<h1>Affiliate Commissions Earned</h1>
    @await Html.PartialAsync("_AdminMenu")
@if (TempData["Message"] != null)
{
    <p class="text-success"><strong>@TempData["Message"]</strong></p>
}

<p>
    <a asp-action="Create" class="btn btn-primary">+ New Commission</a>
    <a asp-action="Totals" class="btn btn-secondary">Totals by Entry</a>
</p>

<form method="get" asp-action="Index">
    <fieldset>
        <legend>Filter</legend>

        <label>Quick range:</label>
        <select name="quickRange" class="form-control">
            <option value="" selected="@(string.IsNullOrEmpty(Model.QuickRange))">Custom (use dates below)</option>
            <option value="currentyear" selected="@(Model.QuickRange == "currentyear")">Current year</option>
            <option value="last1year" selected="@(Model.QuickRange == "last1year")">Last 1 year</option>
        </select>

        <label>Directory Entry:</label>
        <select name="directoryEntryId" class="form-control" asp-items="Model.DirectoryEntries">
            <option value="">— All —</option>
        </select>

        <label>Start:</label>
        <input type="date" name="startDate" class="form-control"
               value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />

        <label>End:</label>
        <input type="date" name="endDate" class="form-control"
               value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />

        <label>Page size:</label>
        <input class="form-control u-w-6em" type="number" name="pageSize" value="@Model.PageSize" min="1" max="200" />

        <button type="submit" class="btn btn-primary">Apply</button>
        <a asp-action="Index" class="btn btn-secondary">Reset</a>
    </fieldset>
    <p class="text-muted">
        Pick a quick range to auto-fill the dates, or leave it on “Custom” and set Start/End yourself.
    </p>
</form>

<p>
    <strong>Total rows:</strong> @Model.TotalCount
    &nbsp;|&nbsp;
    <strong>Total USD:</strong> @Model.TotalUsdValue.ToString("C")
    @if (orderedCurrencyTotals.Any())
    {
        <text>&nbsp;(</text>@for (var i = 0; i < orderedCurrencyTotals.Count; i++)
        {
            var kvp = orderedCurrencyTotals[i];
            @formatCurrencyTotal(kvp.Key, kvp.Value)
            if (i < orderedCurrencyTotals.Count - 1)
            {
                <text>, </text>
            }
        }<text>)</text>
    }
</p>
    <div class="table-wrapper">
      
<table class="table">
    <thead>
        <tr>
            <th>Date (UTC)</th>
            <th>Directory Entry</th>
            <th class="u-text-right">USD</th>
            <th>Currency</th>
            <th class="u-text-right">Amount</th>
            <th>Transaction ID</th>
            <th>Note</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Items.Any())
        {
            <tr>
                <td colspan="8"><em>No commissions recorded.</em></td>
            </tr>
        }
        @foreach (var c in Model.Items)
        {
            <tr>
                <td>@c.CommissionDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@(c.DirectoryEntry?.Name ?? $"#{c.DirectoryEntryId}")</td>
                <td class="u-text-right">@c.UsdValue.ToString("C")</td>
                <td>@c.PaymentCurrency</td>
                <td class="u-text-right">@c.PaymentCurrencyAmount.ToString("0.########")</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(c.TransactionId))
                    {
                        <code>@c.TransactionId</code>
                    }
                </td>
                <td>@c.Note</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@c.AffiliateCommissionEarnedId">Edit</a>
                    |
                    <a asp-action="Delete" asp-route-id="@c.AffiliateCommissionEarnedId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@if (Model.TotalPages > 1)
{
    <nav>
        <p>
            Page @Model.Page of @Model.TotalPages
            &nbsp;

            @if (Model.HasPrevious)
            {
                <a asp-action="Index"
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-directoryEntryId="@Model.DirectoryEntryId"
                   asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                   asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))">
                    &laquo; Previous
                </a>
            }

            &nbsp;

            @if (Model.HasNext)
            {
                <a asp-action="Index"
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-directoryEntryId="@Model.DirectoryEntryId"
                   asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                   asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))">
                    Next &raquo;
                </a>
            }
        </p>
    </nav>
}
}