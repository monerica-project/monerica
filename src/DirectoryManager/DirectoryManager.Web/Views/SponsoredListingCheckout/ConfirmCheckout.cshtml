@using DirectoryManager.Web.Constants
@using DirectoryManager.Web.Models
@using System.Globalization
@using DirectoryManager.Data.Enums
@using DirectoryManager.Web.Helpers
@using Microsoft.Extensions.Caching.Memory
@model DirectoryManager.Web.Models.ConfirmSelectionViewModel
@inject DirectoryManager.Web.Services.Interfaces.ICacheService _cacheHelper
@using DirectoryManager.Utilities.Helpers
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor httpContextAccessor
@inject DirectoryManager.Common.Interfaces.IRateConversionService rateConversionService
@inject IMemoryCache memoryCache

@{
    ViewData[StringConstants.TitleHeader] = "Confirm Selection";
    Layout = "_CenteredLayout";

    Guid? reservationGuid = ViewBag.ReservationGuid is Guid g ? g : (Guid?)null;
    DateTime? reservationExpiry = ViewBag.ReservationExpiresUtc is DateTime d ? d : (DateTime?)null;
    int? minutesLeft = reservationExpiry.HasValue
        ? (int?)Math.Max(0, (int)Math.Ceiling((reservationExpiry.Value - DateTime.UtcNow).TotalMinutes))
        : null;

    var conversionResult = await CurrencyConversionHelper.GetConversionContextAsync(
        httpContextAccessor, memoryCache, rateConversionService, true);
    bool showConverted = conversionResult.showConverted;
    decimal conversionRate = conversionResult.conversionRate;

    Model.SelectedDirectoryEntry.IsSponsored = true;

    var prefillEmail = ViewBag.PrefillEmail as string ?? string.Empty;

    var usdCulture = new CultureInfo(DirectoryManager.Common.Constants.StringConstants.DefaultCulure);
    var effectivePrice = Model.Offer.HasExistingSponsorPerk ? Model.Offer.DiscountedUSDPrice : Model.Offer.USDPrice;
}

@section PageContent {
    <h1>@ViewData[StringConstants.TitleHeader]</h1>
    <hr />

    @if (reservationGuid.HasValue && reservationExpiry.HasValue)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Reserved checkout:</strong>
            Your slot is held until
            <b>@reservationExpiry.Value.ToString(DirectoryManager.Common.Constants.StringConstants.DateTimeFormat)</b> UTC
            (@minutesLeft minute@(minutesLeft == 1 ? "" : "s") left).
            Complete purchase before it expires to keep your place in line.
        </div>
    }

    <div>
        @if (Model.CanCreateSponsoredListing)
        {
            <h2>Selected Listing</h2>
            <ul class="blank_list_item">
                @await Html.PartialAsync("_DirectoryEntryPartial", Model.SelectedDirectoryEntry)
            </ul>

            <hr />
            <h2>Your Order</h2>
            <br />
            <table>
                <tr>
                    <td><b>Sponsorship Type:</b></td>
                    <td>@DirectoryManager.Utilities.Helpers.EnumHelper.GetDescription(Model.Offer.SponsorshipType)</td>
                </tr>
                @if (Model.Offer.SponsorshipType == SponsorshipType.CategorySponsor && ViewBag.PurchaseCategoryName != null)
                {
                    <tr>
                        <td><b>Category:</b></td>
                        <td>@ViewBag.PurchaseCategoryName</td>
                    </tr>
                }
                else if (Model.Offer.SponsorshipType == SponsorshipType.SubcategorySponsor && ViewBag.PurchaseSubcategoryScope != null)
                {
                    <tr>
                        <td><b>Category &amp; Subcategory:</b></td>
                        <td>@ViewBag.PurchaseSubcategoryScope</td>
                    </tr>
                }
                <tr>
                    <td><b>Days:</b></td>
                    <td>@Model.Offer.Days</td>
                </tr>
                <tr>
                    <td><b>Description:</b></td>
                    <td>@Model.Offer.Description</td>
                </tr>
                @if (Model.Offer.HasExistingSponsorPerk)
                {
                    <tr>
                        <td><b>Market price:</b></td>
                        <td>
                            <s class="price-strike">@Model.Offer.USDPrice.ToString(DirectoryManager.Common.Constants.StringConstants.CurrentFormat, usdCulture) @Currency.USD</s>
                        </td>
                    </tr>
                    <tr>
                        <td><b>Existing sponsor perk:</b></td>
                        <td class="text-danger">@Model.Offer.DiscountPercent.ToString("0.##")% off</td>
                    </tr>
                }
                <tr>
                    <td><b>Price:</b></td>
                    <td>
                        <b>@effectivePrice.ToString(
                            DirectoryManager.Common.Constants.StringConstants.CurrentFormat,
                            usdCulture)
                        @Currency.USD</b>
                        @if (showConverted)
                        {
                            <i>
                                (Approximately:
                                @DirectoryManager.Utilities.Helpers.CurrencyFormatter.Format(
                                    effectivePrice,
                                    conversionRate,
                                    conversionResult.selectedCurrency,
                                    true))
                            </i>
                        }
                    </td>
                </tr>
            </table>

            @if (Model.IsExtension)
            {
                <br />
                <p>These days will be added to the current sponsored listing.</p>
            }

            <form method="post" action="~/sponsoredlisting/confirmcheckout">
                @Html.AntiForgeryToken()

                <hr />
                <h3>Payment Method</h3>
                <p>Monero (XMR) only.</p>

                @* Only one method is offered, so show it as a label instead of a single-choice
                   radio. The hidden field still submits the internal BTCPayServerNoJs processor. *@
                <input type="hidden" name="selectedProcessor" value="BTCPayServerNoJs" />
                <div class="u-mb-16px">
                    <strong>Custom Monero Checkout</strong>
                    <span class="text-muted u-fs-085em">(self-hosted, no JavaScript required)</span>
                </div>

                <div class="alert alert-info" role="alert">
                    <strong>&#9888; Important &mdash; Monero wallet sync</strong><br />
                    Before sending XMR payment, make sure your Monero wallet is <strong>fully synced to the current blockchain height</strong>.
                    The invoice will expire after 15 minutes.
                    Sync your wallet <em>before</em> you scan the QR code or copy the address.
                </div>

                <hr />
                <h3>Optional</h3>
                <div class="form-group">
                    <p>Receive a reminder before your listing expires so you can renew in time.</p>
                    <label>Email (optional)</label>
                    <input
 name="email"
 type="email"
 value="@prefillEmail"
 placeholder="yourname@email.com"
 autocomplete="off"
 class="form-control input-width u-w-18pct" />
                    <div class="text-danger">@Html.ValidationMessage("Email")</div>
                </div>

                <hr />

                <div>
                    @await Html.PartialAsync("_CaptchaBlock", "sponsoredlisting-confirmcheckout")
                    <div class="text-danger u-mt-4px">
                        @Html.ValidationMessage("Captcha")
                    </div>
                </div>

                <hr />

                <input name="rsvId" type="hidden" value="@reservationGuid" />
                <input type="hidden" name="directoryEntryId" value="@Model.SelectedDirectoryEntry.DirectoryEntryId" />
                <input type="hidden" name="selectedOfferId" value="@Model.Offer.SponsoredListingOfferId" />

                <button class="btn btn-cta" type="submit">Purchase Listing</button>
            </form>
        }
        else
        {
            @await Html.PartialAsync("_AdSpaceFull", new ListingInventoryModel
            {
                CanCreateSponsoredListing = Model.CanCreateSponsoredListing,
                NextListingExpiration = Model.NextListingExpiration,
            })
        }
    </div>
}