﻿@using DirectoryManager.Web.Constants
@using DirectoryManager.Web.Models
@using System.Globalization
@using DirectoryManager.Data.Enums
@using DirectoryManager.Web.Helpers
@using DirectoryManager.Web.Models.SponsoredListing
@using Microsoft.Extensions.Caching.Memory
@model IEnumerable<SponsoredListingOfferModel>
@inject DirectoryManager.Web.Services.Interfaces.ICacheService _cacheHelper
@using DirectoryManager.Utilities.Helpers
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor httpContextAccessor
@inject DirectoryManager.Common.Interfaces.IRateConversionService rateConversionService
@inject IMemoryCache memoryCache

@{
    Layout = "_CenteredLayout";
    ViewData[StringConstants.TitleHeader] = "Select Listing Duration";
    ViewData[StringConstants.IsIndexable] = false;

    var offersList = Model.ToList();
    int defaultChoiceIndex = 0;

    Guid? reservationGuid = ViewBag.ReservationGuid is Guid g ? g : (Guid?)null;
    DateTime? reservationExpiresUtc = ViewBag.ReservationExpiresUtc is DateTime d ? d : (DateTime?)null;
    int? minutesLeft = reservationExpiresUtc.HasValue
        ? (int?)Math.Max(0, (int)Math.Ceiling((reservationExpiresUtc.Value - DateTime.UtcNow).TotalMinutes))
        : null;

    var conversionResult = await CurrencyConversionHelper.GetConversionContextAsync(
        httpContextAccessor, memoryCache, rateConversionService);
    bool showConverted = conversionResult.showConverted;
    decimal conversionRate = conversionResult.conversionRate;

    var backUrl = Url.Content($"~/sponsoredlisting/selectlisting?sponsorshipType={ViewBag.SponsorshipType}"
        + (ViewBag.SubCategoryId != null ? $"&subCategoryId={ViewBag.SubCategoryId}" : string.Empty)
        + (ViewBag.CategoryId != null ? $"&categoryId={ViewBag.CategoryId}" : string.Empty)
        + (reservationGuid.HasValue ? $"&rsvId={reservationGuid}" : string.Empty));

    decimal? baselineUsd = offersList.Count > 0 ? offersList[0].USDPrice : (decimal?)null;
    var usdCulture = new CultureInfo(DirectoryManager.Common.Constants.StringConstants.DefaultCulure);

    decimal? baselinePerDay = (offersList.Count > 0 && offersList[0].Days > 0)
        ? offersList[0].USDPrice / offersList[0].Days
        : (decimal?)null;

    decimal perkPct = ViewBag.ExistingSponsorPerkPercent is decimal lp ? lp : 0m;
    SponsorshipType? perkBasis = ViewBag.ExistingSponsorPerkBasisTier as SponsorshipType?;
    string perkBasisLabel = perkBasis.HasValue
        ? DirectoryManager.Utilities.Helpers.EnumHelper.GetDescription(perkBasis.Value)
        : "sponsor";
}

@section PageContent {
    <h1>@ViewData[StringConstants.TitleHeader]</h1>

    <hr />
    <a href="@backUrl">&lt; back</a>
    <hr />

    @* Shown only when the buyer already holds an active reservation for this slot (e.g. after going
       back to change the duration) — so they see the countdown. First-time visitors have no hold. *@
    @if (reservationGuid.HasValue && reservationExpiresUtc.HasValue)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Reserved checkout:</strong>
            Your slot is held until
            <b>@reservationExpiresUtc.Value.ToString(DirectoryManager.Common.Constants.StringConstants.DateTimeFormat)</b> UTC
            (@minutesLeft minute@(minutesLeft == 1 ? "" : "s") left).
            You can change the duration and continue under this reservation.
        </div>
    }

    <p><b>Name:</b> @ViewBag.DirectoryEntrName</p>
    <p><b>Sponsorship Type:</b> @DirectoryManager.Utilities.Helpers.EnumHelper.GetDescription(ViewBag.SponsorshipType)</p>

    @if (ViewBag.SponsorshipType == DirectoryManager.Data.Enums.SponsorshipType.SubcategorySponsor)
    {
        <p><b>Subcategory:</b> @ViewBag.Subcategory</p>
    }
    else if (ViewBag.SponsorshipType == DirectoryManager.Data.Enums.SponsorshipType.CategorySponsor)
    {
        <p><b>Category:</b> @ViewBag.Category</p>
    }

    @{
        var chartType = (SponsorshipType)ViewBag.SponsorshipType;
        var chartTypeDesc = DirectoryManager.Utilities.Helpers.EnumHelper.GetDescription(chartType);
        var listingSubcat = ViewBag.ListingSubcategory as string;
        var hasSubHistory = ViewBag.HasSubcategoryPricingHistory is bool b && b;
    }
    <div class="u-mt-10px u-mb-8px" style="max-width:640px;">
        <p class="u-m-6px-0-12px-0">
            <strong>Why this price?</strong> The <strong>bars</strong> are the average paid per day across
            <strong>all @chartTypeDesc</strong> slots over the last 180&nbsp;days.
            @if (hasSubHistory)
            {
                <text>The <strong>black dotted line</strong> is
                <strong>your subcategory@(string.IsNullOrWhiteSpace(listingSubcat) ? "" : $" — {listingSubcat}")</strong>,
                which is how pricing is set &mdash; so you can see where your niche sits versus the overall
                @chartTypeDesc average.</text>
            }
        </p>
        <img class="u-w-100pct"
             style="max-width:640px;height:auto;border:1px solid #ddd;border-radius:4px;"
             src="@Url.Action("PricingTrendsChart", "SponsoredListingCheckout", new { sponsorshipType = ViewBag.SponsorshipType, listingSubCategoryId = ViewBag.ListingSubCategoryId, v = DateTime.UtcNow.ToString("yyyyMMdd") })"
             alt="Average daily price for this placement over the last 180 days, with your subcategory highlighted" />
    </div>

    <br />

    @if (perkPct > 0m)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Existing sponsor perk &mdash; <span class="text-danger">@perkPct.ToString("0.##")% off</span>.</strong>
            Because this listing is already an active <strong>@perkBasisLabel</strong>, you get
            <span class="text-danger">@perkPct.ToString("0.##")% off</span> this placement. Every market price below is
            struck through and shown with your discounted price.
        </div>
    }

    <form method="post" action="~/sponsoredlisting/selectduration">
        @Html.AntiForgeryToken()

        <input type="hidden" name="directoryEntryId" value="@ViewBag.DirectoryEntryId" />
        @if (reservationGuid.HasValue)
        {
            <input type="hidden" name="rsvId" value="@reservationGuid" />
        }

        <div class="form-group">
            <label>Available Options:</label>

            @for (var i = 0; i < offersList.Count; i++)
            {
                var offer = offersList[i];

                var finalPrice = offer.HasExistingSponsorPerk ? offer.DiscountedUSDPrice : offer.USDPrice;
                decimal? marketPerDay = offer.Days > 0 ? offer.USDPrice / offer.Days : (decimal?)null;
                decimal? discountedPerDay = offer.Days > 0 ? finalPrice / offer.Days : (decimal?)null;

                // Combined TOTAL off vs the 30-day base rate — folds the longer-term volume discount AND
                // the existing-sponsor perk into one figure, so the real total percent off is clear.
                int? totalPctOff = null;
                decimal? totalSaved = null;
                if (baselinePerDay.HasValue && baselinePerDay.Value > 0)
                {
                    var baselineTotal = baselinePerDay.Value * offer.Days;
                    totalSaved = baselineTotal - finalPrice;
                    totalPctOff = (int)Math.Round((totalSaved.Value / baselineTotal) * 100m, 0, MidpointRounding.AwayFromZero);
                }

                <div class="form-check u-mb-8px">
                    <label class="form-check-label u-flex-items-center-gap-8px-flexwrap-wrap">
                        <input class="form-check-input"
                               type="radio"
                               name="selectedOfferId"
                               value="@offer.SponsoredListingOfferId"
                        @(i == defaultChoiceIndex ? "checked" : null) />

                        <span>
                            <b>@offer.Days</b>-Days &ndash;
                            @if (offer.HasExistingSponsorPerk)
                            {
                                <s class="price-strike">@offer.USDPrice.ToString(DirectoryManager.Common.Constants.StringConstants.CurrentFormat, usdCulture)</s>
                                <b>@offer.DiscountedUSDPrice.ToString(DirectoryManager.Common.Constants.StringConstants.CurrentFormat, usdCulture) @Currency.USD</b>
                            }
                            else
                            {
                                @offer.USDPrice.ToString(DirectoryManager.Common.Constants.StringConstants.CurrentFormat, usdCulture) @Currency.USD
                            }
                        </span>

                        @if (showConverted)
                        {
                            <span>
                                &mdash;
                                @DirectoryManager.Utilities.Helpers.CurrencyFormatter.Format(
                                    offer.HasExistingSponsorPerk ? offer.DiscountedUSDPrice : offer.USDPrice,
                                    conversionRate,
                                    conversionResult.selectedCurrency,
                                    true)
                            </span>
                        }

                        @if (marketPerDay.HasValue)
                        {
                            <span class="u-opacity-8">
                                &mdash;
                                @if (offer.HasExistingSponsorPerk && discountedPerDay.HasValue)
                                {
                                    <s class="price-strike">@marketPerDay.Value.ToString(DirectoryManager.Common.Constants.StringConstants.CurrentFormat, usdCulture)</s>
                                    <b>@discountedPerDay.Value.ToString(DirectoryManager.Common.Constants.StringConstants.CurrentFormat, usdCulture)/day</b>
                                }
                                else
                                {
                                    @marketPerDay.Value.ToString(DirectoryManager.Common.Constants.StringConstants.CurrentFormat, usdCulture)<text>/day</text>
                                }
                            </span>
                        }

                        @if (totalPctOff.HasValue && totalPctOff.Value > 0 && totalSaved.HasValue && totalSaved.Value > 0)
                        {
                            <span class="text-danger u-ml-6px">
                                (Total @(totalPctOff)% off, save @totalSaved.Value.ToString(DirectoryManager.Common.Constants.StringConstants.CurrentFormat, usdCulture))
                            </span>
                        }

                        @if (i == 0)
                        {
                            <span class="badge bg-secondary u-ml-6px">Market price</span>
                        }
                    </label>
                </div>
            }
        </div>

        @if (offersList.Count > 0)
        {
            <button type="submit" class="btn btn-primary btn-cta">Select</button>
        }
        else
        {
            <p><i>No options</i></p>
        }
    </form>
}