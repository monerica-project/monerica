﻿@using DirectoryManager.Web.Constants
@using DirectoryManager.Web.Models
@using System.Globalization
@using DirectoryManager.Data.Enums
@using DirectoryManager.Web.Helpers
@using DirectoryManager.Web.Models.SponsoredListing
@using Microsoft.Extensions.Caching.Memory
@model IEnumerable<SponsoredListingOfferModel>
@inject DirectoryManager.Web.Services.Interfaces.ICacheService _cacheHelper
@using DirectoryManager.Utilities.Helpers
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor httpContextAccessor
@inject DirectoryManager.Common.Interfaces.IRateConversionService rateConversionService
@inject IMemoryCache memoryCache

@{
    Layout = "_CenteredLayout";
    PageMeta.Title = "Choose Your Sponsorship Length";
    PageMeta.IsIndexable = false;

    var offersList = Model.ToList();
    int defaultChoiceIndex = 0;

    Guid? reservationGuid = ViewBag.ReservationGuid is Guid g ? g : (Guid?)null;
    DateTime? reservationExpiresUtc = ViewBag.ReservationExpiresUtc is DateTime d ? d : (DateTime?)null;
    int? minutesLeft = reservationExpiresUtc.HasValue
        ? (int?)Math.Max(0, (int)Math.Ceiling((reservationExpiresUtc.Value - DateTime.UtcNow).TotalMinutes))
        : null;

    var conversionResult = await CurrencyConversionHelper.GetConversionContextAsync(
        httpContextAccessor, memoryCache, rateConversionService);
    bool showConverted = conversionResult.showConverted;
    decimal conversionRate = conversionResult.conversionRate;

    // Back = this listing's sponsorship options (every placement type it can buy), where buyers
    // come from. The generic listing picker it used to point to shows nothing useful here.
    var backUrl = Url.Content($"~/sponsorship/options/{ViewBag.DirectoryEntryId}");

    decimal? baselineUsd = offersList.Count > 0 ? offersList[0].USDPrice : (decimal?)null;
    var usdCulture = new CultureInfo(DirectoryManager.Common.Constants.StringConstants.DefaultCulure);

    decimal? baselinePerDay = (offersList.Count > 0 && offersList[0].Days > 0)
        ? offersList[0].USDPrice / offersList[0].Days
        : (decimal?)null;

    decimal perkPct = ViewBag.ExistingSponsorPerkPercent is decimal lp ? lp : 0m;
    SponsorshipType? perkBasis = ViewBag.ExistingSponsorPerkBasisTier as SponsorshipType?;
    string perkBasisLabel = perkBasis.HasValue
        ? DirectoryManager.Utilities.Helpers.EnumHelper.GetDescription(perkBasis.Value)
        : "sponsor";
}

@section PageContent {
    @{
        var chartType = (SponsorshipType)ViewBag.SponsorshipType;
        var chartTypeDesc = DirectoryManager.Utilities.Helpers.EnumHelper.GetDescription(chartType);
        var placementLabel = ViewBag.PlacementLabel as string;
        var hasPlacementHistory = ViewBag.HasPlacementPricingHistory is bool b && b;
        var placementNoun = chartType == SponsorshipType.CategorySponsor ? "category page" : "subcategory page";

        // Where the sponsorship shows, in plain words.
        string placementText = chartType switch
        {
            SponsorshipType.CategorySponsor => $"the {ViewBag.Category} category page",
            SponsorshipType.SubcategorySponsor => $"the {ViewBag.Subcategory} subcategory page",
            _ => "every page of the site (Main Sponsor)",
        };

        // Same colours the chart draws with (ChartColors), so the words match the lines/bars.
        var barHex = DirectoryManager.Web.Charting.ChartColors.TypeNeonHex(chartType);
        var barName = DirectoryManager.Web.Charting.ChartColors.TypeNeonName(chartType);
        var nowHex = DirectoryManager.Web.Charting.ChartColors.DarkNowHex;
        var subHex = DirectoryManager.Web.Charting.ChartColors.DarkInkHex;

        DateTime? currentEndsUtc = ViewBag.CurrentSponsorshipEndsUtc as DateTime?;
        decimal? recentMin = ViewBag.RecentPaidMinPerDay as decimal?;
        decimal? recentMax = ViewBag.RecentPaidMaxPerDay as decimal?;
        int recentCount = ViewBag.RecentPaidCount is int rc ? rc : 0;
        bool recentIsPlacement = ViewBag.RecentPaidIsPlacement is bool rp && rp;
        string Usd(decimal v) => v.ToString(DirectoryManager.Common.Constants.StringConstants.CurrentFormat, usdCulture);
    }

    <h1>Choose Your Sponsorship Length</h1>

    <hr />
    <a href="@backUrl">&lt; back to sponsorship options</a>
    <hr />

    @* Shown only when the buyer already holds an active reservation for this slot (e.g. after going
       back to change the duration) — so they see the countdown. First-time visitors have no hold. *@
    @if (reservationGuid.HasValue && reservationExpiresUtc.HasValue)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Reserved checkout:</strong>
            Your slot is held until
            <b>@reservationExpiresUtc.Value.ToString(DirectoryManager.Common.Constants.StringConstants.DateTimeFormat)</b> UTC
            (@minutesLeft minute@(minutesLeft == 1 ? "" : "s") left).
            You can change the duration and continue under this reservation.
        </div>
    }

    <p class="u-m-6px-0-12px-0">
        <b>@ViewBag.DirectoryEntrName</b> &middot; @chartTypeDesc &middot; @placementText
        @if (currentEndsUtc.HasValue)
        {
            <br /><span class="u-opacity-8">Already sponsoring until <b>@currentEndsUtc.Value.ToString(DirectoryManager.Common.Constants.StringConstants.FriendlyDateFormat)</b>; new time starts after that.</span>
        }
        @if (recentMin.HasValue && recentMax.HasValue)
        {
            <br /><span class="u-opacity-8">Recently paid: @(recentMin.Value == recentMax.Value ? Usd(recentMin.Value) : $"{Usd(recentMin.Value)}–{Usd(recentMax.Value)}")/day (last 180 days).
            <a href="#price-history">Price history &darr;</a></span>
        }
    </p>

    @if (perkPct > 0m)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Existing sponsor perk &mdash; <span class="text-danger">@perkPct.ToString("0.##")% off</span>.</strong>
            Because this listing is already an active <strong>@perkBasisLabel</strong>, you get
            <span class="text-danger">@perkPct.ToString("0.##")% off</span> this placement. It&rsquo;s included in the prices
            and savings below.
        </div>
    }

    <form method="post" action="~/sponsoredlisting/selectduration">
        @Html.AntiForgeryToken()

        <input type="hidden" name="directoryEntryId" value="@ViewBag.DirectoryEntryId" />
        @if (ViewBag.ScopeSubCategoryId != null)
        {
            <input type="hidden" name="scopeSubCategoryId" value="@ViewBag.ScopeSubCategoryId" />
        }
        @if (reservationGuid.HasValue)
        {
            <input type="hidden" name="rsvId" value="@reservationGuid" />
        }

        <div class="u-overflowx-auto" style="max-width:640px;">
        <table class="table table-sm" style="margin-bottom:12px;">
            <thead>
                <tr>
                    <th></th>
                    <th>Length</th>
                    <th class="text-right">Total</th>
                    <th class="text-right">Per day</th>
                    <th class="text-right">Savings</th>
                </tr>
            </thead>
            <tbody>
            @for (var i = 0; i < offersList.Count; i++)
            {
                var offer = offersList[i];
                var inputId = $"offer-{offer.SponsoredListingOfferId}";

                var finalPrice = offer.HasExistingSponsorPerk ? offer.DiscountedUSDPrice : offer.USDPrice;
                decimal? discountedPerDay = offer.Days > 0 ? finalPrice / offer.Days : (decimal?)null;

                // Combined TOTAL off vs the shortest option's per-day rate: folds the longer-term volume
                // discount AND the existing-sponsor perk into one figure.
                // The struck-through "full price" is these days at the shortest option's per-day rate,
                // a real price, so the strikethrough is honest.
                int? totalPctOff = null;
                decimal? fullPrice = null;
                if (baselinePerDay.HasValue && baselinePerDay.Value > 0)
                {
                    var baselineTotal = Math.Round(baselinePerDay.Value * offer.Days, 2);
                    if (baselineTotal - finalPrice >= 0.01m)
                    {
                        fullPrice = baselineTotal;
                        totalPctOff = (int)Math.Round(((baselineTotal - finalPrice) / baselineTotal) * 100m, 0, MidpointRounding.AwayFromZero);
                    }
                }

                <tr>
                    <td style="width:28px;">
                        <input type="radio" id="@inputId" name="selectedOfferId" value="@offer.SponsoredListingOfferId" @(i == defaultChoiceIndex ? "checked" : null) />
                    </td>
                    <td><label for="@inputId" style="margin:0;cursor:pointer;font-weight:600;">@offer.Days days</label></td>
                    <td class="text-right">
                        @if (fullPrice.HasValue)
                        {
                            <s class="price-strike u-opacity-8">@Usd(fullPrice.Value)</s>
                        }
                        <b>@Usd(finalPrice)</b>
                        @if (showConverted)
                        {
                            <br /><small class="u-opacity-8">@DirectoryManager.Utilities.Helpers.CurrencyFormatter.Format(finalPrice, conversionRate, conversionResult.selectedCurrency, true)</small>
                        }
                    </td>
                    <td class="text-right">
                        @if (discountedPerDay.HasValue)
                        {
                            @Usd(discountedPerDay.Value)
                        }
                    </td>
                    <td class="text-right">
                        @if (totalPctOff.HasValue && totalPctOff.Value > 0)
                        {
                            <b style="color:#39d96b;">Save @(totalPctOff)%</b>
                        }
                        else
                        {
                            <span class="u-opacity-8">&mdash;</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>

        @if (offersList.Count > 0)
        {
            @* Asked before the slot is held; skipped when this buyer already holds it. *@
            @if (!reservationGuid.HasValue)
            {
                @if (Context.Request.Query["captcha"] == "0")
                {
                    <div class="alert alert-danger" role="alert">Incorrect CAPTCHA. Please try again.</div>
                }

                @await Html.PartialAsync("_CaptchaBlock", "sponsoredlisting-selectduration")
            }

            <button type="submit" class="btn btn-primary btn-cta">Continue to review &amp; pay</button>
            <span class="u-opacity-8 u-ml-6px">Nothing is charged yet.</span>
        }
        else
        {
            <p><i>No options</i></p>
        }
    </form>

    <hr />

    <h2 id="price-history">Price history</h2>
    <div class="u-mt-10px u-mb-8px" style="max-width:640px;">
        <p class="u-m-6px-0-12px-0">
            The <strong style="color:@nowHex;">yellow dashed line</strong> is
            <strong>today&rsquo;s 30-day price for this spot</strong>@(string.IsNullOrWhiteSpace(placementLabel) ? "" : $" ({placementLabel})"),
            per day, the same price as the lengths above.
            Each <strong style="color:@barHex;">@barName dot</strong> is a @chartTypeDesc spot someone bought in the last
            180&nbsp;days, shown on the day it was bought at its price per day before any personal discount
            (renewals bought ahead of time included). Filled dots are 30-day purchases; open dots are 60&ndash;365 day
            purchases, which cost less per day.
            @if (chartType != SponsorshipType.MainSponsor)
            {
                <text>Prices are set per @placementNoun; a page without its own price uses the standard price.&#32;</text>
            }
            @if (hasPlacementHistory)
            {
                <text>Dots with a <strong style="color:@subHex;">white ring</strong> were bought for
                <strong>this @placementNoun@(string.IsNullOrWhiteSpace(placementLabel) ? "" : $" ({placementLabel})")</strong>.</text>
            }
        </p>
        <img class="u-w-100pct"
             style="max-width:640px;height:auto;border:1px solid #ddd;border-radius:4px;"
             src="@Url.Action("PricingTrendsChart", "SponsoredListingCheckout", new { sponsorshipType = ViewBag.SponsorshipType, placementId = ViewBag.PlacementId, v = DateTime.UtcNow.ToString(DirectoryManager.Common.Constants.StringConstants.CompactDateFormat) })"
             alt="Today's price for this spot as a dashed line, with purchases from the last 180 days as dots" />
    </div>
}
