@using DirectoryManager.Web.Constants
@inject DirectoryManager.Web.Services.Interfaces.ICacheService cacheHelper
@{
    PageMeta.MetaContent = StringConstants.MetaTagNoIndex;
    PageMeta.Title = "Verification Request Received";
    Layout = "_CenteredLayout";
}

@section PageContent {
    <div class="page-header-bar">
        <h1 class="page-title">@PageMeta.Title</h1>
        @await Html.PartialAsync("_SiteLogo")
    </div>
    <hr />

    <p><b>Thank you for requesting a verification — your message was received.</b></p>
    <p>We review requests manually and prioritize by demand. Verification is free — you don't need to pay anything.</p>

    @await Html.PartialAsync("_BackToHome")
}
