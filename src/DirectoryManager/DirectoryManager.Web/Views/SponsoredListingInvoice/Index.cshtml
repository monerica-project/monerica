@using DirectoryManager.Utilities.Helpers
@using DirectoryManager.Web.Constants;
@model IEnumerable<DirectoryManager.Data.Models.SponsoredListings.SponsoredListingInvoice>

@{
    PageMeta.Title = "Invoices";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = ViewBag.PageSize ?? IntegerConstants.DefaultPageSize;
    int totalItems = ViewBag.TotalItems ?? 0;
    int totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
    bool isPaidOnly = ViewBag.IsPaidOnly ?? false;
}

@{
    Layout = "_CenteredLayout";
}


@section PageContent {

<h1>@(isPaidOnly ? "Paid Invoices" : "All Invoices")</h1>

@await Html.PartialAsync("_AdminMenu")

<!-- Links to toggle between all invoices and paid invoices -->
<a href="@Url.Action("Index")">All Invoices</a> |
<a href="@Url.Action("PaidIndex")">Paid Invoices</a> | 
<a href="@Url.Action("Report")">Report</a>

<hr />

<div class="table-wrapper">
    <table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Listing</th>
            <th>Date</th>
            <th>Payment Status</th>
            <th>Paid</th>
            <th>Test</th>
        </tr>
    </thead>
    <tbody>
        @{
            var endedStatuses = new HashSet<DirectoryManager.Data.Enums.PaymentStatus>
        {
        DirectoryManager.Data.Enums.PaymentStatus.Failed,
        DirectoryManager.Data.Enums.PaymentStatus.Expired
        };
        }
        @foreach (var invoice in Model)
        {
            <tr style="@(invoice.IsTest ? "opacity:.55;" : null)">
                <td>
                    <a href="@Url.Action("Details", new { id = invoice.SponsoredListingInvoiceId })">@invoice.SponsoredListingInvoiceId</a>
                </td>
                <td>
                    @if (invoice.DirectoryEntry != null)
                    {
                        <a href="@Url.Action("Advertiser", new { directoryEntryId = invoice.DirectoryEntryId })">@invoice.DirectoryEntry.Name</a>
                    }
                </td>
                <td>@invoice.CreateDate.ToString(DirectoryManager.Common.Constants.StringConstants.DateFormat)</td>
                <td>
                    @if (invoice.PaymentStatus == DirectoryManager.Data.Enums.PaymentStatus.Paid)
                    {
                        <text>&#x1F4B0;</text> @EnumHelper.GetDescription(invoice.PaymentStatus)
                    }
                    else if (endedStatuses.Contains(invoice.PaymentStatus))
                    {
                        <i>@EnumHelper.GetDescription(invoice.PaymentStatus)</i>
                    }
                    else
                    {
                        @EnumHelper.GetDescription(invoice.PaymentStatus)
                    }
                </td>
                <td style="white-space:nowrap;">
                    @* Asked price on top; what actually came in (amount + coin) underneath. *@
                    @invoice.Amount.ToString(DirectoryManager.Common.Constants.StringConstants.CurrentFormat) <small class="u-color-888">@invoice.Currency</small>
                    @{
                        var received = invoice.PaidAmount > 0 ? invoice.PaidAmount : invoice.OutcomeAmount;
                    }
                    @if (received > 0)
                    {
                        <br /><small>@received.ToString("0.########") @(invoice.PaidInCurrency != DirectoryManager.Data.Enums.Currency.Unknown ? invoice.PaidInCurrency.ToString() : "")</small>
                    }
                </td>
                <td style="white-space:nowrap;">
                    @* One click: mark/unmark as my own test checkout (hidden from revenue reports and pending warnings). *@
                    <form method="post" action="/admin/revenue-opportunities/test/@invoice.SponsoredListingInvoiceId" class="u-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="isTest" value="@(invoice.IsTest ? "false" : "true")" />
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        @if (invoice.IsTest)
                        {
                            <b>TEST</b> <button type="submit" class="btn btn-sm btn-link" title="Not a test after all">undo</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-secondary" title="This was my test checkout">Test</button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<!-- Pagination Controls -->
<div>
    <div class="table-wrapper">
        <table class="table">
        <tr>
            <td>
                <!-- Previous Page Link -->
                <a href="@Url.Action(isPaidOnly ? "PaidIndex" : "Index", new { page = Math.Max(1, currentPage - 1) })" aria-label="Previous" @(currentPage == 1 ? "disabled" : "")>
                    &laquo;
                </a>
            </td>
            @for (int i = 1; i <= totalPages; i++)
            {
                <td>
                    <!-- Page Number Links or Text -->
                    @if (i == currentPage)
                    {
                        <span class="bold">@i</span>
                    }
                    else
                    {
                        <a href="@Url.Action(isPaidOnly ? "PaidIndex" : "Index", new { page = i })">@i</a>
                    }
                </td>
            }
            <td>
                <!-- Next Page Link -->
                <a href="@Url.Action(isPaidOnly ? "PaidIndex" : "Index", new { page = Math.Min(totalPages, currentPage + 1) })" aria-label="Next" @(currentPage == totalPages ? "disabled" : "")>
                    &raquo;
                </a>
            </td>
        </tr>
    </table>
    </div>
</div>
}