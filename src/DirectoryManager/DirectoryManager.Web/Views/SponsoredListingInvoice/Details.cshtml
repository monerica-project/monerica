@model DirectoryManager.Data.Models.SponsoredListings.SponsoredListingInvoice
@using DirectoryManager.DisplayFormatting.Helpers
@using DirectoryManager.DisplayFormatting.Models
@using DirectoryManager.Utilities.Helpers
@using DirectoryManager.Web.Constants;
@using DirectoryManager.Web.Models

@functions {
    // Human-readable "time ago" for a UTC timestamp (dates on this page are UTC).
    static string TimeAgo(DateTime utc)
    {
        var diff = DateTime.UtcNow - utc;
        if (diff < TimeSpan.Zero) return "just now";
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalDays >= 1) return $"{(int)diff.TotalDays}d {diff.Hours}h {diff.Minutes}m ago";
        if (diff.TotalHours >= 1) return $"{diff.Hours}h {diff.Minutes}m ago";
        return $"{diff.Minutes}m ago";
    }
}

@{
    ViewData[StringConstants.TitleHeader] = "Invoice Details";
    Layout = "_CenteredLayout";
}
 
@{
    var totalDaysRaw = (Model.CampaignEndDate.Date - Model.CampaignStartDate.Date).TotalDays;
    var totalDays = totalDaysRaw <= 0 ? 1 : (int)totalDaysRaw;   // protect against div/zero or bad dates
    var avgUsdPerDay = Math.Round(Model.Amount / totalDays, 2);     // 2 decimals

    // The exchange rate for this invoice (invoice currency per 1 unit of the paid crypto, e.g.
    // USD per XMR): BTCPay's actual rate captured at checkout, or the implied rate for older
    // invoices backfilled before capture existed. 0 = not recorded.
    var hasStoredRate = Model.PaymentRate > 0m;
    var rateCurrency = Model.PaidInCurrency != DirectoryManager.Data.Enums.Currency.Unknown
        ? Model.PaidInCurrency.ToString()
        : DirectoryManager.Data.Enums.Currency.XMR.ToString();
}

@section PageContent {
<h1>@ViewData[StringConstants.TitleHeader]</h1>

@await Html.PartialAsync("_AdminMenu")

<div>
    <h4>Invoice Details</h4>
    <hr />
    <dl class="row">

        <dt>Sponsored Listing Invoice ID</dt>
        <dd>@Model.SponsoredListingInvoiceId</dd>

        <dt>Sponsored Listing ID</dt>
        <dd><a href="~/sponsoredlisting/edit/@Model.SponsoredListingId">@Model.SponsoredListingId</a></dd>

        <dt>Invoice ID</dt>
        <dd>@Model.InvoiceId</dd>

        <dt>Directory Entry ID</dt>
        <dd> <a href="~/directoryentry/edit/@Model.DirectoryEntryId">@Model.DirectoryEntryId</a> (<a href="~/sponsoredlistinginvoice/advertiser?directoryEntryId=@Model.DirectoryEntryId">see all invoices</a>)</dd>

        <dt>Invoice Description</dt>
        <dd>@Model.InvoiceDescription</dd>

        <dt>Sponsorship Type</dt>
        <dd>@Model.SponsorshipType</dd>

        @if (Model.SponsorshipType == DirectoryManager.Data.Enums.SponsorshipType.SubcategorySponsor && ViewBag.Subcategory != null)
        {
            <dt>Subcategory</dt>
            <dd>@FormattingHelper.SubcategoryFormatting(ViewBag.Subcategory.Category.Name, @ViewBag.SubCategory.Name)</dd>
        }

        @if (Model.SponsorshipType == DirectoryManager.Data.Enums.SponsorshipType.CategorySponsor && ViewBag.Category != null)
        {
            <dt>Category</dt>
            <dd>@ViewBag.Category.Name</dd>
        }

        <dt>Amount</dt>
        <dd>@Model.Amount</dd>

        <dt>Currency</dt>
        <dd>@Model.Currency</dd>

        <dt>Paid Amount</dt>
        <dd>@Model.PaidAmount</dd>

        <dt>Outcome Amount</dt>
        <dd>@Model.OutcomeAmount</dd>

        <dt>Paid In Currency</dt>
        <dd>@Model.PaidInCurrency</dd>

        @if (hasStoredRate)
        {
            <dt>Exchange Rate</dt>
            <dd>@Model.PaymentRate.ToString("0.00") @Model.Currency / @rateCurrency</dd>
        }

        <dt>Payment Status</dt>
        <dd>@EnumHelper.GetDescription(Model.PaymentStatus)</dd>

        <dt>Total Days</dt>
        <dd>@totalDays</dd>

        <dt>Avg USD / Day</dt>
        <dd>@avgUsdPerDay.ToString("0.00")</dd>

        <dt>Create Date</dt>
        <dd>
            @Model.CreateDate.ToString(DirectoryManager.Common.Constants.StringConstants.DateTimeFormat)
            <span class="u-fs-85em-op-7">(@TimeAgo(Model.CreateDate))</span>
        </dd>

        <dt>Update Date</dt>
        <dd>
            @Model.UpdateDate?.ToString(DirectoryManager.Common.Constants.StringConstants.DateTimeFormat)
            @if (Model.UpdateDate.HasValue)
            {
                <span class="u-fs-85em-op-7">(@TimeAgo(Model.UpdateDate.Value))</span>
            }
        </dd>

        <dt>Campaign Start Date</dt>
        <dd>@Model.CampaignStartDate.ToString(DirectoryManager.Common.Constants.StringConstants.DateTimeFormat)</dd>

        <dt>Campaign End Date</dt>
        <dd>@Model.CampaignEndDate.ToString(DirectoryManager.Common.Constants.StringConstants.DateTimeFormat)</dd>

        <dt>Payment Processor</dt>
        <dd>@Model.PaymentProcessor</dd>

        <dt>Invoice Response</dt>
        <dd><pre class="payment-response">@Model.InvoiceResponse</pre></dd>

        @if (!string.IsNullOrWhiteSpace(Model.PaymentResponse))
        {
            <dt>Payment Response</dt>
            <dd><pre class="payment-response">@Model.PaymentResponse</pre></dd>
        }

        <dt>Processor Invoice Id</dt>
        <dd>@Model.ProcessorInvoiceId</dd>

        @if (!string.IsNullOrWhiteSpace(Model.Email))
        {
            <dt>Email</dt>
            <dd>@Model.Email</dd>

            <dt>Is Reminder Sent</dt>
            <dd>@Model.IsReminderSent</dd>
        }

            @if (!string.IsNullOrWhiteSpace(Model.ReferralCodeUsed))
            {
                <dt>Referral Code</dt>
                <dd>@Model.ReferralCodeUsed</dd>
            }
    </dl>
    <hr />
    <h3>Listing</h3>
<ul class="blank_list_item">
        @await Html.PartialAsync("_DirectoryEntryPartial", (DirectoryEntryViewModel)ViewBag.SelectedDirectoryEntry)
</ul>
    <hr />
</div>

    <div>
        <a href="@Url.Action("Edit", new { id = Model.SponsoredListingInvoiceId })">Edit</a>
        &nbsp;|&nbsp;
        <a href="@Url.Action("Index")">Back to List</a>
    </div>
}