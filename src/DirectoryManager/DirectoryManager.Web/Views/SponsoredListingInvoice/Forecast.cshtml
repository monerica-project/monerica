@model DirectoryManager.Web.Models.Reports.IncomeForecastViewModel
@using DirectoryManager.Web.Constants;
@using DirectoryManager.Data.Enums;
@using System.Globalization

@{
    ViewData[StringConstants.TitleHeader] = "Income Forecast";
    Layout = "_CenteredLayout";

    var chartV = $"{Model.DisplayCurrency}-{Model.LookbackMonths}-{Model.HorizonMonths}-{Model.ConfidencePercent}-{Model.GeneratedAtUtc.Ticks}";

    var usCulture = CultureInfo.CreateSpecificCulture(StringConstants.EnglishUS);
    string dateFmt = DirectoryManager.Common.Constants.StringConstants.DateFormat;

    Func<decimal, string> money = v => Model.DisplayCurrency == Currency.USD
        ? v.ToString("C", usCulture)
        : $"{v.ToString("0.######")} {Model.DisplayCurrency}";

    Func<DateTime?, string> day = d => d.HasValue ? d.Value.ToString(dateFmt) : "—";
}

@section PageContent {
    <h1>@ViewData[StringConstants.TitleHeader]</h1>

    @await Html.PartialAsync("_AdminMenu")
    @await Html.PartialAsync("_ReportMenu")

    <hr />

    <p class="text-muted">
        A realistic projection of future income from your past booked revenue. It fits a trend to the
        last @Model.LookbackMonths months of paid invoices and projects it forward @Model.HorizonMonths
        months from today. To keep it honest, revenue from sponsorships that were <strong>cut short</strong>
        (the advertiser was pulled) is treated as one-off and removed from the trend, and advertisers who are
        no longer Admitted/Verified are never assumed to renew. The band reflects normal month-to-month
        variation at the chosen confidence level — an estimate, not a guarantee.
    </p>

    <form method="get" asp-controller="SponsoredListingInvoice" asp-action="Forecast">
        <div class="form-row">
            <div class="form-group col-md-3">
                <label for="DisplayCurrency">Display Currency</label>
                <select id="DisplayCurrency" name="displayCurrency" class="form-control"
                        asp-items="Model.DisplayCurrencyOptions"></select>
            </div>

            <div class="form-group col-md-3">
                <label for="LookbackMonths">History to learn from (months)</label>
                <input id="LookbackMonths" name="lookbackMonths" type="number" min="3" max="60"
                       class="form-control" value="@Model.LookbackMonths" />
            </div>

            <div class="form-group col-md-3">
                <label for="HorizonMonths">Forecast horizon (months)</label>
                <input id="HorizonMonths" name="horizonMonths" type="number" min="1" max="36"
                       class="form-control" value="@Model.HorizonMonths" />
            </div>

            <div class="form-group col-md-3">
                <label for="Confidence">Confidence</label>
                <select id="Confidence" name="confidence" class="form-control"
                        asp-items="Model.ConfidenceOptions"></select>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Run Forecast</button>
    </form>

    <br />

    @if (Model.HasNextPayment)
    {
        <div class="alert alert-info u-p-10px-14px-lh-14">
            <strong>Next expected payment</strong>
            <div class="u-mt-6px">
                <strong>@(Model.NextPaymentDateUtc?.ToString(dateFmt))</strong>
                — <strong>@money(Model.NextPaymentAmount)</strong>
                <span class="text-muted">
                    (@Model.NextPaymentAdvertiser@(string.IsNullOrEmpty(Model.NextPaymentSponsorshipType)
                        ? string.Empty
                        : $", {Model.NextPaymentSponsorshipType}"))
                </span>
            </div>
            <div class="text-muted u-fs-09em-mt-4px">
                The soonest-expiring sponsorship whose advertiser is still Admitted/Verified: the date its
                current campaign ends and a renewal would be due, at that listing's current rate. This is a
                concrete near-term expectation, separate from the statistical projection below.
            </div>
        </div>
    }

    @if (Model.NextPaymentExcludedTerminated)
    {
        <div class="alert alert-warning u-p-10px-14px-lh-14">
            A sooner-expiring sponsorship was left out of "next expected payment" because that advertiser is
            <strong>no longer Admitted/Verified</strong> — a pulled advertiser isn't assumed to renew, so its
            paid-through date is not treated as future income.
        </div>
    }

    <div class="alert alert-success u-p-10px-14px-lh-14">
        <strong>Realistic monthly income</strong>
        <div class="u-mt-6px">
            <div>
                Average booked per month —
                last 3: <strong>@money(Model.AverageMonthly3)</strong>,
                last 6: <strong>@money(Model.AverageMonthly6)</strong>,
                last 12: <strong>@money(Model.AverageMonthly12)</strong>
                <span class="text-muted">(earned revenue; cut-short amounts removed)</span>
            </div>
            <div class="u-mt-6px">
                Forward run-rate from current live sponsorships:
                <strong>@money(Model.ActiveMonthlyRunRate)</strong> / month
                <span class="text-muted">
                    (@Model.ActiveSponsorshipCount active sponsorship@(Model.ActiveSponsorshipCount == 1 ? "" : "s"),
                    Admitted/Verified only)
                </span>
            </div>
            <div class="u-mt-6px">
                Expected average over the next @Model.HorizonMonths months:
                <strong>@money(Model.ExpectedMonthlyOverHorizon)</strong> / month
            </div>
        </div>
    </div>

    <div class="alert alert-secondary u-p-10px-14px-lh-14">
        <strong>Advertiser health &amp; pricing</strong>
        <div class="u-mt-6px">
            <div>
                Advertisers: <strong>@Model.LiveAdvertisers</strong> live,
                <strong>@Model.TerminatedAdvertisers</strong> no longer live,
                of <strong>@Model.DistinctAdvertisers</strong> total —
                churn <strong>@Model.ChurnRatePct.ToString("0.#")%</strong>,
                repeat/renew rate <strong>@Model.RepeatAdvertiserRatePct.ToString("0.#")%</strong>
            </div>
            <div class="u-mt-6px">
                Average price per sponsorship — last 6 mo: <strong>@money(Model.AvgPriceRecent)</strong>,
                prior 6 mo: <strong>@money(Model.AvgPricePrior)</strong>
                @if (Model.AvgPricePrior > 0m)
                {
                    <span class="@(Model.PriceChangePct >= 0m ? "text-success" : "text-danger")">
                        (@(Model.PriceChangePct >= 0m ? "+" : "")@Model.PriceChangePct.ToString("0.#")%)
                    </span>
                }
            </div>
        </div>
    </div>

    @if (Model.Advice.Any())
    {
        <div class="alert alert-info u-p-10px-14px-lh-14">
            <strong>What to do</strong>
            <ul class="u-mt-6px u-mb-0">
                @foreach (var ad in Model.Advice)
                {
                    var cls = ad.Kind == "positive" ? "text-success"
                        : ad.Kind == "warning" ? "text-danger" : "text-muted";
                    <li class="@cls">@ad.Text</li>
                }
            </ul>
        </div>
    }

    @if (!Model.HasEnoughData)
    {
        <div class="alert alert-warning">
            Not enough paid-invoice history to build a forecast yet. Once you have at least a few
            months of bookings, this report will populate.
        </div>
    }
    else
    {
        <div class="alert alert-secondary u-p-10px-14px-lh-14">
            <strong>Summary</strong>
            <div class="u-mt-6px">
                <div>History used: @Model.HistoryMonthsUsed month(s)</div>
                <div>
                    Recent monthly average:
                    <strong>@money(Model.RecentMonthlyAverage)</strong>
                </div>
                <div>
                    Trend:
                    @if (Model.TrendIsGrowing)
                    {
                        <span>growing by about @money(Model.TrendSlopePerMonth) per month</span>
                    }
                    else if (Model.TrendSlopePerMonth < 0m)
                    {
                        <span>declining by about @money(Math.Abs(Model.TrendSlopePerMonth)) per month</span>
                    }
                    else
                    {
                        <span>roughly flat</span>
                    }
                </div>
                <div class="u-mt-6px">
                    Projected total over the next @Model.HorizonMonths months:
                    <strong>@money(Model.ProjectedHorizonTotalExpected)</strong>
                    <span class="text-muted">
                        (@Model.ConfidencePercent% range: @money(Model.ProjectedHorizonTotalLow)
                        – @money(Model.ProjectedHorizonTotalHigh))
                    </span>
                </div>
            </div>
        </div>

        <img class="u-w-100pct"
 src="@Url.Action("IncomeForecastChart", "SponsoredListingInvoice", new {
 displayCurrency = Model.DisplayCurrency,
 lookbackMonths = Model.LookbackMonths,
 horizonMonths = Model.HorizonMonths,
 confidence = Model.ConfidencePercent,
 v = chartV
 })"
 alt="Income Forecast Chart (@Model.DisplayCurrency)" />

        <br />
        <br />

        <h2>When you'll hit each income milestone</h2>
        <p class="text-muted">
            Cumulative income earned from today. "Earliest" assumes the optimistic case,
            "Latest" the conservative case. "—" under Latest means it isn't reached within the horizon.
        </p>

        @if (Model.Milestones.Any())
        {
            <div class="table-wrapper">
<table class="table table-striped">
                <thead>
                    <tr>
                        <th>Cumulative Income</th>
                        <th>Expected Date</th>
                        <th>Earliest (optimistic)</th>
                        <th>Latest (conservative)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ms in Model.Milestones)
                    {
                        <tr>
                            <td>@money(ms.Target)</td>
                            <td>@day(ms.ExpectedDate)</td>
                            <td>@day(ms.EarliestDate)</td>
                            <td>@day(ms.LatestDate)</td>
                        </tr>
                    }
                </tbody>
            </table>
</div>
        }
        else
        {
            <p>No milestones to project for this horizon.</p>
        }

        <br />

        <h2>Month-by-month projection</h2>
        <div class="table-wrapper">
<table class="table table-striped">
            <thead>
                <tr>
                    <th>Month</th>
                    <th class="u-text-right">Expected</th>
                    <th class="u-text-right">Low</th>
                    <th class="u-text-right">High</th>
                    <th class="u-text-right">Cumulative (expected)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.MonthlyRows)
                {
                    <tr>
                        <td>@row.Month.ToString("MMM yyyy", usCulture)</td>
                        <td class="u-text-right">@money(row.Expected)</td>
                        <td class="u-text-right">@money(row.Low)</td>
                        <td class="u-text-right">@money(row.High)</td>
                        <td class="u-text-right">@money(row.CumulativeExpected)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th>Total</th>
                    <th class="u-text-right">@money(Model.ProjectedHorizonTotalExpected)</th>
                    <th class="u-text-right">@money(Model.ProjectedHorizonTotalLow)</th>
                    <th class="u-text-right">@money(Model.ProjectedHorizonTotalHigh)</th>
                    <th class="u-text-right">@money(Model.ProjectedHorizonTotalExpected)</th>
                </tr>
            </tfoot>
        </table>
</div>

        @if (Model.CutShortCount > 0)
        {
            <br />
            <h2>Collected before expiration (cut-short sponsorships)</h2>
            <p class="text-muted">
                Sponsorships you ended before their paid-through date — the advertiser was pulled (no longer
                Admitted/Verified) or the live listing was shortened. This money was collected but not fully
                earned, so it is <strong>excluded from the forecast above</strong>: it's one-time, not recurring.
                "Unearned" is the portion covering time that was never served.
            </p>

            <div class="alert alert-secondary u-p-10px-14px-lh-14">
                <div><strong>@Model.CutShortCount</strong> sponsorship@(Model.CutShortCount == 1 ? "" : "s") cut short</div>
                <div>Total collected from them: <strong>@money(Model.CutShortCollectedTotal)</strong></div>
                <div>
                    Collected for time never served (unearned):
                    <strong>@money(Model.CutShortUnearnedTotal)</strong>
                </div>
            </div>

            <div class="table-wrapper">
<table class="table table-striped">
                <thead>
                    <tr>
                        <th>Advertiser</th>
                        <th>Current status</th>
                        <th>Sponsorship</th>
                        <th>Paid through</th>
                        <th>Served through</th>
                        <th class="u-text-right">Collected</th>
                        <th class="u-text-right">Unearned</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.CutShortRows)
                    {
                        <tr>
                            <td>@c.Advertiser</td>
                            <td>@c.Status</td>
                            <td>@c.SponsorshipType</td>
                            <td>@c.PaidThrough.ToString(dateFmt)</td>
                            <td>@c.ServedThrough.ToString(dateFmt)</td>
                            <td class="u-text-right">@money(c.Collected)</td>
                            <td class="u-text-right">@money(c.Unearned)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="5">Total</th>
                        <th class="u-text-right">@money(Model.CutShortCollectedTotal)</th>
                        <th class="u-text-right">@money(Model.CutShortUnearnedTotal)</th>
                    </tr>
                </tfoot>
            </table>
</div>
        }

        <br />

        <p class="text-muted u-fs-09em">
            Method: ordinary-least-squares linear trend on monthly booked revenue (by invoice paid-date),
            with the unearned portion of cut-short sponsorships removed so one-off windfalls don't inflate it,
            and a ± @Model.ConfidencePercent% band derived from historical month-to-month variability.
            The current month is prorated by the days remaining. The forward run-rate is the monthly-equivalent
            value of sponsorships that are currently live (advertiser still Admitted/Verified). Forecasts assume
            past patterns continue; large one-off deals and seasonality are not separately modeled.
        </p>
    }
}
